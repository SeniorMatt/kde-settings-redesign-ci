-QVariantMap AnimationsKCM::effectsKCMData() const
+void AnimationsKCM::launchEffectsKCM() const
 {
-    if (KService::Ptr kcm = KService::serviceByStorageId(QStringLiteral("kcm_kwin_effects"))) {
-        QVariantMap data;
-        data["icon"] = kcm->icon();
-        data["name"] = kcm->name();
-        return data;
-    }
-
-    return {};
+    // Kept for compatibility; the page now opens it through KCMLauncher.openSystemSettings
+    QProcess::startDetached(QStringLiteral("systemsettings"), QStringList{QStringLiteral("kcm_kwin_effects")});
 }
 
-void AnimationsKCM::launchEffectsKCM() const
+void AnimationsKCM::setLoading(bool loading)
 {
-    QProcess::startDetached(QStringLiteral("systemsettings"), QStringList{QStringLiteral("kcm_kwin_effects")});
+    if (m_loading != loading) {
+        m_loading = loading;
+        Q_EMIT loadingChanged();
+    }
 }
 
 void AnimationsKCM::load()
 {
     m_animationsGlobalsSettings->load();
-    m_model->load();
     setNeedsSave(false);
+
+    // EffectsModel::load() scans the built-in effect list, the KPackage "KWin/Effect" packages and the effect plugins
+    // synchronously before it asks KWin over D-Bus which are supported. Run it one event-loop turn later so the page
+    // (slider, labels) is created first; the combo boxes stay disabled until EffectsModel::loaded().
+    setLoading(true);
+    if (!m_loadScheduled) {
+        m_loadScheduled = true;
+        QTimer::singleShot(0, this, [this]() {
+            m_loadScheduled = false;
+            m_model->load();
+        });
+    }
 }
 
 void AnimationsKCM::save()
