diff --git a/src/kcms/animations/ui/AnimationRow.qml b/src/kcms/animations/ui/AnimationRow.qml
new file mode 100644
index 0000000..6777863
--- /dev/null
+++ b/src/kcms/animations/ui/AnimationRow.qml
@@ -0,0 +1,47 @@
+/*
+    SPDX-FileCopyrightText: 2025 Oliver Beard <olib141@outlook.com>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+
+// One form row: the animation combo box plus its "Configure…" button (docs/page-design.md, section 3)
+RowLayout {
+    id: row
+
+    required property var animationsModel
+
+    Kirigami.FormData.buddyFor: animationComboBox
+    spacing: Kirigami.Units.smallSpacing
+    // Disabled while the effect list is still being scanned, and when animations are switched off
+    enabled: kcm.globalsSettings.animationDurationFactor != 0 && !kcm.loading
+
+    AnimationComboBox {
+        id: animationComboBox
+        Layout.minimumWidth: Kirigami.Units.gridUnit * 14
+        animationsModel: row.animationsModel
+        KCM.SettingHighlighter {
+            highlight: !animationComboBox.isDefault && kcm.globalsSettings.animationDurationFactor != 0
+        }
+    }
+    QQC2.Button {
+        icon.name: "configure"
+        text: i18nc("@info:tooltip", "Configure…")
+        display: QQC2.AbstractButton.IconOnly
+        Accessible.name: text
+
+        QQC2.ToolTip.text: text
+        QQC2.ToolTip.visible: hovered || visualFocus
+        QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+
+        enabled: animationComboBox.isConfigurable
+        visible: animationComboBox.isAnyConfigurable
+        onClicked: kcm.configure(animationComboBox.configurePluginId, row)
+    }
+}
