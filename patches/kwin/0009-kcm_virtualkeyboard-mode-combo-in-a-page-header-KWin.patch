 .../virtualkeyboard/kcmvirtualkeyboard.cpp    | 30 +++++++++++-
 src/kcms/virtualkeyboard/kcmvirtualkeyboard.h |  1 +
 src/kcms/virtualkeyboard/ui/main.qml          | 46 +++++++++----------
 3 files changed, 53 insertions(+), 24 deletions(-)

diff --git a/src/kcms/virtualkeyboard/kcmvirtualkeyboard.cpp b/src/kcms/virtualkeyboard/kcmvirtualkeyboard.cpp
index 0941ec8..fe29d7f 100644
--- a/src/kcms/virtualkeyboard/kcmvirtualkeyboard.cpp
+++ b/src/kcms/virtualkeyboard/kcmvirtualkeyboard.cpp
@@ -16,6 +16,12 @@
 #include <KLocalizedString>
 #include <KPluginFactory>
 
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusVariant>
+
 #include <virtualkeyboarddata.h>
 #include <virtualkeyboardsettings.h>
 
@@ -26,10 +32,31 @@ KcmVirtualKeyboard::KcmVirtualKeyboard(QObject *parent, const KPluginMetaData &m
     , m_data(new VirtualKeyboardData(this))
     , m_model(new VirtualKeyboardsModel(this))
     , m_dbusInterface(std::make_unique<KWinVirtualKeyboard>())
-    , m_mode(static_cast<KWinVirtualKeyboard::VirtualKeyboardMode>(m_dbusInterface->mode()))
+    , m_mode(KWinVirtualKeyboard::VirtualKeyboardMode::TouchOnly) // KWin's default until the async read below answers
 {
     qmlRegisterAnonymousType<VirtualKeyboardSettings>("org.kde.kwin.virtualkeyboardsettings", 1);
     qmlRegisterType<KWinVirtualKeyboard>("org.kde.kwin.virtualkeyboard", 1, 0, "KWinVirtualKeyboard");
+
+    // The mode used to be read here with a blocking D-Bus property call, which stalls the first frame while KWin is
+    // busy or being activated. Ask asynchronously instead; a change made by the user in the meantime wins.
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),
+                                                  QStringLiteral("/VirtualKeyboard"),
+                                                  QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                  QStringLiteral("Get"));
+    message << QStringLiteral("org.kde.kwin.VirtualKeyboard") << QStringLiteral("mode");
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<QDBusVariant> reply = *watcher;
+        watcher->deleteLater();
+        if (m_modeEdited || reply.isError()) {
+            return;
+        }
+        const int mode = reply.value().variant().toInt();
+        if (mode != static_cast<int>(m_mode)) {
+            m_mode = static_cast<KWinVirtualKeyboard::VirtualKeyboardMode>(mode);
+            Q_EMIT modeChanged(m_mode);
+        }
+    });
 }
 
 KcmVirtualKeyboard::~KcmVirtualKeyboard() = default;
@@ -45,6 +72,7 @@ void KcmVirtualKeyboard::setMode(KWinVirtualKeyboard::VirtualKeyboardMode mode)
         return;
     }
     m_mode = mode;
+    m_modeEdited = true;
     Q_EMIT modeChanged(mode);
     setNeedsSave(true);
 }
diff --git a/src/kcms/virtualkeyboard/kcmvirtualkeyboard.h b/src/kcms/virtualkeyboard/kcmvirtualkeyboard.h
index 9f8a050..6888462 100644
--- a/src/kcms/virtualkeyboard/kcmvirtualkeyboard.h
+++ b/src/kcms/virtualkeyboard/kcmvirtualkeyboard.h
@@ -77,4 +77,5 @@ private:
     VirtualKeyboardsModel *const m_model;
     std::unique_ptr<KWinVirtualKeyboard> m_dbusInterface;
     KWinVirtualKeyboard::VirtualKeyboardMode m_mode;
+    bool m_modeEdited = false;
 };
