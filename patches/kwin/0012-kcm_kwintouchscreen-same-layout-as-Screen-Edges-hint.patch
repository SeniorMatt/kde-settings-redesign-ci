diff --git a/src/kcms/screenedges/touch.cpp b/src/kcms/screenedges/touch.cpp
index 51d7cd3..2949e7e 100644
--- a/src/kcms/screenedges/touch.cpp
+++ b/src/kcms/screenedges/touch.cpp
@@ -18,6 +18,7 @@
 #include <KPackage/PackageLoader>
 #include <KPluginFactory>
 #include <QDBusConnection>
+#include <QTimer>
 #include <QDBusMessage>
 #include <QVBoxLayout>
 
@@ -42,7 +43,13 @@ KWinScreenEdgesConfig::KWinScreenEdgesConfig(QObject *parent, const KPluginMetaD
     QVBoxLayout *layout = new QVBoxLayout(widget());
     layout->addWidget(m_form);
 
-    monitorInit();
+    // The effect, script and package scans in monitorInit() used to run here, before the first frame (cost grows with
+    // the installed effects and scripts). Run them one event-loop turn later and load the edge actions after that.
+    QTimer::singleShot(0, this, [this] {
+        monitorInit();
+        m_initialized = true;
+        load();
+    });
 
     connect(m_form, &KWinTouchScreenEdgeConfigForm::saveNeededChanged, this, &KWinScreenEdgesConfig::unmanagedWidgetChangeState);
     connect(m_form, &KWinTouchScreenEdgeConfigForm::defaultChanged, this, &KWinScreenEdgesConfig::unmanagedWidgetDefaultState);
@@ -63,13 +70,18 @@ void KWinScreenEdgesConfig::load()
         setting->load();
     }
 
-    monitorLoadSettings();
-    monitorLoadDefaultSettings();
+    if (m_initialized) {
+        monitorLoadSettings();
+        monitorLoadDefaultSettings();
+    }
     m_form->reload();
 }
 
 void KWinScreenEdgesConfig::save()
 {
+    if (!m_initialized) {
+        return; // the edge menus are not filled yet, saving now would write "None" for every edge
+    }
     monitorSaveSettings();
     m_data->settings()->save();
     for (KWinTouchScreenScriptSettings *setting : std::as_const(m_scriptSettings)) {
@@ -125,6 +137,7 @@ void KWinScreenEdgesConfig::monitorInit()
 
     // TODO: Find a better way to get the display name of the present windows,
     // Maybe install metadata.json files?
+    // ksr: kcm_kwintouchscreen/touch-edge-action-presentwindows
     const QString presentWindowsName = i18n("Present Windows");
     m_form->monitorAddItem(i18n("%1 - All Desktops", presentWindowsName));
     m_form->monitorAddItem(i18n("%1 - Current Desktop", presentWindowsName));
@@ -237,6 +250,11 @@ void KWinScreenEdgesConfig::monitorLoadDefaultSettings()
 void KWinScreenEdgesConfig::monitorSaveSettings()
 {
     // Save ElectricBorderActions
+    // ksr: kcm_kwintouchscreen/cfg-TouchEdges-Top
+    // ksr: kcm_kwintouchscreen/cfg-TouchEdges-Right
+    // ksr: kcm_kwintouchscreen/cfg-TouchEdges-Bottom
+    // ksr: kcm_kwintouchscreen/cfg-TouchEdges-Left
+    // ksr: kcm_kwintouchscreen/touch-edge-action
     m_data->settings()->setTop(KWinScreenEdgesConfig::electricBorderActionToString(m_form->selectedEdgeItem(ElectricTop)));
     m_data->settings()->setRight(KWinScreenEdgesConfig::electricBorderActionToString(m_form->selectedEdgeItem(ElectricRight)));
     m_data->settings()->setBottom(KWinScreenEdgesConfig::electricBorderActionToString(m_form->selectedEdgeItem(ElectricBottom)));
