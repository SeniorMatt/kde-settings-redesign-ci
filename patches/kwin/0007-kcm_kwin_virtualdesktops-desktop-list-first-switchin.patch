+// ksr: kcm_kwin_virtualdesktops/cfg-Desktops-Number
+// ksr: kcm_kwin_virtualdesktops/cfg-Desktops-Rows
+// ksr: kcm_kwin_virtualdesktops/cfg-Desktops-Name
+// The desktop count, rows and names are edited through DesktopsModel
+// (D-Bus org.kde.KWin.VirtualDesktopManager) and written by KWin on save(); unchanged.
 void VirtualDesktops::load()
 {
     KQuickManagedConfigModule::load();
 
     m_data->desktopsModel()->load();
-    m_data->animationsModel()->load();
+    // VirtualDesktopsData already started loading the animations model in its constructor (the scan of built-in,
+    // script and plugin effects is the slow part): don't scan a second time on the first load().
+    if (m_animationsModelLoaded) {
+        m_data->animationsModel()->load();
+    }
+    m_animationsModelLoaded = true;
 }
 
