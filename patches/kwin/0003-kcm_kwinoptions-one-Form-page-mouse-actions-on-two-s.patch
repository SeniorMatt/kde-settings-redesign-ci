+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.kcmutils as KCM
+
+// Sub-page of Window Behavior (kcm.push): what clicks and the wheel do on titlebars, frames and the maximize button.
+// These were the "Titlebar Actions" tab.
+KCM.SimpleKCM {
+    title: i18nd("kcmkwm", "Titlebar Actions")
+
+    ColumnLayout {
+        TitlebarActions {
+            Layout.fillWidth: true
+        }
+    }
+}
