diff --git a/src/kcms/effects/ui/main.qml b/src/kcms/effects/ui/main.qml
index aa8be72..2715085 100644
--- a/src/kcms/effects/ui/main.qml
+++ b/src/kcms/effects/ui/main.qml
@@ -18,6 +18,8 @@ import org.kde.newstuff as NewStuff
 import org.kde.private.kcms.kwin.effects as Private
 
 ScrollViewKCM {
+    id: root
+
     implicitHeight: Kirigami.Units.gridUnit * 30
     implicitWidth: Kirigami.Units.gridUnit * 40
 
@@ -32,6 +34,23 @@ ScrollViewKCM {
         }
     }
 
+    // List page (docs/page-design.md): the page is shown first; the effect scan (synchronous in C++) starts after the
+    // first frame was swapped. Busy indicator only if it takes more than 150 ms.
+    Connections {
+        target: root.Window.window
+        enabled: !root._loadRequested
+        function onFrameSwapped() {
+            root._loadRequested = true;
+            kcm.startLoading();
+        }
+    }
+    property bool _loadRequested: false
+    Timer {
+        id: busyDelay
+        interval: 150
+        running: kcm.loading
+    }
+
     header: RowLayout {
         spacing: Kirigami.Units.smallSpacing
 
@@ -39,12 +58,13 @@ ScrollViewKCM {
             id: searchField
 
             Layout.fillWidth: true
+            Accessible.name: i18n("Search effects") // ksr: kcm_kwin_effects/search
         }
 
         QQC2.ToolButton {
             id: filterButton
 
-            text: i18n("Configure Filter")
+            text: i18n("Configure Filter") // ksr: kcm_kwin_effects/Configure-Filter
             icon.name: "view-filter"
 
             display: QQC2.AbstractButton.IconOnly
@@ -87,6 +107,20 @@ ScrollViewKCM {
             sourceModel: kcm.effectsModel
         }
 
+        Kirigami.PlaceholderMessage {
+            anchors.centerIn: parent
+            width: parent.width - Kirigami.Units.gridUnit * 4
+            visible: effectsList.count === 0 && !kcm.loading
+            icon.name: "preferences-desktop-effects"
+            text: searchField.text.length > 0 ? i18nc("@info:placeholder", "No effects match your search") : i18nc("@info:placeholder", "No effects found")
+        }
+
+        QQC2.BusyIndicator {
