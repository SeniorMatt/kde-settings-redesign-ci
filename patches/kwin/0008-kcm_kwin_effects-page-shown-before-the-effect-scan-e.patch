 src/kcms/effects/kcm.h         |  9 +++++++++
 src/kcms/effects/ui/Effect.qml |  7 +++++--
 src/kcms/effects/ui/main.qml   | 36 +++++++++++++++++++++++++++++++++-
 4 files changed, 80 insertions(+), 3 deletions(-)

diff --git a/src/kcms/effects/kcm.cpp b/src/kcms/effects/kcm.cpp
index 7c9be20..8133d45 100644
--- a/src/kcms/effects/kcm.cpp
+++ b/src/kcms/effects/kcm.cpp
@@ -12,6 +12,8 @@
 #include <KLocalizedString>
 #include <KPluginFactory>
 
+#include <QTimer>
+
 K_PLUGIN_FACTORY_WITH_JSON(DesktopEffectsKCMFactory,
                            "kcm_kwin_effects.json",
                            registerPlugin<KWin::DesktopEffectsKCM>();
@@ -30,6 +32,12 @@ DesktopEffectsKCM::DesktopEffectsKCM(QObject *parent, const KPluginMetaData &met
 
     connect(m_model, &EffectsModel::dataChanged, this, &DesktopEffectsKCM::updateNeedsSave);
     connect(m_model, &EffectsModel::loaded, this, &DesktopEffectsKCM::updateNeedsSave);
+    connect(m_model, &EffectsModel::loaded, this, [this]() {
+        if (m_loading) {
+            m_loading = false;
+            Q_EMIT loadingChanged();
+        }
+    });
 
     // These are handled in kcm_animations
     m_model->setExcludeExclusiveGroups({"toplevel-open-close-animation", "maximize", "minimize", "fullscreen", "show-desktop", "desktop-animations"});
@@ -45,8 +53,31 @@ QAbstractItemModel *DesktopEffectsKCM::effectsModel() const
     return m_model;
 }
 
+bool DesktopEffectsKCM::loading() const
+{
+    return m_loading;
+}
+
 void DesktopEffectsKCM::load()
 {
+    // EffectsModel::load() scans built-in, scripted (KPackage) and plugin effects synchronously. On the first load
+    // the page is shown first and the scan starts after its first frame (startLoading(), called from main.qml); a
+    // timer starts it anyway if no QML ever asks (e.g. the module is loaded without its UI).
+    if (!m_loadStarted) {
+        QTimer::singleShot(1500, this, &DesktopEffectsKCM::startLoading);
+        setNeedsSave(false);
+        return;
+    }
+    m_model->load();
+    setNeedsSave(false);
+}
+
+void DesktopEffectsKCM::startLoading()
+{
+    if (m_loadStarted) {
+        return;
+    }
+    m_loadStarted = true;
     m_model->load();
     setNeedsSave(false);
 }
diff --git a/src/kcms/effects/kcm.h b/src/kcms/effects/kcm.h
index 9463962..a5b48fc 100644
--- a/src/kcms/effects/kcm.h
+++ b/src/kcms/effects/kcm.h
@@ -19,26 +19,35 @@ class DesktopEffectsKCM : public KQuickConfigModule
 {
     Q_OBJECT
     Q_PROPERTY(QAbstractItemModel *effectsModel READ effectsModel CONSTANT)
+    Q_PROPERTY(bool loading READ loading NOTIFY loadingChanged)
 
 public:
     explicit DesktopEffectsKCM(QObject *parent, const KPluginMetaData &metaData);
     ~DesktopEffectsKCM() override;
 
     QAbstractItemModel *effectsModel() const;
+    bool loading() const;
 
 public Q_SLOTS:
     void load() override;
     void save() override;
     void defaults() override;
 
+    // Starts the effect scan. QML calls it after the first frame was shown; a timer calls it if QML never does.
+    void startLoading();
     void onGHNSEntriesChanged();
     void configure(const QString &pluginId, QQuickItem *context) const;
 
+Q_SIGNALS:
+    void loadingChanged();
+
 private Q_SLOTS:
     void updateNeedsSave();
 
 private:
     EffectsModel *m_model;
+    bool m_loadStarted = false;
+    bool m_loading = true;
 
     Q_DISABLE_COPY(DesktopEffectsKCM)
 };
