diff --git a/src/kcms/taskswitching/ui/AlternativeSwitcher.qml b/src/kcms/taskswitching/ui/AlternativeSwitcher.qml
new file mode 100644
index 0000000..c7be741
--- /dev/null
+++ b/src/kcms/taskswitching/ui/AlternativeSwitcher.qml
@@ -0,0 +1,49 @@
+/*
+    SPDX-FileCopyrightText: 2025 Oliver Beard <olib141@outlook.com>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+
+import org.kde.kwin.kcmtaskswitching
+
+KCM.SimpleKCM {
+    title: i18nc("@title", "Alternative Task Switcher")
+
+    ColumnLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        Kirigami.InlineMessage {
+            Layout.fillWidth: true
+
+            type: Kirigami.MessageType.Information
+            visible: kcm.tabBoxLimitedByFocusPolicy
+            text: i18nc("@info", "Focus policy settings limit the functionality of navigating through windows.")
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 24
+            Layout.alignment: Qt.AlignHCenter
+
+            horizontalAlignment: Text.AlignHCenter
+            textFormat: Text.PlainText
+            wrapMode: Text.Wrap
+
+            text: i18nc("@info", "The alternative task switcher is a second switcher with its own separate shortcut, appearance, and behavior settings.")
+        }
+
+        TabBoxSettings {
+            Layout.fillWidth: true
+
+            enabled: !kcm.tabBoxLimitedByFocusPolicy
+            isAlternative: true
+        }
+    }
+}
