@@ -22,7 +22,8 @@ namespace KWin
 TabBoxLayoutsModel::TabBoxLayoutsModel(QObject *parent)
     : QAbstractListModel(parent)
 {
-    load();
+    // Scanning every look-and-feel package and the KPackage list is slow: do it after the page is shown.
+    QMetaObject::invokeMethod(this, &TabBoxLayoutsModel::load, Qt::QueuedConnection);
 }
 
