diff --git a/src/kcms/scripts/module.cpp b/src/kcms/scripts/module.cpp
index a67631c..45d93d2 100644
--- a/src/kcms/scripts/module.cpp
+++ b/src/kcms/scripts/module.cpp
@@ -11,6 +11,7 @@
 #include <QDBusPendingCall>
 #include <QFileDialog>
 #include <QStringList>
+#include <QTimer>
 
 #include <KCMultiDialog>
 #include <KConfigGroup>
@@ -40,6 +41,8 @@ Module::Module(QObject *parent, const KPluginMetaData &data)
 
 void Module::onGHNSEntriesChanged()
 {
+    ++m_generation; // cancels a still pending load()
+    setLoading(false);
     m_model->clear();
     m_model->addPlugins(m_kwinScriptsData->pluginMetaDataList(), QString());
 }
@@ -70,6 +73,8 @@ void Module::importScript()
             m_errorMessage.clear();
             Q_EMIT messageChanged();
 
+            ++m_generation; // cancels a still pending load()
+            setLoading(false);
             m_model->clear();
             m_model->addPlugins(m_kwinScriptsData->pluginMetaDataList(), QString());
 
@@ -108,14 +113,35 @@ void Module::defaults()
     setNeedsSave(m_model->isSaveNeeded());
 }
 
+void Module::setLoading(bool loading)
+{
+    if (m_loading != loading) {
+        m_loading = loading;
+        Q_EMIT loadingChanged();
+    }
+}
+
 void Module::load()
 {
     m_model->clear();
-    m_model->addPlugins(m_kwinScriptsData->pluginMetaDataList(), QString());
     m_pendingDeletions.clear();
     Q_EMIT pendingDeletionsChanged();
-
     setNeedsSave(false);
+
+    // findPackages("KWin/Script") reads the metadata of every installed script, and KPluginModel::addPlugins() then
+    // looks up each script's config module. Both used to run inside load(), before the page was shown. Run them one
+    // event-loop turn later; a newer load() makes an older, still pending one a no-op.
+    const quint64 generation = ++m_generation;
+    setLoading(true);
+    QTimer::singleShot(0, this, [this, generation]() {
+        if (generation != m_generation) {
+            return;
+        }
+        m_model->addPlugins(m_kwinScriptsData->pluginMetaDataList(), QString());
+        setLoading(false);
+        // Keep what the user changed while the list was filling (nothing, normally)
+        setNeedsSave(m_model->isSaveNeeded() || !m_pendingDeletions.isEmpty());
+    });
 }
 
 void Module::save()
