+// State shared by the D-Bus replies of one load(). The replies only collect the shortcut infos; the expensive part
+// (KService lookups, sorting) runs afterwards, one component per event-loop turn, so the page can paint in between.
+struct GlobalAccelModel::LoadState {
+    quint64 generation = 0;
+    int pendingCalls = 0;
+    QList<QList<KGlobalShortcutInfo>> infos;
+    QCollator collator;
+    // First application service per name, built once per load (was: one KApplicationTrader::query() per component)
+    bool servicesBuilt = false;
+    QHash<QString, std::pair<int, KService::Ptr>> servicesByName;
+};
+
 void GlobalAccelModel::load()
 {
     if (!m_globalAccelInterface->isValid()) {
         return;
     }
 
+    auto state = QSharedPointer<LoadState>::create();
+    state->generation = ++m_loadGeneration;
+    state->collator.setCaseSensitivity(Qt::CaseInsensitive);
+    state->collator.setNumericMode(true);
+    m_pendingComponents.clear();
+
     auto componentsWatcher = new QDBusPendingCallWatcher(m_globalAccelInterface->allComponents());
-    connect(componentsWatcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *componentsWatcher) {
+    connect(componentsWatcher, &QDBusPendingCallWatcher::finished, this, [this, state](QDBusPendingCallWatcher *componentsWatcher) {
         QDBusPendingReply<QList<QDBusObjectPath>> componentsReply = *componentsWatcher;
         componentsWatcher->deleteLater();
+        if (state->generation != m_loadGeneration) {
+            return; // a newer load() started
+        }
         if (componentsReply.isError()) {
             genericErrorOccured(QStringLiteral("Error while calling allComponents()"), componentsReply.error());
 
@@ -79,38 +104,59 @@ void GlobalAccelModel::load()
             return;
         }
         const QList<QDBusObjectPath> componentPaths = componentsReply.value();
-        int *pendingCalls = new int;
-        *pendingCalls = componentPaths.size();
+        state->pendingCalls = componentPaths.size();
+        if (componentPaths.isEmpty()) {
+            buildComponents(state);
+            return;
+        }
         for (const auto &componentPath : componentPaths) {
             const QString path = componentPath.path();
             KGlobalAccelComponentInterface component(m_globalAccelInterface->service(), path, m_globalAccelInterface->connection());
             auto watcher = new QDBusPendingCallWatcher(component.allShortcutInfos());
-            connect(watcher, &QDBusPendingCallWatcher::finished, this, [path, pendingCalls, this](QDBusPendingCallWatcher *watcher) {
+            connect(watcher, &QDBusPendingCallWatcher::finished, this, [path, state, this](QDBusPendingCallWatcher *watcher) {
                 QDBusPendingReply<QList<KGlobalShortcutInfo>> reply = *watcher;
+                watcher->deleteLater();
+                if (state->generation != m_loadGeneration) {
+                    return;
+                }
