                 } else if (!reply.value().isEmpty()) {
-                    m_pendingComponents.push_back(loadComponent(reply.value()));
+                    state->infos.push_back(reply.value());
                 }
-                watcher->deleteLater();
-                if (--*pendingCalls == 0) {
-                    beginResetModel();
-                    QCollator collator;
-                    collator.setCaseSensitivity(Qt::CaseInsensitive);
-                    collator.setNumericMode(true);
-                    m_components = m_pendingComponents;
-                    m_pendingComponents.clear();
-                    std::sort(m_components.begin(), m_components.end(), [&](const Component &c1, const Component &c2) {
-                        return c1.type != c2.type ? c1.type < c2.type : collator.compare(c1.displayName, c2.displayName) < 0;
-                    });
-                    endResetModel();
-                    delete pendingCalls;
+                if (--state->pendingCalls == 0) {
+                    buildComponents(state);
                 }
             });
         }
     });
 }
 
+void GlobalAccelModel::buildComponents(const QSharedPointer<LoadState> &state)
+{
+    if (state->generation != m_loadGeneration) {
+        return;
+    }
+    if (!state->infos.isEmpty()) {
+        // one component per event-loop turn, so painting and input are not blocked by the whole list
+        m_pendingComponents.push_back(loadComponent(state->infos.takeFirst(), state.data()));
+        QMetaObject::invokeMethod(
+            this,
+            [this, state] {
+                buildComponents(state);
+            },
+            Qt::QueuedConnection);
+        return;
+    }
+    beginResetModel();
+    m_components = m_pendingComponents;
+    m_pendingComponents.clear();
+    std::sort(m_components.begin(), m_components.end(), [&](const Component &c1, const Component &c2) {
+        return c1.type != c2.type ? c1.type < c2.type : state->collator.compare(c1.displayName, c2.displayName) < 0;
+    });
+    endResetModel();
+}
