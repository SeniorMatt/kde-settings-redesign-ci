 void KCMKeys::load()
 {
-    m_globalAccelModel->load();
-    m_standardShortcutsModel->load();
+    // Nothing here may block the first frame: the standard shortcuts (about 80 KStandardShortcut lookups plus
+    // collator sorts) and the D-Bus requests for the KGlobalAccel components start one event-loop turn later.
+    // The standard model goes first so its model reset cannot clear a component selected by the global one.
