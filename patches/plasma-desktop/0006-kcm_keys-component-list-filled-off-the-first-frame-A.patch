     const QString &componentUnique = info[0].componentUniqueName();
     const QString &componentFriendly = info[0].componentFriendlyName();
 
@@ -156,13 +209,25 @@ Component GlobalAccelModel::loadComponent(const QList<KGlobalShortcutInfo> &info
     }
 
     if (!service) {
-        // Do we have a service with that name?
-        auto filter = [componentUnique, componentFriendly](const KService::Ptr service) {
-            return service->name() == componentUnique || service->name() == componentFriendly;
-        };
-
-        const KService::List services = KApplicationTrader::query(filter);
-        service = services.value(0, KService::Ptr());
+        // Do we have a service with that name? The first one in KApplicationTrader order wins, as before.
+        if (!loadState->servicesBuilt) {
+            loadState->servicesBuilt = true;
+            const KService::List all = KApplicationTrader::query([](const KService::Ptr &) {
+                return true;
+            });
+            // iterate backwards: QHash::insert replaces, so the lowest index is the one that stays
+            for (int i = all.size() - 1; i >= 0; --i) {
+                loadState->servicesByName.insert(all.at(i)->name(), {i, all.at(i)});
+            }
+        }
+        const auto byUnique = loadState->servicesByName.constFind(componentUnique);
+        const auto byFriendly = loadState->servicesByName.constFind(componentFriendly);
+        const auto end = loadState->servicesByName.constEnd();
+        if (byUnique != end && (byFriendly == end || byUnique->first <= byFriendly->first)) {
+            service = byUnique->second;
+        } else if (byFriendly != end) {
+            service = byFriendly->second;
+        }
     }
 
     auto type = classify(service);
@@ -208,11 +273,8 @@ Component GlobalAccelModel::loadComponent(const QList<KGlobalShortcutInfo> &info
         action.initialShortcuts = action.activeShortcuts;
         c.actions.push_back(action);
     }
-    QCollator collator;
-    collator.setCaseSensitivity(Qt::CaseInsensitive);
-    collator.setNumericMode(true);
     std::sort(c.actions.begin(), c.actions.end(), [&](const Action &s1, const Action &s2) {
-        return collator.compare(s1.displayName, s2.displayName) < 0;
+        return loadState->collator.compare(s1.displayName, s2.displayName) < 0;
     });
     return c;
 }
