+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+import org.kde.plasma.workspace.timezoneselector as TimeZone
+
+TimeZone.TimezoneSelector {
+    id: timeZoneSelector
+
+    required property var configModule
+    implicitWidth: Kirigami.Units.gridUnit * 50
+    implicitHeight: Math.round(width * 3 / 4)
+
+    selectedTimeZone: configModule.timeZone
+
+    onSelectedTimeZoneChanged: {
+        configModule.timeZone = selectedTimeZone
+    }
+
+    Connections {
+        target: configModule
+        function onTimeZoneChanged(): void {
+            timeZoneSelector.selectedTimeZone = configModule.timeZone
+        }
+    }
+}
