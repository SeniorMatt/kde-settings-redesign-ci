 #include <QTimeZone>
 #include <qqml.h>
 
@@ -186,7 +188,6 @@ void DateAndTime::load()
 {
     m_systemTimeZone = {};
     m_timeZone = {};
-    m_systemNtpEnabled = false;
     m_systemNtpEnabledSet = false;
     m_ntpEnabled = false;
     m_ntpEnabledSet = false;
@@ -199,19 +200,35 @@ void DateAndTime::load()
 
 void DateAndTime::refresh()
 {
-    if (!m_systemNtpEnabledSet || !m_ntpAvailable) {
-        OrgFreedesktopTimedate1Interface timeDatedIface("org.freedesktop.timedate1"_L1, "/org/freedesktop/timedate1"_L1, QDBusConnection::systemBus());
-        const auto oldNtpAvailable = std::exchange(m_ntpAvailable, timeDatedIface.canNTP());
-        if (m_ntpAvailable) {
-            m_messages.remove(NtpUnavailableKey);
-        } else {
-            addMessage(Message::error(i18n("Unable to change NTP settings")), false, NtpUnavailableKey);
-        }
-        const auto oldSystemNtpEnabled = std::exchange(m_systemNtpEnabled, timeDatedIface.nTP());
-        m_systemNtpEnabledSet = true;
-        if (oldNtpAvailable != m_ntpAvailable || oldSystemNtpEnabled != m_systemNtpEnabled) {
-            Q_EMIT ntpChanged();
-        }
+    // ksr: timedated is queried asynchronously, the first frame must not wait for the system bus
+    if ((!m_systemNtpEnabledSet || !m_ntpAvailable) && !m_ntpQueryPending) {
+        m_ntpQueryPending = true;
+        auto call = QDBusMessage::createMethodCall("org.freedesktop.timedate1"_L1,
+                                                   "/org/freedesktop/timedate1"_L1,
+                                                   "org.freedesktop.DBus.Properties"_L1,
+                                                   "GetAll"_L1);
+        call << "org.freedesktop.timedate1"_L1;
+        auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(call), this);
+        connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *w) {
+            w->deleteLater();
+            m_ntpQueryPending = false;
+            const QDBusPendingReply<QVariantMap> reply = *w;
+            // a failed call reads as "no NTP support", as the synchronous property getters did
+            const auto props = reply.isError() ? QVariantMap() : reply.value();
+            const auto oldNtpAvailable = std::exchange(m_ntpAvailable, props.value("CanNTP"_L1).toBool());
+            if (m_ntpAvailable) {
+                m_messages.remove(NtpUnavailableKey);
+                Q_EMIT messagesChanged();
+            } else {
+                addMessage(Message::error(i18n("Unable to change NTP settings")), false, NtpUnavailableKey);
+            }
+            const auto oldSystemNtpEnabled = std::exchange(m_systemNtpEnabled, props.value("NTP"_L1).toBool());
+            m_systemNtpEnabledSet = true;
+            if (oldNtpAvailable != m_ntpAvailable || oldSystemNtpEnabled != m_systemNtpEnabled) {
+                Q_EMIT ntpChanged();
+            }
+            checkNeedsSave();
+        });
     }
 
     // Timezone
