+ */
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCMUtils
+
+pragma ComponentBehavior: Bound
+
+// Sub-page of the Date & Time page: the map and the region/zone lists.
+// The selector (GeoJSON parse, map plugin, ~400 polygons) is created asynchronously after the page is shown.
+KCMUtils.SimpleKCM {
+    id: root
+
+    title: i18ndc("kcm_clock", "@title", "Time Zone")
+
+    ColumnLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        QQC2.Label {
+            // ksr: kcm_clock/TimeZone
+            Layout.fillWidth: true
+            text: root.KCMUtils.ConfigModule.timeZoneString
+            wrapMode: Text.Wrap
+        }
+
+        Loader {
+            id: selectorLoader
+            Layout.fillWidth: true
+            Layout.preferredHeight: item ? item.implicitHeight : Kirigami.Units.gridUnit * 20
+            Layout.minimumWidth: Kirigami.Units.gridUnit * 20
+            asynchronous: true
+            Component.onCompleted: setSource("TimeZoneSelectorItem.qml", {configModule: root.KCMUtils.ConfigModule})
+
+            // Only show a busy indicator when loading takes noticeable time
+            QQC2.BusyIndicator {
+                anchors.centerIn: parent
+                running: visible
+                visible: selectorLoader.status === Loader.Loading && showBusy.elapsed
+                Timer {
+                    id: showBusy
+                    property bool elapsed: false
+                    interval: 150
+                    running: selectorLoader.status === Loader.Loading
+                    onTriggered: elapsed = true
+                }
+            }
+        }
+    }
+}
