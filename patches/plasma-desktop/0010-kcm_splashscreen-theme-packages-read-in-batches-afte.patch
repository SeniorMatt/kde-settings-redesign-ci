 }
 
 SplashScreenSettings *KCMSplashScreen::splashScreenSettings() const
@@ -152,14 +148,12 @@ void KCMSplashScreen::addKPackageToModel(const KPackage::Package &pkg)
 
 void KCMSplashScreen::load()
 {
+    // Before: load() listed and opened every Plasma/LookAndFeel package (and filtered by "splashmainscript") before the
+    // page could appear. Now the cheap "None" card is added at once; the packages are read after the first frame, in
+    // ~8 ms batches (loadNextBatch), in the same order and with the same filter.
     m_data->settings()->load();
     m_model->clear();
-
-    const QList<KPackage::Package> pkgs = availablePackages(QStringLiteral("splashmainscript"));
-    for (const KPackage::Package &pkg : pkgs) {
-        addKPackageToModel(pkg);
-    }
-    m_sortModel->sort(Qt::DisplayRole);
+    ++m_loadGeneration;
 
     QStandardItem *row = new QStandardItem(i18n("None"));
     row->setData(s_nonePluginName, PluginNameRole);
@@ -169,13 +163,69 @@ void KCMSplashScreen::load()
     row->setData(false, PendingDeletionRole);
     m_model->insertRow(0, row);
 
-    if (-1 == pluginIndex(m_data->settings()->theme())) {
-        defaults();
+    m_pendingPaths.clear();
+    m_pendingIndex = 0;
+    if (!m_modelLoading) {
+        m_modelLoading = true;
+        Q_EMIT modelLoadingChanged();
     }
 
+    const int generation = m_loadGeneration;
+    QTimer::singleShot(0, this, [this, generation]() {
+        if (generation != m_loadGeneration) {
+            return;
+        }
+        m_pendingPaths = availablePackagePaths();
+        m_pendingIndex = 0;
+        loadNextBatch(generation);
+    });
+
     Q_EMIT m_data->settings()->themeChanged();
 }
 
+void KCMSplashScreen::loadNextBatch(int generation)
+{
+    if (generation != m_loadGeneration) {
+        return; // a newer load() has started
+    }
+
+    QElapsedTimer timer;
+    timer.start();
+
+    bool added = false;
+    while (m_pendingIndex < m_pendingPaths.size() && timer.elapsed() < 8) {
+        KPackage::Package pkg = KPackage::PackageLoader::self()->loadPackage(QStringLiteral("Plasma/LookAndFeel"));
+        pkg.setPath(m_pendingPaths.at(m_pendingIndex++));
+        pkg.setFallbackPackage(KPackage::Package());
+        if (!pkg.filePath(QByteArrayLiteral("splashmainscript")).isEmpty()) {
+            addKPackageToModel(pkg);
+            added = true;
+        }
+    }
+
+    if (added) {
+        m_sortModel->sort(Qt::DisplayRole);
+        // Re-evaluates the selected card's index (view.currentIndex) once the selected theme has arrived
+        Q_EMIT m_data->settings()->themeChanged();
+    }
+
+    if (m_pendingIndex < m_pendingPaths.size()) {
+        QTimer::singleShot(0, this, [this, generation]() {
+            loadNextBatch(generation);
+        });
+        return;
+    }
+
+    m_pendingPaths.clear();
+    m_pendingIndex = 0;
+    m_modelLoading = false;
+    Q_EMIT modelLoadingChanged();
+
+    if (-1 == pluginIndex(m_data->settings()->theme())) {
+        defaults();
+    }
+}
+
