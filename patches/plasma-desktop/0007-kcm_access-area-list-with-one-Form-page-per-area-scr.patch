diff --git a/kcms/access/kcmaccess.cpp b/kcms/access/kcmaccess.cpp
index 79d78ac..3656b25 100644
--- a/kcms/access/kcmaccess.cpp
+++ b/kcms/access/kcmaccess.cpp
@@ -13,6 +13,9 @@
 #include <QApplication>
 #include <QDBusConnection>
 #include <QDBusMessage>
+#include <QDBusPendingCall>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
 #include <QDBusReply>
 #include <QFileDialog>
 #include <QProcess>
@@ -263,15 +266,40 @@ void KAccessConfig::load()
 {
     KQuickManagedConfigModule::load();
 
-    QDBusMessage screenReaderEnabledMessage =
-        QDBusMessage::createMethodCall(u"org.kde.kded6"_s, u"/modules/screenreader"_s, u"org.kde.screenreader"_s, u"enabled"_s);
-    QDBusReply<bool> reply = QDBusConnection::sessionBus().call(screenReaderEnabledMessage);
-
-    if (reply.isValid()) {
-        m_screenReaderEnabled = reply.value();
-        Q_EMIT screenReaderEnabledChanged();
-    } else {
-        qCWarning(KCM_ACCESS) << "Failed to read screenreader enabled" << reply.error().message();
+    // Was two blocking session-bus calls per evaluation (here, then again in isSaveNeeded() and screenReaderIsDefaults(),
+    // which the shell and every sidebar row call repeatedly). Now: ask kded once, off the first frame, and cache.
+    auto *enabledWatcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(
+                                                           QDBusMessage::createMethodCall(u"org.kde.kded6"_s, u"/modules/screenreader"_s, u"org.kde.screenreader"_s, u"enabled"_s)),
+                                                       this);
+    connect(enabledWatcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        QDBusPendingReply<bool> reply = *watcher;
+        if (reply.isValid()) {
+            m_screenReaderSaved = reply.value();
+            m_screenReaderEnabled = reply.value();
+            Q_EMIT screenReaderEnabledChanged();
+            Q_EMIT screenReaderIsDefaultsChanged();
+        } else {
+            qCWarning(KCM_ACCESS) << "Failed to read screenreader enabled" << reply.error().message();
+        }
+    });
+
+    if (!m_screenReaderDefaultKnown) {
+        auto *defaultWatcher = new QDBusPendingCallWatcher(
+            QDBusConnection::sessionBus().asyncCall(
+                QDBusMessage::createMethodCall(u"org.kde.kded6"_s, u"/modules/screenreader"_s, u"org.kde.screenreader"_s, u"enabledByDefault"_s)),
+            this);
+        connect(defaultWatcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+            watcher->deleteLater();
+            QDBusPendingReply<bool> reply = *watcher;
+            if (reply.isValid()) {
+                m_screenReaderDefault = reply.value();
+                m_screenReaderDefaultKnown = true;
+                Q_EMIT screenReaderIsDefaultsChanged();
+            } else {
+                qCWarning(KCM_ACCESS) << "Failed to read enabledByDefault" << reply.error().message();
+            }
+        });
     }
 }
 
@@ -418,6 +446,8 @@ void KAccessConfig::save()
 
     if (!reply.isValid()) {
         qCWarning(KCM_ACCESS) << "Failed to send setEnabled" << reply.error().message();
+    } else {
+        m_screenReaderSaved = m_screenReaderEnabled;
     }
 }
 
@@ -438,15 +468,8 @@ bool KAccessConfig::isDefaults() const
 
 bool KAccessConfig::isSaveNeeded() const
 {
-    QDBusMessage msg = QDBusMessage::createMethodCall(u"org.kde.kded6"_s, u"/modules/screenreader"_s, u"org.kde.screenreader"_s, u"enabled"_s);
-    QDBusReply<bool> reply = QDBusConnection::sessionBus().call(msg);
-
-    if (!reply.isValid()) {
-        qCWarning(KCM_ACCESS) << "Failed to read isSaveNeeded" << reply.error().message();
-        return false;
-    }
-
-    return m_screenReaderEnabled != reply.value();
+    // Cached at load()/save(); no D-Bus call here (this is evaluated on every change notification)
+    return m_screenReaderEnabled != m_screenReaderSaved;
 }
 
 QString KAccessConfig::orcaLaunchFeedback() const
@@ -534,14 +557,8 @@ bool KAccessConfig::keyboardModifiersIsDefaults() const
 
 bool KAccessConfig::screenReaderIsDefaults() const
 {
-    QDBusMessage msg = QDBusMessage::createMethodCall(u"org.kde.kded6"_s, u"/modules/screenreader"_s, u"org.kde.screenreader"_s, u"enabledByDefault"_s);
-    QDBusReply<bool> reply = QDBusConnection::sessionBus().call(msg);
-
-    if (!reply.isValid()) {
-        qCWarning(KCM_ACCESS) << "Failed to read enabledByDefault" << reply.error().message();
-    }
-
-    return m_screenReaderEnabled == reply.value();
+    // The default is read once in load(); until kded answers it is "off", which is what the old code used on failure too
+    return m_screenReaderEnabled == m_screenReaderDefault;
 }
 
 bool KAccessConfig::shakeCursorIsDefaults() const
