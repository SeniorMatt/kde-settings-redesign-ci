+/*
+    SPDX-FileCopyrightText: 2021 Aleix Pol Gonzalez <aleixpol@kde.org>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.tablet.kcm as KCM
+import org.kde.kcmutils
+
+// Sub-page of the Drawing Tablet page (kcm.push from main.qml).
+SimpleKCM {
+    id: root
+
+    property KCM.InputDevice device
+    property KCM.InputDevice padDevice
+    property KCM.TabletEvents tabletEvents
+
+    title: i18nc("@title", "Pad")
+
+    implicitWidth: Kirigami.Units.gridUnit * 38
+    implicitHeight: Kirigami.Units.gridUnit * 35
+
+    topPadding: 0
+    leftPadding: 0
+    rightPadding: 0
+    bottomPadding: 0
+
+    // So it doesn't scroll while dragging
+    flickable.interactive: Kirigami.Settings.hasTransientTouchInput
+
+    // The tablet went away or changed under this page: back to the main page, which picks the device again.
+    Connections {
+        target: kcm.tabletsModel
+
+        function onDeviceRemoved(): void {
+            kcm.pop();
+        }
+
+        function onDeviceChanged(): void {
+            kcm.pop();
+        }
+    }
+
+    Component {
+        id: padTab
+
+        PadTab {
+            device: root.device
+            padDevice: root.padDevice
+            tabletEvents: root.tabletEvents
+        }
+    }
+
+    Component {
+        id: missingPadTab
+
+        MissingPadTab {}
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+
+        Loader {
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+
+            sourceComponent: root.padDevice ? padTab : missingPadTab
+        }
+
+    }
+}
