+void SearchConfigModule::startRunnerScan()
 {
-    QList<KPluginMetaData> metaDataList = KRunner::RunnerManager::runnerMetaDataList();
-    auto it = std::partition(metaDataList.begin(), metaDataList.end(), [&currentFavoriteIds](const KPluginMetaData &plugin) {
-        return currentFavoriteIds.contains(plugin.pluginId());
+    // RunnerManager::runnerMetaDataList() scans the plugin directories and parses the metadata of every runner
+    // (plus the D-Bus runner .desktop files). It only returns value types, so it can run off the GUI thread.
+    auto result = std::make_shared<QList<KPluginMetaData>>();
+    QThread *thread = QThread::create([result]() {
+        *result = KRunner::RunnerManager::runnerMetaDataList();
+    });
+    m_scanThread = thread;
+    connect(thread, &QThread::finished, this, [this, result]() {
+        m_scanThread = nullptr;
+        if (m_rescanWanted) {
+            // reloadPlugins() was called while this scan ran, so it may have missed new plugins
+            m_rescanWanted = false;
+            startRunnerScan();
+            return;
+        }
+        m_runnerCache = *result;
+        m_runnerCacheValid = true;
+        const auto waiters = std::exchange(m_waiters, {});
+        for (const auto &waiter : waiters) {
+            waiter();
+        }
     });
+    connect(thread, &QThread::finished, thread, &QObject::deleteLater);
+    thread->start();
+}
+
+void SearchConfigModule::whenRunnersReady(std::function<void()> continuation)
+{
+    if (m_runnerCacheValid) {
+        QMetaObject::invokeMethod(this, std::move(continuation), Qt::QueuedConnection);
+        return;
+    }
+    m_waiters << std::move(continuation);
+    if (!m_scanThread) {
+        startRunnerScan();
+    }
+}
 
-    m_favoriteMetaDataList = QList<KPluginMetaData>(metaDataList.begin(), it);
-    std::sort(m_favoriteMetaDataList.begin(), m_favoriteMetaDataList.end(), [&currentFavoriteIds](const KPluginMetaData &data1, const KPluginMetaData &data2) {
-        return currentFavoriteIds.indexOf(data1.pluginId()) < currentFavoriteIds.indexOf(data2.pluginId());
+void SearchConfigModule::loadPlugins(const QStringList &currentFavoriteIds, const std::function<void()> &done)
+{
+    const quint64 generation = ++m_generation;
+    setLoading(true);
+
+    whenRunnersReady([this, generation, currentFavoriteIds, done]() {
+        if (generation != m_generation) {
+            return; // a newer load/defaults call replaced this one
+        }
+        QList<KPluginMetaData> metaDataList = m_runnerCache;
+        auto it = std::partition(metaDataList.begin(), metaDataList.end(), [&currentFavoriteIds](const KPluginMetaData &plugin) {
+            return currentFavoriteIds.contains(plugin.pluginId());
+        });
+
+        m_favoriteMetaDataList = QList<KPluginMetaData>(metaDataList.begin(), it);
+        std::sort(m_favoriteMetaDataList.begin(), m_favoriteMetaDataList.end(), [&currentFavoriteIds](const KPluginMetaData &data1, const KPluginMetaData &data2) {
+            return currentFavoriteIds.indexOf(data1.pluginId()) < currentFavoriteIds.indexOf(data2.pluginId());
+        });
+        // Step 1: the favorites (a handful of rows, enough for the first screen)
+        if (!m_favoriteMetaDataList.isEmpty()) {
+            m_model->addUnsortablePlugins(m_favoriteMetaDataList, m_favoriteCategory);
+        }
+
+        // Step 2, one event-loop turn later so the first rows can be painted: the other runners.
+        // KPluginModel::addPlugins looks up each plugin's config module (a QPluginLoader probe), which is the slow part.
+        const QList<KPluginMetaData> rest(it, metaDataList.end());
+        QTimer::singleShot(0, this, [this, generation, rest, done]() {
+            if (generation != m_generation) {
+                return;
+            }
+            if (!rest.isEmpty()) {
+                m_model->addPlugins(rest, m_normalCategory);
+            }
+            setLoading(false);
+            if (done) {
+                done();
+            }
+        });
     });
-    m_model->addUnsortablePlugins(m_favoriteMetaDataList, m_favoriteCategory);
-    m_model->addPlugins(QList<KPluginMetaData>(it, metaDataList.end()), m_normalCategory);
 }
 
