+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+
+import org.kde.kcmutils as KCM
+import org.kde.kirigami as Kirigami
+
+import org.kde.plasma.gamecontroller.kcm
+
+// Sub-page for one controller: what it is, and a live view of its sticks, buttons and axes.
+KCM.SimpleKCM {
+    id: root
+
+    property int deviceId: -1
+
+    readonly property var device: DeviceModel.device(deviceId)
+    readonly property var deviceType: device?.type ?? ""
+    readonly property var deviceControllerType: device?.controllerTypeName ?? ""
+    readonly property var deviceConnectionType: device?.connectionType ?? ""
+
+    title: i18nc("@title", "Test Controller")
+
+    implicitWidth: Kirigami.Units.gridUnit * 38
+    implicitHeight: Kirigami.Units.gridUnit * 28
+
+    Connections {
+        target: DeviceModel
+
+        // Controller unplugged while its page is open: go back to the list.
+        function onDevicesChanged() {
+            if (DeviceModel.device(root.deviceId) === null) {
+                kcm.pop();
+            }
+        }
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        spacing: Kirigami.Units.largeSpacing
+
+        Kirigami.FormLayout {
+            Layout.fillWidth: true
+
+            QQC2.Label {
+                // ksr: kcm_gamecontroller/DeviceType
+                Kirigami.FormData.label: i18nc("@label game controller device type (wheel, joystick, game controller, etc.)", "Device type:")
+                text: root.deviceType
+                textFormat: Text.PlainText
+            }
+
+            QQC2.Label {
+                // ksr: kcm_gamecontroller/ControllerType
+                Kirigami.FormData.label: i18nc("@label game controller controller type (which brand, etc.)", "Controller type:")
+                text: root.deviceControllerType
+                textFormat: Text.PlainText
+            }
+
+            QQC2.Label {
+                // ksr: kcm_gamecontroller/ConnectionType
+                Kirigami.FormData.label: i18nc("@label:textbox", "Connection type:")
+                text: root.deviceConnectionType
+                textFormat: Text.PlainText
+            }
+        }
+
+        RowLayout {
+            spacing: Kirigami.Units.largeSpacing
+
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+
+            ColumnLayout {
+                spacing: Kirigami.Units.largeSpacing
+
+                Layout.alignment: Qt.AlignTop
+
+                QQC2.Label {
+                    // ksr: kcm_gamecontroller/LeftPosition
+                    text: i18nc("@label Visual representation of the axis position for the left axis", "Left position:")
+                    textFormat: Text.PlainText
+                }
+
+                PositionWidget {
+                    id: leftPosWidget
+
+                    device: root.device
+                    leftAxis: true
+                }
+
+                QQC2.Label {
+                    // ksr: kcm_gamecontroller/RightPosition
+                    text: i18nc("@label Visual representation of the axis position for the right axis", "Right position:")
+                    textFormat: Text.PlainText
+                }
+
+                PositionWidget {
+                    id: rightPosWidget
+                    device: root.device
+                    leftAxis: false
+                }
+            }
+
+            ColumnLayout {
+                spacing: Kirigami.Units.largeSpacing
+
+                Layout.fillWidth: true
+                Layout.fillHeight: true
+                Layout.preferredWidth: 50 // Same space for the two columns
+
+                QQC2.Label {
+                    // ksr: kcm_gamecontroller/Buttons
+                    text: i18nc("@label Gamepad buttons", "Buttons:")
+                    textFormat: Text.PlainText
+                }
+
+                Table {
+                    model: ButtonModel {
+                        device: root.device
+                    }
+
+                    Layout.fillWidth: true
+                    Layout.fillHeight: true
+                }
+            }
+
+            ColumnLayout {
+                spacing: Kirigami.Units.largeSpacing
+
+                Layout.fillWidth: true
+                Layout.fillHeight: true
+                Layout.preferredWidth: 50 // Same space for the two columns
+
+                QQC2.Label {
+                    // ksr: kcm_gamecontroller/Axes
+                    text: i18nc("@label Gamepad axes (sticks)", "Axes:")
+                    textFormat: Text.PlainText
+                }
+
+                Table {
+                    model: AxesProxyModel {
+                        device: root.device
+                    }
+
+                    Layout.fillWidth: true
+                    Layout.fillHeight: true
+                }
+            }
+        }
+    }
+}
