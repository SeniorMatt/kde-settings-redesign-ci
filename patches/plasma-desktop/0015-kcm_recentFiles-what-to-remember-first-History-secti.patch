index 1db0985..59c375a 100644
--- a/kcms/recentFiles/kcm_recentFiles.cpp
+++ b/kcms/recentFiles/kcm_recentFiles.cpp
@@ -12,6 +12,7 @@
 #include <QDBusPendingCall>
 
 #include <QMenu>
+#include <QTimer>
 #include <QQmlComponent>
 #include <QQmlContext>
 #include <QQmlEngine>
@@ -95,7 +96,11 @@ RecentFilesKcm::RecentFilesKcm(QObject *parent, const KPluginMetaData &data)
 
     d->viewExcludeddApplications->setClearColor(QGuiApplication::palette().window().color());
     d->viewExcludeddApplications->rootContext()->setContextProperty(QStringLiteral("applicationModel"), d->excludedApplicationsModel);
-    d->viewExcludeddApplications->setSource(QUrl::fromLocalFile(KAMD_KCM_DATADIR + QStringLiteral("/qml/recentFiles/ExcludedApplicationView.qml")));
+    // ksr: speed. Creating the QML engine and the application list used to happen before the first frame.
+    // Both run from the event loop once the page has been shown.
+    QTimer::singleShot(0, this, [this]() {
+        d->viewExcludeddApplications->setSource(QUrl::fromLocalFile(KAMD_KCM_DATADIR + QStringLiteral("/qml/recentFiles/ExcludedApplicationView.qml")));
+    });
 
     // React to changes
 
@@ -147,7 +152,11 @@ void RecentFilesKcm::defaults()
 
 void RecentFilesKcm::load()
 {
-    d->excludedApplicationsModel->load();
+    // ksr: speed. load() opens the activity SQLite database and looks up a KService per application; do it after the
+    // first frame. The model resets itself (removeRows/insertRows) so the view fills in when it is done.
+    QTimer::singleShot(0, this, [this]() {
+        d->excludedApplicationsModel->load();
+    });
 
     KCModule::load();
 
