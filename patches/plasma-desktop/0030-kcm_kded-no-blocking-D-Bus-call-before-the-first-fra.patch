From e54ed5e589339774358a7a88d7584976acf657d6 Mon Sep 17 00:00:00 2001
From: Senior Matthew <SeniorMatt@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:06:49 +0500
Subject: [PATCH 30/32] kcm_kded: no blocking D-Bus call before the first
 frame; module scan after it; empty-search message

Page type: List (search + filter, then Startup / Load-on-Demand sections), unchanged structure and wording, so no relabel rows.
Speed cause (code): KDEDConfig constructor called QDBusConnectionInterface::isServiceRegistered() (synchronous D-Bus
round trip) and load() ran ModulesModel::load() (KPluginMetaData::findPlugins("kf6/kded") + kded5rc reads + sort) before
the first frame. Now NameHasOwner goes through asyncCall + QDBusPendingCallWatcher, and the first model load is queued
with QTimer::singleShot(0) so the page paints first (later Reset loads stay synchronous).
- New property kdedStateKnown so the "kded6 is not running" error is not flashed while the async check is pending.
- ModulesModel: dataChanged is skipped while the model is still empty (avoids invalid-index signals).
- Placeholder "No matching services" when the search/filter hides everything (HIG empty states).
After-numbers: pending, manager will measure. NOT BUILT YET (QDBusAbstractInterface::asyncCall on
QDBusConnectionInterface assumed available in Qt 6; not compiled).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X5N5x9eWzmrq6QYrYLwQnk
---
 kcms/kded/kcmkded.cpp      | 25 ++++++++++++++++++++++++-
 kcms/kded/kcmkded.h        |  8 ++++++++
 kcms/kded/modulesmodel.cpp |  5 ++++-
 kcms/kded/ui/main.qml      | 10 +++++++++-
 4 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/kcms/kded/kcmkded.cpp b/kcms/kded/kcmkded.cpp
index b7a6912..e85bc17 100644
--- a/kcms/kded/kcmkded.cpp
+++ b/kcms/kded/kcmkded.cpp
@@ -11,6 +11,7 @@
 #include "debug.h"
 
 #include <qqml.h>
+#include <QTimer>
 
 #include <QDBusConnection>
 #include <QDBusConnectionInterface>
@@ -59,7 +60,18 @@ KDEDConfig::KDEDConfig(QObject *parent, const KPluginMetaData &metaData)
         Q_UNUSED(oldOwner)
         setKdedRunning(!newOwner.isEmpty());
     });
-    setKdedRunning(QDBusConnection::sessionBus().interface()->isServiceRegistered(s_kdedServiceName));
+
+    // ksr: NameHasOwner used to be a blocking call in the constructor; ask asynchronously so the page opens first.
+    auto *registeredCall = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().interface()->asyncCall(QStringLiteral("NameHasOwner"), s_kdedServiceName), this);
+    connect(registeredCall, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<bool> reply = *watcher;
+        watcher->deleteLater();
+        setKdedRunning(reply.isValid() && reply.value());
+        if (!m_kdedStateKnown) {
+            m_kdedStateKnown = true;
+            Q_EMIT kdedStateKnownChanged();
+        }
+    });
 }
 
 ModulesModel *KDEDConfig::model() const
@@ -182,6 +194,17 @@ void KDEDConfig::getModuleStatus()
 
 void KDEDConfig::load()
 {
+    if (!m_modelLoaded) {
+        // First load: scan the module plugins after the first frame instead of in the constructor/load() path.
+        m_modelLoaded = true;
+        QTimer::singleShot(0, this, [this] {
+            m_model->load();
+            setNeedsSave(false);
+            setRepresentsDefaults(m_model->representsDefault());
+        });
+        return;
+    }
+
     m_model->load();
 
     setNeedsSave(false);
