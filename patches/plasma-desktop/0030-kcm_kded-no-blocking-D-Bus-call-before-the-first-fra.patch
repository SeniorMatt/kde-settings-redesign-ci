+    }
 
     Q_INVOKABLE void startModule(const QString &moduleName);
     Q_INVOKABLE void stopModule(const QString &moduleName);
@@ -71,6 +76,7 @@ public:
 
 Q_SIGNALS:
     void kdedRunningChanged();
+    void kdedStateKnownChanged();
 
     void errorMessage(const QString &errorString);
     void showSelfDisablingModulesHint();
@@ -89,6 +95,8 @@ private:
 
     QDBusServiceWatcher *const m_kdedWatcher;
     bool m_kdedRunning = false;
+    bool m_kdedStateKnown = false;
+    bool m_modelLoaded = false;
 
     QString m_lastStartedModule;
     QStringList m_runningModulesBeforeReconfigure;
diff --git a/kcms/kded/modulesmodel.cpp b/kcms/kded/modulesmodel.cpp
index ce0de2f..f6fc418 100644
--- a/kcms/kded/modulesmodel.cpp
+++ b/kcms/kded/modulesmodel.cpp
@@ -226,6 +226,9 @@ void ModulesModel::setRunningModulesKnown(bool known)
 {
     if (m_runningModulesKnown != known) {
         m_runningModulesKnown = known;
+        if (m_data.isEmpty()) {
+            return; // model not filled yet (it is loaded after the first frame); rows read the state when they appear
+        }
         Q_EMIT dataChanged(index(0, 0), index(m_data.count() - 1, 0), {StatusRole});
     }
 }
@@ -242,7 +245,7 @@ void ModulesModel::setRunningModules(const QStringList &runningModules)
     }
 
     m_runningModules = runningModules;
-    if (m_runningModulesKnown) {
+    if (m_runningModulesKnown && !m_data.isEmpty()) {
         Q_EMIT dataChanged(index(0, 0), index(m_data.count() - 1, 0), {StatusRole});
     }
 }
