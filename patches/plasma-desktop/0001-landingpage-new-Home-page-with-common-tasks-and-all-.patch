+void KCMLandingPage::loadHomeData()
+{
+    if (m_homeDataLoaded) {
+        return;
+    }
+    m_homeDataLoaded = true;
+
+    // Installed pages: QML and QtWidgets ones. One scan of the plugin directories, not one lookup per page.
+    QHash<QString, QString> icons;
+    for (const char *directory : {"plasma/kcms/systemsettings", "plasma/kcms/systemsettings_qwidgets"}) {
+        const auto plugins = KPluginMetaData::findPlugins(QString::fromLatin1(directory));
+        for (const KPluginMetaData &plugin : plugins) {
+            if (!icons.contains(plugin.pluginId())) {
+                icons.insert(plugin.pluginId(), plugin.iconName());
+            }
+        }
+    }
+
+    // The id a page is installed under (a page may have been renamed), or an empty string
+    auto installedId = [&icons](const QString &id) -> QString {
+        auto candidates = QStringList{id};
+        for (const auto &alias : HomeData::idAliases) {
+            if (id == QLatin1StringView(alias.alias)) {
+                candidates << QString::fromLatin1(alias.id);
+            } else if (id == QLatin1StringView(alias.id)) {
+                candidates << QString::fromLatin1(alias.alias);
+            }
+        }
+        for (const QString &candidate : std::as_const(candidates)) {
+            if (icons.contains(candidate) && KAuthorized::authorizeControlModule(candidate)) {
+                return candidate;
+            }
+        }
+        return {};
+    };
+
+    m_commonTasks.clear();
+    for (const auto &task : HomeData::commonTasks) {
+        const QString kcm = installedId(QString::fromLatin1(task.kcm));
+        if (!kcm.isEmpty()) {
+            m_commonTasks.append(QVariantMap{{QStringLiteral("title"), KLocalizedString(task.title).toString()},
+                                             {QStringLiteral("icon"), icons.value(kcm)},
+                                             {QStringLiteral("kcm"), kcm}});
+        }
+    }
+
+    m_categoryGroups.clear();
+    for (const auto &group : HomeData::groups) {
+        QVariantList cards;
+        for (const auto &category : HomeData::categories) {
+            if (QLatin1StringView(category.group) != QLatin1StringView(group.id)) {
+                continue;
+            }
+            // The card opens the first installed page of the category
+            for (int i = 0; i < category.pageCount; ++i) {
+                const QString kcm = installedId(QString::fromLatin1(category.pages[i]));
+                if (!kcm.isEmpty()) {
+                    cards.append(QVariantMap{{QStringLiteral("name"), KLocalizedString(category.name).toString()},
+                                             {QStringLiteral("icon"), QString::fromLatin1(category.icon)},
+                                             {QStringLiteral("description"), KLocalizedString(category.description).toString()},
+                                             {QStringLiteral("kcm"), kcm}});
+                    break;
+                }
+            }
+        }
+        if (!cards.isEmpty()) {
+            m_categoryGroups.append(QVariantMap{{QStringLiteral("name"), KLocalizedString(group.name).toString()}, {QStringLiteral("categories"), cards}});
+        }
+    }
+    Q_EMIT homeDataChanged();
+}
