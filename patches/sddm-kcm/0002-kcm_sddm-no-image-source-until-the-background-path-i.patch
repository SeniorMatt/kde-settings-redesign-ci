 src/ui/main.qml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/ui/main.qml b/src/ui/main.qml
index da7d7af..68e8ae2 100644
--- a/src/ui/main.qml
+++ b/src/ui/main.qml
