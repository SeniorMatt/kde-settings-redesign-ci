@@ -140,6 +143,32 @@ bool ThemesModel::setData(const QModelIndex &index, const QVariant &value, int r
 }
 
 void ThemesModel::populate()
+{
+    populateThemes();
+
+    // The current theme may have been set before the list existed.
+    if (!m_requestedTheme.isEmpty()) {
+        const auto it = std::find_if(mThemeList.cbegin(), mThemeList.cend(), [this](const ThemeMetadata &themeData) {
+            return themeData.themeid() == m_requestedTheme;
+        });
+        if (it != mThemeList.cend()) {
+            m_currentIndex = it - mThemeList.cbegin();
+        }
+        Q_EMIT currentIndexChanged();
+    }
+
+    if (!m_loaded) {
+        m_loaded = true;
+        Q_EMIT loadedChanged();
+    }
+}
+
+bool ThemesModel::loaded() const
+{
+    return m_loaded;
+}
+
+void ThemesModel::populateThemes()
 {
     if (!mThemeList.isEmpty()) {
         beginResetModel();
@@ -234,11 +263,15 @@ int ThemesModel::currentIndex() const
 
 QString ThemesModel::currentTheme() const
 {
+    if (m_currentIndex < 0 || m_currentIndex >= mThemeList.size()) {
+        return m_requestedTheme;
+    }
     return mThemeList[m_currentIndex].themeid();
 }
 
 void ThemesModel::setCurrentTheme(const QString &theme)
 {
+    m_requestedTheme = theme;
     auto it = std::find_if(mThemeList.cbegin(), mThemeList.cend(), [&theme](const ThemeMetadata &themeData) {
         return themeData.themeid() == theme;
     });
