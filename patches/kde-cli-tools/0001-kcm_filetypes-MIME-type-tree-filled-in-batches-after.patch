@@ -134,31 +146,83 @@ static bool mimeTypeLessThan(const QMimeType &m1, const QMimeType &m2)
 
 // Note that this method loses any newly-added (and not saved yet) mimetypes.
 // So this is really only for load().
+//
+// Before: this ran in load() before the page was shown. QMimeDatabase::allMimeTypes() plus one TypesListItem per MIME
+// type (about a thousand), each constructing a MimeTypeData that locates and parses the type's XML definition
+// (MimeTypeData::initFromQMimeType). Now the list is read from a single-shot after the first paint, in ~10 ms batches
+// (readNextBatch), in the same order; the search field works while it fills (new rows honour the current filter).
 void FileTypesView::readFileTypes()
 {
     typesLV->clear();
     m_majorMap.clear();
     m_itemList.clear();
+    m_pendingMimeTypes.clear();
+    m_pendingIndex = 0;
+    const int generation = ++m_loadGeneration;
+    m_loading = true;
+    updateDisplay(nullptr);
+
+    QTimer::singleShot(150, this, [this, generation]() {
+        if (generation == m_loadGeneration && m_loading) {
+            m_loadingLabel->setVisible(true);
+        }
+    });
+    QTimer::singleShot(0, this, [this, generation]() {
+        if (generation != m_loadGeneration) {
+            return;
+        }
+        QMimeDatabase db;
+        m_pendingMimeTypes = db.allMimeTypes();
+        std::sort(m_pendingMimeTypes.begin(), m_pendingMimeTypes.end(), mimeTypeLessThan);
+        readNextBatch(generation);
+    });
+}
+
+void FileTypesView::readNextBatch(int generation)
+{
+    if (generation != m_loadGeneration) {
+        return; // a newer load() has started
+    }
+
+    const QString filter = patternFilterLE->text();
+    QElapsedTimer timer;
+    timer.start();
 
-    QMimeDatabase db;
-    QList<QMimeType> mimetypes = db.allMimeTypes();
-    std::sort(mimetypes.begin(), mimetypes.end(), mimeTypeLessThan);
-    auto it2(mimetypes.constBegin());
-    for (; it2 != mimetypes.constEnd(); ++it2) {
-        const QString mimetype = (*it2).name();
+    while (m_pendingIndex < m_pendingMimeTypes.size() && timer.elapsed() < 10) {
+        const QMimeType &mime = m_pendingMimeTypes.at(m_pendingIndex++);
+        const QString mimetype = mime.name();
         const int index = mimetype.indexOf(QLatin1Char('/'));
         const QString maj = mimetype.left(index);
 
         TypesListItem *groupItem = m_majorMap.value(maj);
         if (!groupItem) {
             groupItem = new TypesListItem(typesLV, maj);
+            groupItem->setHidden(!filter.isEmpty()); // shown below when one of its types matches
             m_majorMap.insert(maj, groupItem);
         }
 
-        TypesListItem *item = new TypesListItem(groupItem, (*it2));
+        TypesListItem *item = new TypesListItem(groupItem, mime);
         m_itemList.append(item);
+        if (!filter.isEmpty()) {
+            if (item->mimeTypeData().matchesFilter(filter)) {
+                groupItem->setHidden(false);
+            } else {
+                item->setHidden(true);
+            }
+        }
     }
-    updateDisplay(nullptr);
+
+    if (m_pendingIndex < m_pendingMimeTypes.size()) {
+        QTimer::singleShot(0, this, [this, generation]() {
+            readNextBatch(generation);
+        });
+        return;
+    }
+
+    m_pendingMimeTypes.clear();
+    m_pendingIndex = 0;
+    m_loading = false;
+    m_loadingLabel->setVisible(false);
 }
 
