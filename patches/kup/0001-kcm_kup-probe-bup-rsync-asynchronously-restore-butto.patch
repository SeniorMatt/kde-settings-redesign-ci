+void KupKcm::probeBackupPrograms()
+{
+    // bup: version first, then (only if bup runs at all) whether par2 recovery is available.
+    auto *lBupProcess = new QProcess(this);
+    lBupProcess->setProcessChannelMode(QProcess::MergedChannels);
+    connect(lBupProcess, &QProcess::errorOccurred, this, [this, lBupProcess](QProcess::ProcessError pError) {
+        if (pError == QProcess::FailedToStart) {
+            lBupProcess->deleteLater();
+            probeFinished();
+        }
+    });
+    connect(lBupProcess, &QProcess::finished, this, [this, lBupProcess](int, QProcess::ExitStatus pStatus) {
+        lBupProcess->deleteLater();
+        if (pStatus != QProcess::NormalExit) {
+            probeFinished();
+            return;
+        }
+        mBupVersion = QString::fromUtf8(lBupProcess->readAllStandardOutput());
+        auto *lPar2Process = new QProcess(this);
+        connect(lPar2Process, &QProcess::errorOccurred, this, [this, lPar2Process](QProcess::ProcessError pError) {
+            if (pError == QProcess::FailedToStart) {
+                lPar2Process->deleteLater();
+                probeFinished();
+            }
+        });
+        connect(lPar2Process, &QProcess::finished, this, [this, lPar2Process](int pExitCode, QProcess::ExitStatus pParStatus) {
+            lPar2Process->deleteLater();
+            mPar2Available = pParStatus == QProcess::NormalExit && pExitCode == 0;
+            probeFinished();
+        });
+        lPar2Process->start(QStringLiteral("bup"), {QStringLiteral("fsck"), QStringLiteral("--par2-ok")});
+    });
+    lBupProcess->start(QStringLiteral("bup"), {QStringLiteral("version")});
+
+    auto *lRsyncProcess = new QProcess(this);
+    lRsyncProcess->setProcessChannelMode(QProcess::MergedChannels);
+    connect(lRsyncProcess, &QProcess::errorOccurred, this, [this, lRsyncProcess](QProcess::ProcessError pError) {
+        if (pError == QProcess::FailedToStart) {
+            lRsyncProcess->deleteLater();
+            probeFinished();
+        }
+    });
+    connect(lRsyncProcess, &QProcess::finished, this, [this, lRsyncProcess](int, QProcess::ExitStatus pStatus) {
+        lRsyncProcess->deleteLater();
+        if (pStatus == QProcess::NormalExit) {
+            const QString lOutput = QString::fromLocal8Bit(lRsyncProcess->readLine());
+            mRsyncVersion = lOutput.split(QLatin1Char(' '), Qt::SkipEmptyParts).value(2);
+        }
+        probeFinished();
+    });
+    lRsyncProcess->start(QStringLiteral("rsync"), {QStringLiteral("--version")});
+    // mProbesPending starts at 2 (the bup chain and rsync); a failed start can report before start() returns.
+}
+
+void KupKcm::probeFinished()
+{
+    if (--mProbesPending == 0) {
+        finishSetup();
     }
+}
 
