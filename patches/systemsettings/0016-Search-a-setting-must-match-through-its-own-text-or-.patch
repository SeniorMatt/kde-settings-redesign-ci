     QString name;
     QString foldedName;
     QStringList nameWords;
-    QString haystack; // folded name, keywords and breadcrumb
+    QString haystack; // folded name, keywords and breadcrumb: what a page result matches
+    QString foldedPath; // folded category and page name: what a setting result of the page may match
 };
 
 struct SettingsSearchModel::Setting {
@@ -129,6 +132,7 @@ void SettingsSearchModel::collectPages(MenuItem *item)
         page.foldedName = fold(page.name);
         page.nameWords = words(page.foldedName);
         // Hidden but searchable pages count, like the ones that are in the sidebar
+        page.foldedPath = fold(child->breadcrumb() + u' ' + page.name);
         page.haystack = fold(child->keywords().join(u' ') + u' ' + child->breadcrumb());
         m_pages.append(page);
     }
@@ -167,6 +171,8 @@ void SettingsSearchModel::translateSettings()
         return;
     }
     m_translated = true;
+    QElapsedTimer timer;
+    timer.start();
     static const QRegularExpression placeholder(u"%(?:[0-9]+|n|L[0-9]+)"_s);
     for (Setting &setting : m_settings) {
         const SettingsIndex::Entry &entry = *setting.entry;
@@ -180,6 +186,7 @@ void SettingsSearchModel::translateSettings()
         setting.foldedText = fold(setting.text);
         setting.foldedSection = fold(QString::fromUtf8(entry.section));
     }
+    qCDebug(SYSTEMSETTINGS_APP_LOG) << "Translated" << m_settings.size() << "settings in" << timer.elapsed() << "ms";
 }
 
 QHash<int, QByteArray> SettingsSearchModel::roleNames() const
@@ -332,22 +339,29 @@ void SettingsSearchModel::setQuery(const QString &query)
         for (int i = 0; i < m_settings.size(); ++i) {
             const Setting &setting = m_settings.at(i);
             const Page &page = m_pages.at(setting.page);
-            const QString haystack = setting.foldedText + u' ' + setting.foldedSection + u' ' + page.haystack;
-            if (!containsAll(haystack, queryWords)) {
-                continue;
+            // Every word must be in the setting's own text, its section, or the page and category name. The page's
+            // keywords do not count: they would make every setting of the page match. A setting needs at least one
+            // word of its own, otherwise the page result covers it.
+            int textWords = 0;
+            int sectionWords = 0;
+            bool all = true;
+            for (const QString &word : queryWords) {
+                if (setting.foldedText.contains(word)) {
+                    ++textWords;
+                } else if (setting.foldedSection.contains(word)) {
+                    ++sectionWords;
+                } else if (!page.foldedPath.contains(word)) {
+                    all = false;
+                    break;
+                }
             }
-            int rank = 5;
-            if (setting.foldedText.startsWith(foldedQuery)) {
-                rank = 2;
-            } else if (containsAll(setting.foldedText + u' ' + setting.foldedSection, queryWords)) {
-                rank = 3;
+            if (!all || textWords + sectionWords == 0) {
+                continue;
             }
-            // Within a rank, the settings that say more of the query themselves come first
-            const QString own = setting.foldedText + u' ' + setting.foldedSection;
-            const int ownWords = std::count_if(queryWords.cbegin(), queryWords.cend(), [&own](const QString &word) {
-                return own.contains(word);
-            });
-            settings.append({rank, -ownWords, {i, SettingResult}, setting.foldedText});
+            const int rank = setting.foldedText.startsWith(foldedQuery) ? 2 : 5;
+            // Within a rank: more words in the text, then in the section, then in the page or category
+            const int order = -(textWords * 100 + sectionWords);
+            settings.append({rank, order, {i, SettingResult}, setting.foldedText});
         }
         std::stable_sort(settings.begin(), settings.end(), [](const Ranked &a, const Ranked &b) {
             if (a.rank != b.rank) {
diff --git a/app/SettingsSearchModel.h b/app/SettingsSearchModel.h
index 318bed1..1ce2aaa 100644
--- a/app/SettingsSearchModel.h
+++ b/app/SettingsSearchModel.h
@@ -27,7 +27,9 @@ struct Entry;
  *
  * Matching ignores case and accents; every word of the query must match somewhere in a result.
  * Results are ranked: exact page name, pages whose name words start with the query words, settings whose text starts
- * with the query, settings with all words in their text or section, other pages, other settings.
+ * with the query, other pages, other settings. A setting matches when every query word is in its text, its section
+ * or the name of its page or category (not the page's keywords), and at least one word is in its text or section.
+ * Settings with more words in their own text come first.
  */
 class SettingsSearchModel : public QAbstractListModel
 {
