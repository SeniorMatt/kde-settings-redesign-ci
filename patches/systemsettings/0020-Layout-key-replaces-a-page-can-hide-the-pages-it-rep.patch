From: Senior Matthew <SeniorMatt@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:30:22 +0500
Subject: [PATCH 20/23] Layout key "replaces": a page can hide the pages it
 replaces (tree and search) while it is installed

kcm_konlineaccounts replaces kcm_kaccounts, so Online Accounts no longer shows twice when both are installed. A replaced page stays when it is alone. settingslayout_p.h regenerated by gen_layout.py. Not built yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X5N5x9eWzmrq6QYrYLwQnk
---
 app/SettingsLayoutTree.cpp |  23 ++++
 app/settingslayout_p.h     | 221 +++++++++++++++++++------------------
 2 files changed, 134 insertions(+), 110 deletions(-)

diff --git a/app/SettingsLayoutTree.cpp b/app/SettingsLayoutTree.cpp
index 55274b5..4fd0817 100644
--- a/app/SettingsLayoutTree.cpp
+++ b/app/SettingsLayoutTree.cpp
@@ -104,6 +104,7 @@ private:
     MenuItem *categoryItem(const QString &id);
     MenuItem *addPage(MenuItem *category, const KPluginMetaData &module, const SettingsLayout::Page *layout, int order);
     KPluginMetaData findModule(const char *id, const char *orApp = nullptr) const;
+    void dropReplacedPages();
     void addListedPages();
     void addTechnicalDetails();
     void addUnlistedPages();
@@ -172,6 +173,27 @@ MenuItem *Builder::addPage(MenuItem *category, const KPluginMetaData &module, co
     return item;
 }
 
+void Builder::dropReplacedPages()
+{
+    // A page that "replaces" others hides them (tree and search) while it is installed; alone, they stay
+    QStringList replaced;
+    auto collect = [this, &replaced](const SettingsLayout::Page &page) {
+        if (!page.replaces || !*page.replaces || !findModule(page.kcm, page.orApp).isValid()) {
+            return;
+        }
+        replaced << QString::fromLatin1(page.replaces).split(u',', Qt::SkipEmptyParts);
+    };
+    for (const auto &category : SettingsLayout::categories) {
+        std::for_each(category.pages, category.pages + category.pageCount, collect);
+    }
+    std::for_each(std::begin(SettingsLayout::detailsPages), std::end(SettingsLayout::detailsPages), collect);
+    for (const QString &id : std::as_const(replaced)) {
+        for (const QString &candidate : idCandidatesFor(id)) {
+            m_modules.remove(candidate);
+        }
+    }
+}
+
 void Builder::addListedPages()
 {
     for (const auto &category : SettingsLayout::categories) {
@@ -312,6 +334,7 @@ MenuItem *Builder::build()
         m_groups.insert(QString::fromLatin1(group.id), item);
     }
 
+    dropReplacedPages();
     addListedPages();
     addTechnicalDetails();
     addUnlistedPages();
