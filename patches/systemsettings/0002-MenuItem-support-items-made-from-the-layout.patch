@@ -167,6 +167,60 @@ public:
 
     void setDefaultIndicator(bool defaultIndicator);
 
+    /**
+     * Turns this item into a category of the System Settings layout (see settingslayout_p.h), which
+     * is not backed by a .desktop file.
+     *
+     * @param id Stable id of the category, e.g. "appearance". Empty for a group (a sidebar section).
+     * @param order Position among its siblings, replaces the X-KDE-Weight sorting.
+     * @param isRoot true for the unnamed group that holds the home page
+     */
+    void setLayoutCategory(const QString &id, const QString &name, const QString &iconName, const QString &comment, int order, bool isRoot = false);
+
+    /**
+     * Replaces the name and description the KCM provides. Empty strings keep the KCM's own.
+     * The KCM's own name stays searchable.
+     */
+    void setNameOverride(const QString &name, const QString &comment);
+
+    /**
+     * Sets the position among the siblings, replacing the X-KDE-Weight of the KCM.
+     */
+    void setOrder(int order);
+
+    /**
+     * Adds search keywords that are not part of the KCM's own metadata.
+     */
+    void addKeywords(const QStringList &keywords);
+
+    /**
+     * The path shown below the name in search results, e.g. "Appearance".
+     */
+    QString breadcrumb() const;
+    void setBreadcrumb(const QString &breadcrumb);
+
+    /**
+     * Items that are hidden from the sidebar can still be found by search and opened.
+     */
+    bool isHiddenInSidebar() const;
+    void setHiddenInSidebar(bool hidden);
+
+    /**
+     * Search never lists this item. Used for the home page.
+     */
+    bool isHiddenInSearch() const;
+    void setHiddenInSearch(bool hidden);
+
+    /**
+     * @return true for categories made by setLayoutCategory() (not groups)
+     */
+    bool isLayoutCategory() const;
+
+    /**
+     * @return the id given to setLayoutCategory()
+     */
+    QString layoutCategoryId() const;
+
     /**
      * If true this is the main module of this category and should appear in a more prominent way compared to the others
      */
