+void MenuItem::setLayoutCategory(const QString &id, const QString &name, const QString &iconName, const QString &comment, int order, bool isRoot)
+{
+    d->layoutCategoryId = id;
+    d->name = name;
+    d->iconName = iconName;
+    d->comment = comment;
+    d->weight = order;
+    d->isSystemsettingsCategory = true;
+    d->isSystemsettingsRootCategory = isRoot;
+}
+
+void MenuItem::setNameOverride(const QString &name, const QString &comment)
+{
+    if (!name.isEmpty() && name != d->name) {
+        d->originalName = d->name;
+        d->name = name;
+    }
+    if (!comment.isEmpty()) {
+        d->comment = comment;
+    }
+}
+
+void MenuItem::setOrder(int order)
+{
+    d->weight = order;
+}
+
+void MenuItem::addKeywords(const QStringList &keywords)
+{
+    d->extraKeywords << keywords;
+}
+
+QString MenuItem::breadcrumb() const
+{
+    return d->breadcrumb;
+}
+
+void MenuItem::setBreadcrumb(const QString &breadcrumb)
+{
+    d->breadcrumb = breadcrumb;
+}
+
+bool MenuItem::isHiddenInSidebar() const
+{
+    return d->hiddenInSidebar;
+}
+
+void MenuItem::setHiddenInSidebar(bool hidden)
+{
+    d->hiddenInSidebar = hidden;
+}
+
+bool MenuItem::isHiddenInSearch() const
+{
+    return d->hiddenInSearch;
+}
+
+void MenuItem::setHiddenInSearch(bool hidden)
+{
+    d->hiddenInSearch = hidden;
+}
+
+bool MenuItem::isLayoutCategory() const
+{
+    return !d->layoutCategoryId.isEmpty();
+}
+
+QString MenuItem::layoutCategoryId() const
+{
+    return d->layoutCategoryId;
+}
+
 KPluginMetaData MenuItem::metaData()
 {
     return d->metaData;
diff --git a/app/MenuItem.h b/app/MenuItem.h
index a3204dc..06e936d 100644
--- a/app/MenuItem.h
