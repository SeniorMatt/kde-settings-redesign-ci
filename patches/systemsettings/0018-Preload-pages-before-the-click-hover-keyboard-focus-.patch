+void SidebarMode::preloadHint(int row, bool search)
+{
+    if (!d->preloader) {
+        return;
+    }
+    MenuItem *target = nullptr;
+    if (search && d->settingsSearch) {
+        target = d->settingsSearch->index(row, 0).data(MenuModel::MenuItemRole).value<MenuItem *>();
+        if (target && !target->isLibrary()) {
+            target = nullptr; // a category result: the click opens its first page, which we do not resolve here
+        }
+    } else if (!search && d->sidebarModel) {
+        target = d->sidebarModel->openTarget(row);
+    }
+    if (target && !target->isLibrary()) {
+        target = nullptr;
+    }
+    d->preloader->hint(target);
+}
+
+void SidebarMode::preloadCancel()
+{
+    if (d->preloader) {
+        d->preloader->cancelHint();
+    }
+}
