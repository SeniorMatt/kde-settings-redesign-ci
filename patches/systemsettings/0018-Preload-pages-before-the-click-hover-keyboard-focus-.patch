diff --git a/app/PagePreloader.cpp b/app/PagePreloader.cpp
new file mode 100644
index 0000000..1b57a2e
--- /dev/null
+++ b/app/PagePreloader.cpp
@@ -0,0 +1,173 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Settings Redesign contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "PagePreloader.h"
+#include "MenuItem.h"
+#include "ModuleView.h"
+#include "settingslayout_p.h"
+
+#include <KPluginMetaData>
+
+#include <QEvent>
+#include <QGuiApplication>
+#include <QLoggingCategory>
+
+#include <cstring>
+
+Q_LOGGING_CATEGORY(PRELOAD, "systemsettings.preload", QtWarningMsg)
+
+// The pointer must rest on a row this long before its page is built (a click follows a hover by ~150-400 ms)
+static constexpr int defaultHoverDelay = 120;
+// Idle preloading: first one this long after the first page, the next ones this far apart, and only after this much calm
+static constexpr int idleStartMs = 2500;
+static constexpr int idleGapMs = 1500;
+static constexpr int calmMs = 700;
+// How many common-task pages are built when idle (they sit in the preload budget until the user hovers something else)
+static constexpr int idleMaxPages = 2;
+
+bool PagePreloader::enabledByEnvironment()
+{
+    bool ok = false;
+    const int v = qEnvironmentVariableIntValue("SYSTEMSETTINGS_PRELOAD", &ok);
+    return !(ok && v == 0);
+}
+
+PagePreloader::PagePreloader(ModuleView *view, MenuItem *root, QObject *parent)
+    : QObject(parent)
+    , m_view(view)
+    , m_root(root)
+{
+    bool ok = false;
+    const int budget = qEnvironmentVariableIntValue("SYSTEMSETTINGS_PRELOAD_BUDGET", &ok);
+    m_view->setPreloadBudget(ok && budget >= 0 ? budget : 3);
+    m_hintTimer.setSingleShot(true);
+    m_idleTimer.setSingleShot(true);
+    connect(&m_hintTimer, &QTimer::timeout, this, &PagePreloader::runHint);
+    connect(&m_idleTimer, &QTimer::timeout, this, &PagePreloader::runIdle);
+    m_lastInput.start();
+    qApp->installEventFilter(this);
+}
+
+int PagePreloader::hoverDelay() const
+{
+    return qEnvironmentVariableIntValue("SYSTEMSETTINGS_PRELOAD_DELAY") > 0 ? qEnvironmentVariableIntValue("SYSTEMSETTINGS_PRELOAD_DELAY") : defaultHoverDelay;
+}
+
+bool PagePreloader::isExcluded(MenuItem *item, bool idle)
+{
+    if (!item || !item->metaData().isValid()) {
+        return true;
+    }
+    const QByteArray id = item->metaData().pluginId().toUtf8();
+    for (const char *never : neverPreload) {
+        if (id == never) {
+            return true;
+        }
+    }
+    if (idle) {
+        for (const char *heavy : neverPreloadWhenIdle) {
+            if (id == heavy) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+bool PagePreloader::userBusy() const
+{
+    return m_lastInput.elapsed() < calmMs;
+}
+
+bool PagePreloader::eventFilter(QObject *watched, QEvent *event)
+{
+    switch (event->type()) {
+    case QEvent::MouseButtonPress:
+    case QEvent::MouseButtonRelease:
+    case QEvent::KeyPress:
+    case QEvent::Wheel:
+    case QEvent::TouchBegin:
+        // The user is acting: whatever waits is probably wrong now
+        m_lastInput.restart();
+        m_hintTimer.stop();
+        m_pending = nullptr;
+        break;
+    default:
+        break;
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void PagePreloader::hint(MenuItem *item)
+{
+    m_pending = item;
+    if (!item || isExcluded(item, false) || m_view->hasPage(item)) {
+        m_hintTimer.stop();
+        m_pending = nullptr;
+        return;
+    }
+    m_hintTimer.start(hoverDelay());
+}
+
+void PagePreloader::cancelHint()
+{
+    m_hintTimer.stop();
+    m_pending = nullptr;
+}
+
+void PagePreloader::runHint()
+{
+    MenuItem *item = std::exchange(m_pending, nullptr);
+    if (!item) {
+        return;
+    }
+    QElapsedTimer t;
+    t.start();
+    if (m_view->preloadModule(item)) {
+        qCInfo(PRELOAD) << "hover preload" << item->metaData().pluginId() << t.elapsed() << "ms";
+    }
+    // The page that was just built counts as activity: the idle chain waits before it goes on
+    m_lastInput.restart();
+}
+
+void PagePreloader::startIdle()
+{
+    if (m_idleStarted || !qEnvironmentVariableIsEmpty("SYSTEMSETTINGS_PRELOAD_NOIDLE")) {
+        return;
+    }
+    m_idleStarted = true;
+    m_idleTimer.start(idleStartMs);
+}
+
+void PagePreloader::runIdle()
+{
+    if (m_idleDone >= idleMaxPages || m_idleCursor >= int(std::size(commonTasks))) {
+        return;
+    }
+    // Wait for a calm moment: the user is using the app, or it is in the background
+    if (userBusy() || m_hintTimer.isActive() || QGuiApplication::applicationState() != Qt::ApplicationActive) {
+        m_idleTimer.start(idleGapMs);
+        return;
+    }
+    // Next common-task target that exists and may be built
+    while (m_idleCursor < int(std::size(commonTasks))) {
+        MenuItem *item = m_root->descendantForModule(QString::fromLatin1(commonTasks[m_idleCursor++].kcm));
+        if (!item || isExcluded(item, true) || m_view->hasPage(item)) {
+            continue;
+        }
+        QElapsedTimer t;
+        t.start();
+        if (m_view->preloadModule(item)) {
+            ++m_idleDone;
+            qCInfo(PRELOAD) << "idle preload" << item->metaData().pluginId() << t.elapsed() << "ms";
+            m_lastInput.restart();
+        }
+        break;
+    }
+    m_idleTimer.start(idleGapMs);
+}
+
+#include "moc_PagePreloader.cpp"
