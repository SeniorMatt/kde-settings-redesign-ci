@@ -0,0 +1,63 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Settings Redesign contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <QElapsedTimer>
+#include <QObject>
+#include <QTimer>
+
+class MenuItem;
+class ModuleView;
+
+/**
+ * @brief Builds pages before the user clicks them, so that the click only has to show a finished page.
+ *
+ * Signals, cheapest first: the pointer rests on a sidebar row, a row gets the keyboard focus, a search result is
+ * highlighted, and (when the app is idle after start) the targets of the common tasks of the Home page.
+ * One page at a time. A page is built in one go on the event loop (loading the plugin cannot be split), but only
+ * after the hint has been stable for hoverDelay and only while the user is not using the mouse or keyboard; any
+ * click or key press cancels what is waiting. The pages go into ModuleView's separate preload budget, so they never
+ * evict visited pages. SYSTEMSETTINGS_PRELOAD=0 turns everything off.
+ */
+class PagePreloader : public QObject
+{
+    Q_OBJECT
+public:
+    PagePreloader(ModuleView *view, MenuItem *root, QObject *parent);
+
+    static bool enabledByEnvironment();
+
+    /** The user points at (or moved the focus to) the page that a click would open. Replaces an earlier hint. */
+    void hint(MenuItem *item);
+    /** The pointer left the row or the list lost the focus. */
+    void cancelHint();
+    /** Starts the idle preloading of the common tasks, once the first page is shown. */
+    void startIdle();
+
+    int hoverDelay() const;
+
+    /** Pages that must not be built ahead, for any signal (see settingslayout_p.h neverPreload) */
+    static bool isExcluded(MenuItem *item, bool idle);
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void runHint();
+    void runIdle();
+    bool userBusy() const;
+
+    ModuleView *const m_view;
+    MenuItem *const m_root;
+    MenuItem *m_pending = nullptr;
+    QTimer m_hintTimer;
+    QTimer m_idleTimer;
+    QElapsedTimer m_lastInput;
+    int m_idleDone = 0;
+    int m_idleCursor = 0;
+    bool m_idleStarted = false;
+};
