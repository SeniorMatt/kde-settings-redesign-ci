+void ModuleView::trimPreloaded()
+{
+    while (d->mPreloaded.size() > d->mPreloadBudget) {
+        KPageWidgetItem *page = d->mPreloaded.takeFirst();
+        if (page == d->mPageWidget->currentPage()) {
+            continue;
+        }
+        d->pageChangeSupressed = true;
+        delete d->mPages.take(page);
+        d->mPagesPluginIdMap.remove(page);
+        d->mPageWidget->removePage(page);
+        d->pageChangeSupressed = false;
+    }
+}
+
+void ModuleView::setPreloadBudget(int size)
+{
+    d->mPreloadBudget = qMax(0, size);
+    trimPreloaded();
+}
+
+int ModuleView::preloadBudget() const
+{
+    return d->mPreloadBudget;
+}
+
+bool ModuleView::hasPage(MenuItem *item) const
+{
+    return item && d->mPagesPluginIdMap.key(item->metaData().pluginId());
+}
+
+bool ModuleView::preloadModule(MenuItem *item)
+{
+    if (!item || d->mPreloadBudget <= 0 || d->mPageCacheSize <= 0 || !d->mPageWidget->currentPage() || !item->isLibrary() || hasPage(item)) {
+        return false;
+    }
+    addModule(item, {}, true);
+    return hasPage(item);
+}
