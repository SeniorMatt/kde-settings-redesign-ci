+MenuItem *SidebarModel::openTarget(int row) const
+{
+    if (row < 0 || row >= m_rows.size()) {
+        return nullptr;
+    }
+    const Row &entry = m_rows.at(row);
+    MenuItem *item = nullptr;
+    if (entry.kind == PageRow) {
+        item = entry.item;
+    } else if (entry.kind == CategoryRow && !isExpanded(entry)) {
+        // Same as openFirstPage(): a click opens the first page of the category
+        const QModelIndex first = m_source->index(0, 0, entry.sourceIndex);
+        item = first.isValid() ? first.data(MenuModel::MenuItemRole).value<MenuItem *>() : nullptr;
+    }
+    return item && item != m_currentItem ? item : nullptr;
+}
