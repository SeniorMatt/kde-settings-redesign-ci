+
+/**
+ * @brief The results of the System Settings search: pages and the settings inside them
+ *
+ * A flat list. Pages are matched by their name and keywords, settings by the text of the control (from the generated
+ * index, see settingsindex_p.h), its section and the page they are on. The text of a setting is translated lazily,
+ * the first time a query is set, with the translation domain of the KCM that owns it.
+ *
+ * Matching ignores case and accents; every word of the query must match somewhere in a result.
+ * Results are ranked: exact page name, pages whose name words start with the query words, settings whose text starts
+ * with the query, other pages, other settings.
+ */
+class SettingsSearchModel : public QAbstractListModel
+{
+    Q_OBJECT
+
+public:
+    enum ResultKind {
+        PageResult,
+        SettingResult,
+    };
+    Q_ENUM(ResultKind)
+
+    enum Roles {
+        ResultKindRole = Qt::UserRole + 100,
+    };
+
+    /**
+     * @param root the root of the MenuItem tree. Only settings of pages in that tree are found.
+     */
+    explicit SettingsSearchModel(MenuItem *root, QObject *parent = nullptr);
+    ~SettingsSearchModel() override;
+
+    QHash<int, QByteArray> roleNames() const override;
+    int rowCount(const QModelIndex &parent = QModelIndex()) const override;
+    QVariant data(const QModelIndex &index, int role) const override;
+
+    void setQuery(const QString &query);
+    QString query() const;
+
+    /**
+     * The page a result belongs to.
+     */
+    MenuItem *itemAt(int row) const;
+
+    ResultKind kindAt(int row) const;
+
+    /**
+     * What the control of a setting result is called, normalised the same way as SettingLocator compares:
+     * translated, without mnemonics, placeholders and the trailing colon. Empty for pages.
+     */
+    QString controlText(int row) const;
+
+    /**
+     * Whether the text of the control contains a value in place of a %1 placeholder, so that only its start can be compared.
+     */
+    bool controlTextHasPlaceholder(int row) const;
+
+    /**
+     * Lower case, without accents. Used for all comparisons.
+     */
+    static QString fold(const QString &text);
+
+    /**
+     * Removes what is not part of the visible text of a translated string: mnemonics, markup, %1 placeholders and a
+     * trailing colon.
+     */
+    static QString visibleText(const QString &translated);
+
+private:
+    struct Page;
+    struct Setting;
+    struct Result {
+        int index; // into m_pages or m_settings
+        ResultKind kind;
+    };
+
+    void collectPages(MenuItem *item);
+    void translateSettings();
+
+    QList<Page> m_pages;
+    QList<Setting> m_settings;
+    QList<Result> m_results;
+    QString m_query;
+    bool m_translated = false;
+};
+
+#endif
