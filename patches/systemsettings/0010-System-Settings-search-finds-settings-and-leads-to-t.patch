+bool SidebarMode::openSearchResult(int row)
+{
+    if (!d->settingsSearch) {
+        return false;
+    }
+    const QModelIndex index = d->settingsSearch->index(row, 0);
+    // Taken before the page is loaded: opening a page must not change what the results say
+    const bool isSetting = d->settingsSearch->kindAt(row) == SettingsSearchModel::SettingResult;
+    const QString text = d->settingsSearch->controlText(row);
+    const bool prefixOnly = d->settingsSearch->controlTextHasPlaceholder(row);
+    if (!loadModule(index)) {
+        return false;
+    }
+    if (isSetting) {
+        d->locator->locate(text, prefixOnly);
+    }
+    return true;
+}
