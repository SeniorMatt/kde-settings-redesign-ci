+/*
+    SPDX-FileCopyrightText: 2026 KDE Contributors
+
+    SPDX-License-Identifier: LGPL-2.0-only
+*/
+
+import QtQuick
+import org.kde.kirigami as Kirigami
+
+// A frame around the control a search result led to. It is created as a child of that control, stays for a moment
+// and fades out.
+Rectangle {
+    id: root
+
+    anchors.fill: parent
+    anchors.margins: -Kirigami.Units.smallSpacing
+    z: 10000
+
+    color: "transparent"
+    border.width: 2
+    border.color: Kirigami.Theme.highlightColor
+    radius: Kirigami.Units.smallSpacing
+
+    Timer {
+        running: true
+        interval: 1500
+        onTriggered: fade.start()
+    }
+
+    // With animations turned off Kirigami.Units.longDuration is 0: the frame just disappears
+    NumberAnimation {
+        id: fade
+        target: root
+        property: "opacity"
+        to: 0
+        duration: Kirigami.Units.longDuration
+        onFinished: root.destroy()
+    }
+}
