+/*
+ * SPDX-FileCopyrightText: 2026 KDE Contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef SETTINGLOCATOR_H
+#define SETTINGLOCATOR_H
+
+#include <QObject>
+#include <QPointer>
+#include <QString>
+#include <QTimer>
+
+class ModuleView;
+class QQuickItem;
+class QWidget;
+
+/**
+ * @brief Finds the control of a setting on the page that is shown, scrolls it into view and highlights it
+ *
+ * Works on any page, no page has to cooperate: it looks for a visible control, label or group with the given text,
+ * in the QtQuick item tree of a QML page or in the widgets of a QtWidgets page. Pages that fill themselves
+ * asynchronously are tried again for about a second.
+ */
+class SettingLocator : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit SettingLocator(ModuleView *view, QObject *parent = nullptr);
+
+    /**
+     * Looks for the control on the page that is shown now.
+     *
+     * @param text what the control says, as returned by SettingsSearchModel::controlText()
+     * @param prefixOnly the control's text has a value after the given text (a %1 placeholder)
+     */
+    void locate(const QString &text, bool prefixOnly);
+
+    /**
+     * Normalises a text the way the controls' texts are compared.
+     */
+    static QString normalised(const QString &text);
+
+private:
+    void attempt();
+    void finish(bool found);
+    bool matches(const QString &candidate) const;
+
+    QQuickItem *findItem(QQuickItem *root) const;
+    QWidget *findWidget(QWidget *root) const;
+    bool tryQuick(QWidget *pageContent);
+    bool tryWidgets(QWidget *pageContent);
+
+    QPointer<ModuleView> m_view;
+    QTimer m_timer;
+    QString m_pluginId;
+    QString m_text;
+    bool m_prefixOnly = false;
+    int m_tries = 0;
+};
+
+#endif
