index 0000000..2a603b0
--- /dev/null
+++ b/app/SettingsSearchModel.cpp
@@ -0,0 +1,353 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "SettingsSearchModel.h"
+
+#include "MenuItem.h"
+#include "MenuModel.h"
+#include "settingsindex_p.h"
+
+#include <KLocalizedString>
+#include <KPluginMetaData>
+
+#include <QChar>
+#include <QHash>
+#include <QRegularExpression>
+#include <QSet>
+
+#include <algorithm>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+// More would only be noise, and the list is meant to be read
+constexpr int maxSettingResults = 50;
+
+QString joinBreadcrumb(const QString &first, const QString &second)
+{
+    return i18ndc("systemsettings", "@item breadcrumb in search results, e.g. Appearance › Colors", "%1 › %2", first, second);
+}
+
+QStringList words(const QString &foldedText)
+{
+    QStringList list;
+    QString current;
+    for (const QChar c : foldedText) {
+        if (c.isLetterOrNumber()) {
+            current += c;
+        } else if (!current.isEmpty()) {
+            list << current;
+            current.clear();
+        }
+    }
+    if (!current.isEmpty()) {
+        list << current;
+    }
+    return list;
+}
+
+bool containsAll(const QString &haystack, const QStringList &needles)
+{
+    return std::all_of(needles.cbegin(), needles.cend(), [&haystack](const QString &needle) {
+        return haystack.contains(needle);
+    });
+}
+
+bool startsEveryWord(const QStringList &tokens, const QStringList &needles)
+{
+    return std::all_of(needles.cbegin(), needles.cend(), [&tokens](const QString &needle) {
+        return std::any_of(tokens.cbegin(), tokens.cend(), [&needle](const QString &token) {
+            return token.startsWith(needle);
+        });
+    });
+}
+}
+
+struct SettingsSearchModel::Page {
+    MenuItem *item;
+    QString name;
+    QString foldedName;
+    QStringList nameWords;
+    QString haystack; // folded name, keywords and breadcrumb
+};
+
+struct SettingsSearchModel::Setting {
+    const SettingsIndex::Entry *entry;
+    int page;
+    QString text; // as shown
+    QString foldedText;
+    QString foldedSection;
+    bool hasPlaceholder = false;
+};
+
+SettingsSearchModel::SettingsSearchModel(MenuItem *root, QObject *parent)
+    : QAbstractListModel(parent)
+{
+    collectPages(root);
+
+    QHash<QString, int> pageForKcm;
+    for (int i = 0; i < m_pages.size(); ++i) {
+        MenuItem *item = m_pages.at(i).item;
+        if (item->isLibrary()) {
+            pageForKcm.insert(item->metaData().pluginId(), i);
+        }
+    }
+    for (const SettingsIndex::Entry &entry : SettingsIndex::entries) {
+        const auto page = pageForKcm.constFind(QString::fromLatin1(entry.kcm));
+        if (page == pageForKcm.cend()) {
+            continue; // the page is not installed or not in the tree
+        }
+        Setting setting;
+        setting.entry = &entry;
+        setting.page = *page;
+        m_settings.append(setting);
+    }
+}
+
+SettingsSearchModel::~SettingsSearchModel() = default;
+
+void SettingsSearchModel::collectPages(MenuItem *item)
+{
+    for (MenuItem *child : std::as_const(item->children())) {
+        if (child->menu()) {
+            collectPages(child);
+            continue;
+        }
+        if (child->isHiddenInSearch()) {
+            continue;
+        }
+        Page page;
+        page.item = child;
+        page.name = child->name();
+        page.foldedName = fold(page.name);
+        page.nameWords = words(page.foldedName);
+        // Hidden but searchable pages count, like the ones that are in the sidebar
+        page.haystack = fold(child->keywords().join(u' ') + u' ' + child->breadcrumb());
+        m_pages.append(page);
+    }
+}
+
+QString SettingsSearchModel::fold(const QString &text)
+{
+    QString decomposed = text.normalized(QString::NormalizationForm_D);
+    decomposed.removeIf([](QChar c) {
+        return c.category() == QChar::Mark_NonSpacing;
+    });
+    return decomposed.toCaseFolded();
+}
+
+QString SettingsSearchModel::visibleText(const QString &translated)
+{
+    static const QRegularExpression markup(u"<[^>]*>|%(?:[0-9]+|n|L[0-9]+)"_s);
+    static const QRegularExpression mnemonic(u"&(?!&)"_s);
+    static const QRegularExpression spaces(u"\\s+"_s);
+    QString text = translated;
+    text.remove(markup);
+    text.remove(mnemonic);
+    text.replace(u"&&"_s, u"&"_s);
+    text.replace(spaces, u" "_s);
+    text = text.trimmed();
+    while (text.endsWith(u':') || text.endsWith(u"："_s)) {
+        text.chop(1);
+        text = text.trimmed();
+    }
+    return text;
+}
+
+void SettingsSearchModel::translateSettings()
+{
+    if (m_translated) {
+        return;
+    }
+    m_translated = true;
+    static const QRegularExpression placeholder(u"%(?:[0-9]+|n|L[0-9]+)"_s);
+    for (Setting &setting : m_settings) {
+        const SettingsIndex::Entry &entry = *setting.entry;
+        // The text is the KCM's own source string: its translation is in the KCM's domain, not ours
+        const QString translated = entry.domain ? i18nd(entry.domain, entry.text) : QString::fromUtf8(entry.text);
+        setting.hasPlaceholder = translated.contains(placeholder);
+        setting.text = visibleText(translated);
+        if (setting.text.isEmpty()) {
+            setting.text = visibleText(QString::fromUtf8(entry.text));
+        }
+        setting.foldedText = fold(setting.text);
+        setting.foldedSection = fold(QString::fromUtf8(entry.section));
+    }
+}
+
+QHash<int, QByteArray> SettingsSearchModel::roleNames() const
+{
+    QHash<int, QByteArray> names = QAbstractListModel::roleNames();
+    names[MenuModel::DepthRole] = "depth";
+    names[MenuModel::IsCategoryRole] = "isCategory";
+    names[MenuModel::IsKCMRole] = "isKCM";
+    names[MenuModel::DefaultIndicatorRole] = "showDefaultIndicator";
+    names[MenuModel::IconNameRole] = "iconName";
+    names[MenuModel::BreadcrumbRole] = "breadcrumb";
+    names[MenuModel::DescriptionRole] = "description";
+    names[ResultKindRole] = "resultKind";
+    return names;
+}
+
+int SettingsSearchModel::rowCount(const QModelIndex &parent) const
+{
+    return parent.isValid() ? 0 : m_results.size();
+}
+
+QVariant SettingsSearchModel::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() >= m_results.size()) {
+        return {};
+    }
+    const Result &result = m_results.at(index.row());
+    MenuItem *item = itemAt(index.row());
+    const bool isSetting = result.kind == SettingResult;
+
+    switch (role) {
+    case Qt::DisplayRole:
+        return isSetting ? m_settings.at(result.index).text : item->name();
+    case MenuModel::MenuItemRole:
+        return QVariant::fromValue(item);
+    case MenuModel::IconNameRole:
+        return item->iconName();
+    case MenuModel::BreadcrumbRole: {
+        if (!isSetting) {
+            return item->breadcrumb();
+        }
+        // Category › Page › Section
+        const QString section = QString::fromUtf8(m_settings.at(result.index).entry->section);
+        const QString path = item->breadcrumb().isEmpty() ? item->name() : joinBreadcrumb(item->breadcrumb(), item->name());
+        return section.isEmpty() ? path : joinBreadcrumb(path, section);
+    }
+    case MenuModel::DescriptionRole:
+        return isSetting ? QString() : item->comment();
+    case MenuModel::DepthRole:
+        return 0;
+    case MenuModel::IsCategoryRole:
+        return false;
+    case MenuModel::IsKCMRole:
+        return true;
+    case MenuModel::DefaultIndicatorRole:
+        return item->showDefaultIndicator();
+    case ResultKindRole:
+        return result.kind;
+    default:
+        return {};
+    }
+}
+
+MenuItem *SettingsSearchModel::itemAt(int row) const
+{
+    if (row < 0 || row >= m_results.size()) {
+        return nullptr;
+    }
+    const Result &result = m_results.at(row);
+    return m_pages.at(result.kind == PageResult ? result.index : m_settings.at(result.index).page).item;
+}
+
+SettingsSearchModel::ResultKind SettingsSearchModel::kindAt(int row) const
+{
+    return row >= 0 && row < m_results.size() ? m_results.at(row).kind : PageResult;
+}
+
+QString SettingsSearchModel::controlText(int row) const
+{
+    if (kindAt(row) != SettingResult) {
+        return {};
+    }
+    return m_settings.at(m_results.at(row).index).text;
+}
+
+bool SettingsSearchModel::controlTextHasPlaceholder(int row) const
+{
+    return kindAt(row) == SettingResult && m_settings.at(m_results.at(row).index).hasPlaceholder;
+}
+
+QString SettingsSearchModel::query() const
+{
+    return m_query;
+}
+
+void SettingsSearchModel::setQuery(const QString &query)
+{
+    if (query == m_query) {
+        return;
+    }
+    m_query = query;
+
+    struct Ranked {
+        int rank;
+        int order; // position among results of the same rank
+        Result result;
+        QString sortKey;
+    };
+    QList<Ranked> ranked;
+
+    const QString foldedQuery = fold(query.simplified());
+    const QStringList queryWords = words(foldedQuery);
+    if (!queryWords.isEmpty()) {
+        translateSettings();
+
+        for (int i = 0; i < m_pages.size(); ++i) {
+            const Page &page = m_pages.at(i);
+            int rank;
+            if (page.foldedName == foldedQuery) {
+                rank = 0;
+            } else if (startsEveryWord(page.nameWords, queryWords)) {
+                rank = 1;
+            } else if (containsAll(page.haystack, queryWords)) {
+                rank = 4;
+            } else {
+                continue;
+            }
+            ranked.append({rank, i, {i, PageResult}, QString()});
+        }
+
+        int settingCount = 0;
+        QList<Ranked> settings;
+        for (int i = 0; i < m_settings.size(); ++i) {
+            const Setting &setting = m_settings.at(i);
+            const Page &page = m_pages.at(setting.page);
+            const QString haystack = setting.foldedText + u' ' + setting.foldedSection + u' ' + page.haystack;
+            if (!containsAll(haystack, queryWords)) {
+                continue;
+            }
+            const int rank = setting.foldedText.startsWith(foldedQuery) ? 2 : 5;
+            settings.append({rank, i, {i, SettingResult}, setting.foldedText});
+        }
+        std::stable_sort(settings.begin(), settings.end(), [](const Ranked &a, const Ranked &b) {
+            return a.rank != b.rank ? a.rank < b.rank : a.sortKey.size() < b.sortKey.size();
+        });
+        // A control with the same text twice on a page (e.g. in two sections) is one result
+        QSet<QPair<int, QString>> seen;
+        for (const Ranked &r : std::as_const(settings)) {
+            if (settingCount >= maxSettingResults) {
+                break;
+            }
+            const Setting &setting = m_settings.at(r.result.index);
+            if (seen.contains({setting.page, setting.foldedText})) {
+                continue;
+            }
+            seen.insert({setting.page, setting.foldedText});
+            ranked.append(r);
+            ++settingCount;
+        }
+        // Pages keep the order of the tree within a rank; settings the order of their length
+        std::stable_sort(ranked.begin(), ranked.end(), [](const Ranked &a, const Ranked &b) {
+            return a.rank < b.rank;
+        });
+    }
+
+    beginResetModel();
+    m_results.clear();
+    for (const Ranked &r : std::as_const(ranked)) {
+        m_results.append(r.result);
+    }
+    endResetModel();
+}
+
