diff --git a/app/SettingLocator.cpp b/app/SettingLocator.cpp
new file mode 100644
index 0000000..040e8a9
--- /dev/null
+++ b/app/SettingLocator.cpp
@@ -0,0 +1,318 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "SettingLocator.h"
+
+#include "ModuleView.h"
+#include "SettingsSearchModel.h"
+#include "systemsettings_app_debug.h"
+
+#include <KPluginMetaData>
+
+#include <QAbstractButton>
+#include <QGroupBox>
+#include <QLabel>
+#include <QPainter>
+#include <QPropertyAnimation>
+#include <QQmlComponent>
+#include <QQmlEngine>
+#include <QQuickItem>
+#include <QQuickWidget>
+#include <QRegularExpression>
+#include <QScrollArea>
+#include <QStyle>
+
+#include <cmath>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+// About one second of frames
+constexpr int retryInterval = 50;
+constexpr int maxTries = 20;
+constexpr int highlightDuration = 1500;
+
+/**
+ * The frame around a control of a QtWidgets page. Fades out after a moment, unless animations are turned off.
+ */
+class WidgetHighlight : public QWidget
+{
+    Q_OBJECT
+    Q_PROPERTY(qreal opacity MEMBER m_opacity)
+
+public:
+    WidgetHighlight(QWidget *target, QWidget *content)
+        : QWidget(content)
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setAttribute(Qt::WA_NoSystemBackground);
+        const int margin = style()->pixelMetric(QStyle::PM_DefaultFrameWidth) + 2;
+        setGeometry(QRect(target->mapTo(content, QPoint(0, 0)), target->size()).adjusted(-margin, -margin, margin, margin));
+        raise();
+        show();
+
+        QTimer::singleShot(highlightDuration, this, [this]() {
+            const int duration = style()->styleHint(QStyle::SH_Widget_Animation_Duration);
+            if (duration <= 0) {
+                deleteLater();
+                return;
+            }
+            auto fade = new QPropertyAnimation(this, "opacity", this);
+            fade->setDuration(duration);
+            fade->setEndValue(0.0);
+            connect(fade, &QPropertyAnimation::valueChanged, this, qOverload<>(&QWidget::update));
+            connect(fade, &QPropertyAnimation::finished, this, &QObject::deleteLater);
+            fade->start();
+        });
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing);
+        painter.setOpacity(m_opacity);
+        QPen pen(palette().color(QPalette::Highlight), 2);
+        painter.setPen(pen);
+        painter.setBrush(Qt::NoBrush);
+        const qreal radius = style()->pixelMetric(QStyle::PM_DefaultFrameWidth) * 2 + 1;
+        painter.drawRoundedRect(QRectF(rect()).adjusted(1, 1, -1, -1), radius, radius);
+    }
+
+private:
+    qreal m_opacity = 1.0;
+};
+
+QString stripMarkup(const QString &text)
+{
+    static const QRegularExpression markup(u"<[^>]*>"_s);
+    return text.contains(u'<') ? QString(text).remove(markup) : text;
+}
+
+QString stringProperty(const QObject *object, const char *name)
+{
+    const QVariant value = object->property(name);
+    return value.metaType().id() == QMetaType::QString ? value.toString() : QString();
+}
+
+/**
+ * Kirigami.FormData.label of an item: an attached object, which is a child of the item
+ */
+QString formDataLabel(const QQuickItem *item)
+{
+    const auto children = item->children();
+    for (const QObject *child : children) {
+        if (QByteArray(child->metaObject()->className()).endsWith("FormLayoutAttached")) {
+            return stringProperty(child, "label");
+        }
+    }
+    return {};
+}
+
+bool isFlickable(const QQuickItem *item)
+{
+    return item->inherits("QQuickFlickable");
+}
+
+void scrollQuickItemIntoView(QQuickItem *item)
+{
+    for (QQuickItem *flick = item->parentItem(); flick; flick = flick->parentItem()) {
+        if (!isFlickable(flick)) {
+            continue;
+        }
+        const qreal viewHeight = flick->height();
+        const qreal contentHeight = flick->property("contentHeight").toReal();
+        if (contentHeight <= viewHeight + 1) {
+            continue; // does not scroll
+        }
+        auto *content = flick->property("contentItem").value<QQuickItem *>();
+        if (!content) {
+            continue;
+        }
+        const qreal top = item->mapToItem(content, QPointF(0, 0)).y();
+        const qreal height = item->height();
+        const qreal contentY = flick->property("contentY").toReal();
+        if (top >= contentY && top + height <= contentY + viewHeight) {
+            continue; // already visible
+        }
+        const qreal originY = flick->property("originY").toReal();
+        const qreal minY = originY - flick->property("topMargin").toReal();
+        const qreal maxY = qMax(minY, originY + contentHeight - viewHeight + flick->property("bottomMargin").toReal());
+        // In the middle of the view when there is room
+        const qreal wanted = top - (viewHeight - height) / 2;
+        flick->setProperty("contentY", qBound(minY, wanted, maxY));
+    }
+}
+
+void highlightQuickItem(QQuickItem *item)
+{
+    QQmlEngine *engine = qmlEngine(item);
+    if (!engine) {
+        return;
+    }
+    QQmlComponent component(engine, QUrl(u"qrc:/qt/qml/org/kde/systemsettings/SettingHighlight.qml"_s));
+    if (component.isError()) {
+        qCWarning(SYSTEMSETTINGS_APP_LOG) << component.errors();
+        return;
+    }
+    // The frame is a child of the control, so it moves with it and is destroyed with it
+    QObject *frame = component.createWithInitialProperties({{u"parent"_s, QVariant::fromValue(item)}});
+    if (!frame) {
+        qCWarning(SYSTEMSETTINGS_APP_LOG) << component.errors();
+    }
+}
+}
+
+SettingLocator::SettingLocator(ModuleView *view, QObject *parent)
+    : QObject(parent)
+    , m_view(view)
+{
+    m_timer.setInterval(retryInterval);
+    connect(&m_timer, &QTimer::timeout, this, &SettingLocator::attempt);
+}
+
+QString SettingLocator::normalised(const QString &text)
+{
+    return SettingsSearchModel::fold(SettingsSearchModel::visibleText(stripMarkup(text)));
+}
+
+void SettingLocator::locate(const QString &text, bool prefixOnly)
+{
+    m_timer.stop();
+    m_text = normalised(text);
+    m_prefixOnly = prefixOnly;
+    m_tries = 0;
+    if (m_text.isEmpty() || !m_view) {
+        return;
+    }
+    m_pluginId = m_view->activeModuleMetadata().pluginId();
+    // The page may not exist yet (it is created while the click is handled) or still be empty
+    QTimer::singleShot(0, this, &SettingLocator::attempt);
+}
+
+bool SettingLocator::matches(const QString &candidate) const
+{
+    if (candidate.isEmpty()) {
+        return false;
+    }
+    const QString text = normalised(candidate);
+    if (text == m_text) {
+        return true;
+    }
+    return m_prefixOnly && m_text.size() >= 3 && text.startsWith(m_text);
+}
+
+void SettingLocator::attempt()
+{
+    if (!m_view || m_view->activeModuleMetadata().pluginId() != m_pluginId) {
+        m_timer.stop();
+        return; // the user went elsewhere
+    }
+    QWidget *content = m_view->currentPageContent();
+    if (content && (tryQuick(content) || tryWidgets(content))) {
+        m_timer.stop();
+        return;
+    }
+    if (++m_tries >= maxTries) {
+        m_timer.stop();
+        qCDebug(SYSTEMSETTINGS_APP_LOG) << "No control with the text" << m_text << "found on" << m_pluginId;
+        return;
+    }
+    m_timer.start();
+}
+
+QQuickItem *SettingLocator::findItem(QQuickItem *item) const
+{
+    if (!item->isVisible()) {
+        return nullptr; // this includes everything below it
+    }
+    if (item->width() > 0 && item->height() > 0) {
+        if (matches(stringProperty(item, "text")) || matches(stringProperty(item, "title")) || matches(stringProperty(item, "label"))
+            || matches(formDataLabel(item))) {
+            return item;
+        }
+    }
+    const auto children = item->childItems();
+    for (QQuickItem *child : children) {
+        if (QQuickItem *found = findItem(child)) {
+            return found;
+        }
+    }
+    return nullptr;
+}
+
+bool SettingLocator::tryQuick(QWidget *content)
+{
+    QList<QQuickWidget *> quickWidgets = content->findChildren<QQuickWidget *>();
+    if (auto self = qobject_cast<QQuickWidget *>(content)) {
+        quickWidgets.prepend(self);
+    }
+    for (QQuickWidget *quickWidget : std::as_const(quickWidgets)) {
+        QQuickItem *root = quickWidget->rootObject();
+        if (!root) {
+            continue;
+        }
+        QQuickItem *item = findItem(root);
+        if (!item) {
+            continue;
+        }
+        scrollQuickItemIntoView(item);
+        highlightQuickItem(item);
+        if (item->activeFocusOnTab()) {
+            quickWidget->setFocus(Qt::OtherFocusReason);
+            item->forceActiveFocus(Qt::OtherFocusReason);
+        }
+        return true;
+    }
+    return false;
+}
+
+QWidget *SettingLocator::findWidget(QWidget *content) const
+{
+    const auto widgets = content->findChildren<QWidget *>();
+    for (QWidget *widget : widgets) {
+        if (!widget->isVisibleTo(content) || widget->width() <= 0 || widget->height() <= 0) {
+            continue;
+        }
+        if (auto label = qobject_cast<QLabel *>(widget)) {
+            if (matches(label->text())) {
+                return label->buddy() ? label->buddy() : label;
+            }
+        } else if (auto button = qobject_cast<QAbstractButton *>(widget)) {
+            if (matches(button->text())) {
+                return button;
+            }
+        } else if (auto group = qobject_cast<QGroupBox *>(widget)) {
+            if (matches(group->title())) {
+                return group;
+            }
+        }
+    }
+    return nullptr;
+}
+
+bool SettingLocator::tryWidgets(QWidget *content)
+{
+    QWidget *target = findWidget(content);
+    if (!target) {
+        return false;
+    }
+    for (QWidget *parent = target->parentWidget(); parent; parent = parent->parentWidget()) {
+        if (auto scrollArea = qobject_cast<QScrollArea *>(parent)) {
+            const int margin = target->fontMetrics().height() * 2;
+            scrollArea->ensureWidgetVisible(target, margin, margin);
+        }
+    }
+    if (target->focusPolicy() != Qt::NoFocus) {
+        target->setFocus(Qt::OtherFocusReason);
+    }
+    new WidgetHighlight(target, content);
+    return true;
+}
+
+#include "SettingLocator.moc"
+#include "moc_SettingLocator.cpp"
