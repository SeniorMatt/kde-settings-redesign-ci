@@ -0,0 +1,39 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Settings Redesign contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <KPluginMetaData>
+
+#include <QList>
+#include <QStringList>
+
+class MenuItem;
+
+/**
+ * Builds the System Settings menu tree from the fixed layout in settingslayout_p.h
+ * instead of the category .desktop files.
+ *
+ * The tree is: root -> groups (sidebar sections) -> categories -> pages. The home page sits in an unnamed group
+ * of its own, before the other groups. Order is the order of the layout, not X-KDE-Weight.
+ */
+namespace SettingsLayoutTree
+{
+
+/**
+ * @param root An empty root item
+ * @param modules All pages found on this system
+ * @param categoryFiles The category .desktop files, used to place pages the layout does not list
+ * @return The home page item, or nullptr if it is not installed
+ */
+MenuItem *build(MenuItem *root, const QList<KPluginMetaData> &modules, const QStringList &categoryFiles);
+
+/**
+ * @return all ids a page may be installed under: @p id itself and the ids it is an alias of or has as an alias
+ */
+QStringList idCandidates(const QString &id);
+
+}
