diff --git a/app/SettingsLayoutTree.cpp b/app/SettingsLayoutTree.cpp
index b0bfa39..55274b5 100644
--- a/app/SettingsLayoutTree.cpp
+++ b/app/SettingsLayoutTree.cpp
@@ -300,6 +300,7 @@ MenuItem *Builder::build()
     if (homeModule.isValid()) {
         home = new MenuItem(false, homeGroup);
