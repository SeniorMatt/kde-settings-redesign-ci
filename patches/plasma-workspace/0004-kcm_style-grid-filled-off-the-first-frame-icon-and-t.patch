 #include <QUrl>
 
 #include <KLocalizedString>
@@ -25,7 +28,8 @@ GtkPage::GtkPage(QObject *parent)
         Q_EMIT gtkThemeSettingsChanged();
     });
 
-    load();
+    // No load() here: KCMStyle::load() calls it right after construction, and the constructor used to scan the theme
+    // directories and block on a D-Bus call a second time before the first frame.
 }
 
 GtkPage::~GtkPage() = default;
@@ -42,7 +46,8 @@ void GtkPage::showGtkPreview()
 
 void GtkPage::onThemeRemoved()
 {
-    load();
+    ++m_loadGeneration; // drop a load() still in flight, defaults() decides the selection now
+    m_gtkThemesModel->load();
     defaults();
     save();
 }
@@ -87,6 +92,7 @@ void GtkPage::save()
     auto call = m_gtkConfigInterface.setGtkTheme(m_gtkThemesModel->selectedTheme());
     // needs to block so "OK" button closing kcmshell still saves properly
     call.waitForFinished();
+    m_loadedTheme = m_gtkThemesModel->selectedTheme();
 }
 
 void GtkPage::defaults()
@@ -96,8 +102,42 @@ void GtkPage::defaults()
 
 void GtkPage::load()
 {
-    m_gtkThemesModel->load();
-    m_gtkThemesModel->setSelectedTheme(m_gtkConfigInterface.gtkTheme());
+    const quint64 generation = ++m_loadGeneration;
+    m_themeReceived = false;
+    m_themesScanned = false;
+
+    // Both parts used to run synchronously, twice, before the first frame: the blocking org.kde.GtkConfig.gtkTheme()
+    // call and the scan of every GTK theme directory. The call is async now and the scan runs one event-loop turn
+    // later; the selection is applied when both are done (the combo box needs the filled model first).
+    auto *watcher = new QDBusPendingCallWatcher(m_gtkConfigInterface.gtkTheme(), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, generation](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<QString> reply = *watcher;
+        watcher->deleteLater();
+        if (generation != m_loadGeneration) {
+            return;
+        }
+        m_receivedTheme = reply.isError() ? QString() : reply.value();
+        m_themeReceived = true;
+        applyLoadedTheme();
+    });
+
+    QTimer::singleShot(0, this, [this, generation] {
+        if (generation != m_loadGeneration) {
+            return;
+        }
+        m_gtkThemesModel->load();
+        m_themesScanned = true;
+        applyLoadedTheme();
+    });
+}
+
+void GtkPage::applyLoadedTheme()
+{
+    if (!m_themeReceived || !m_themesScanned) {
+        return;
+    }
+    m_loadedTheme = m_receivedTheme; // before setSelectedTheme(): that signal makes KCMStyle ask isSaveNeeded()
+    m_gtkThemesModel->setSelectedTheme(m_receivedTheme);
 }
 
 bool GtkPage::isDefaults() const
@@ -105,9 +145,9 @@ bool GtkPage::isDefaults() const
     return m_gtkThemesModel->selectedTheme() == QLatin1String("Breeze");
 }
 
-bool GtkPage::isSaveNeeded()
+bool GtkPage::isSaveNeeded() const
 {
-    return m_gtkThemesModel->selectedTheme() != m_gtkConfigInterface.gtkTheme();
+    return m_gtkThemesModel->selectedTheme() != m_loadedTheme;
 }
 
