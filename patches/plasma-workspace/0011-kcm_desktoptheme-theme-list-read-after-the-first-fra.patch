+    bool m_loaded = false;
+    int m_loadGeneration = 0;
+
     void installTheme(const QString &path);
 
     DesktopThemeData *const m_data;
diff --git a/kcms/desktoptheme/ui/main.qml b/kcms/desktoptheme/ui/main.qml
