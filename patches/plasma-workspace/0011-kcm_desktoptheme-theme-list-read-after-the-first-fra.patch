+        visible: kcm.loaded && root.view.count === 0
+        icon.name: "preferences-desktop-theme"
+        text: searchField.text.length > 0 || filterCombo.currentIndex !== 0
+            ? i18nc("@info", "No Plasma styles match")
+            : i18nc("@info", "No Plasma styles found")
+    }
 
     Binding {
         target: kcm.filteredModel
@@ -94,6 +117,7 @@ KCM.GridViewKCM {
                 Layout.fillWidth: true
             }
 
