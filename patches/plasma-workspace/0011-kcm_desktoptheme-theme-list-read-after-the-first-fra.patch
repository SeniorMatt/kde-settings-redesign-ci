 kcms/desktoptheme/kcm.cpp     | 21 +++++++++++++++--
 kcms/desktoptheme/kcm.h       | 11 +++++++++
 kcms/desktoptheme/ui/main.qml | 44 +++++++++++++++++++++++++++++++----
 3 files changed, 69 insertions(+), 7 deletions(-)

diff --git a/kcms/desktoptheme/kcm.cpp b/kcms/desktoptheme/kcm.cpp
index 7b2ea73..b4df4de 100644
--- a/kcms/desktoptheme/kcm.cpp
+++ b/kcms/desktoptheme/kcm.cpp
@@ -30,6 +30,7 @@
 #include <QStandardItemModel>
 #include <QStandardPaths>
 #include <QTemporaryFile>
+#include <QTimer>
 #include <algorithm>
 
 #include "desktopthemedata.h"
@@ -184,8 +185,24 @@ void KCMDesktopTheme::applyPlasmaTheme(QQuickItem *item, const QString &themeNam
 void KCMDesktopTheme::load()
 {
     KQuickManagedConfigModule::load();
-    m_model->load();
-    m_model->setSelectedTheme(desktopThemeSettings()->name());
+
+    // ksr: ThemesModel::load() lists every plasma/desktoptheme dir, parses each metadata file and builds a KColorScheme palette
+    // per theme with its own colors file. It runs one event-loop turn later so the page is on screen first; a newer load() makes
+    // an older pending one a no-op.
+    if (m_loaded) {
+        m_loaded = false;
+        Q_EMIT loadedChanged();
+    }
+    const int generation = ++m_loadGeneration;
+    QTimer::singleShot(0, this, [this, generation] {
+        if (generation != m_loadGeneration) {
+            return;
+        }
+        m_model->load();
+        m_model->setSelectedTheme(desktopThemeSettings()->name());
+        m_loaded = true;
+        Q_EMIT loadedChanged();
+    });
 }
 
 void KCMDesktopTheme::save()
