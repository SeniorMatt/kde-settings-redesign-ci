diff --git a/kcms/componentchooser/ui/ComponentComboBox.qml b/kcms/componentchooser/ui/ComponentComboBox.qml
index cf3d232..6422e76 100644
--- a/kcms/componentchooser/ui/ComponentComboBox.qml
