--- a/kcms/feedback/feedback.cpp
+++ b/kcms/feedback/feedback.cpp
@@ -17,6 +17,7 @@
 #include <QFileInfo>
 #include <QList>
 #include <QProcess>
+#include <QTimer>
 
 #include <KUserFeedback/FeedbackConfigUiController>
 #include <KUserFeedback/Provider>
@@ -52,14 +53,49 @@ Feedback::Feedback(QObject *parent, const KPluginMetaData &data)
 {
     qmlRegisterAnonymousType<FeedbackSettings>("org.kde.userfeedback.kcm", 1);
 
-    for (const auto &[program, _] : s_programs.asKeyValueRange()) {
-        auto p = new QProcess(this);
-        p->setProgram(program);
-        p->setArguments({QStringLiteral("--feedback")});
-        p->start();
-        connect(p, &QProcess::finished, this, &Feedback::programFinished);
-        // deleted by finished slot
+    // Before: both "plasmashell --feedback" and "plasma-discover --feedback" (two heavy binaries) were started here, in
+    // the constructor, at the same time as the page was created. Now they are started one after the other, shortly
+    // after the page is shown (the list of sent data is below the slider and fills in when they finish).
+    m_pendingPrograms = s_programs.keys();
+    m_pendingPrograms.sort(); // stable order
+    m_sourcesLoading = !m_pendingPrograms.isEmpty();
+    QTimer::singleShot(250, this, &Feedback::startNextProgram);
+}
+
+bool Feedback::sourcesLoading() const
+{
+    return m_sourcesLoading;
+}
+
+void Feedback::startNextProgram()
+{
+    if (m_pendingPrograms.isEmpty()) {
+        return;
     }
+    const QString program = m_pendingPrograms.takeFirst();
+    auto p = new QProcess(this);
+    p->setProgram(program);
+    p->setArguments({QStringLiteral("--feedback")});
+    connect(p, &QProcess::finished, this, &Feedback::programFinished);
+    // If the binary is not installed the process never starts: go on with the next one
+    connect(p, &QProcess::errorOccurred, this, [this, p](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart) {
+            p->deleteLater();
+            finishProgram();
+        }
+    });
+    p->start();
+    // deleted by finished slot
+}
+
+void Feedback::finishProgram()
+{
+    if (!m_pendingPrograms.isEmpty()) {
+        startNextProgram();
+        return;
+    }
+    m_sourcesLoading = false;
+    Q_EMIT sourcesLoadingChanged();
 }
 
 void Feedback::programFinished(int exitCode)
@@ -72,6 +108,8 @@ void Feedback::programFinished(int exitCode)
 
     if (exitCode) {
         qCWarning(KCM_FEEDBACK_DEBUG) << "Could not check" << program;
+        p->deleteLater();
+        finishProgram();
         return;
     }
 
@@ -108,12 +146,17 @@ void Feedback::programFinished(int exitCode)
         return modeL < modeR || (modeL == modeR && objL[u"description"].toString() < objR[u"description"].toString());
     });
     Q_EMIT feedbackSourcesChanged();
+    finishProgram();
 }
 
 bool Feedback::feedbackEnabled() const
 {
-    KUserFeedback::Provider p;
-    return p.isEnabled();
+    // Read once (the Provider reads its settings each time it is created)
+    if (m_feedbackEnabled < 0) {
+        KUserFeedback::Provider p;
+        m_feedbackEnabled = p.isEnabled() ? 1 : 0;
+    }
+    return m_feedbackEnabled == 1;
 }
 
