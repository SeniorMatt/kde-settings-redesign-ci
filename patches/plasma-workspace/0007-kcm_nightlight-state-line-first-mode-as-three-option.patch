     property bool defaultRequested: false
 
+    // Page first (docs/page-design.md section 7): the schedule provider and the preview are created one event-loop turn
+    // after the first frame.
+    property bool detailsAllowed: false
+    Timer {
+        interval: 0
+        running: true
+        onTriggered: root.detailsAllowed = true
+    }
+
+    Loader {
+        id: timingsLoader
+        active: root.detailsAllowed
+        sourceComponent: Private.DayNightTimings {
+            dateTime: new Date()
+        }
+    }
+    readonly property var timings: timingsLoader.item
+
+    function timeText(date: date): string {
+        return date.toLocaleTimeString(Qt.locale(), Locale.ShortFormat);
+    }
+
+    // What Night Light is doing now. "Night" is when the next transition is the morning one.
+    readonly property string stateText: {
+        if (!kcm.nightLightSettings.active) {
+            return i18nc("@info:status", "Night Light is off.");
+        }
+        if (kcm.nightLightSettings.mode === Private.NightLightMode.Constant) {
+            return i18nc("@info:status", "Night Light is always on.");
+        }
+        const t = root.timings;
+        if (!t || isNaN(t.morningStart.getTime()) || isNaN(t.eveningStart.getTime())) {
+            return "";
+        }
+        if (t.morningStart.getTime() > t.eveningStart.getTime()) {
+            return i18nc("@info:status Placeholder is for time", "Night Light is on until %1.", root.timeText(t.morningStart));
+        }
+        return i18nc("@info:status Placeholder is for time", "Night Light turns on at %1.", root.timeText(t.eveningStart));
+    }
