 }
 
+void ColorsModel::load()
+{
+    // A synchronous load (install, edit) wins over a running background load
+    m_pendingFiles.clear();
+    m_building.clear();
+    setLoading(false);
+
+    QList<ColorsModelData> data;
+    const QStringList schemeFiles = findSchemeFiles();
+    for (const QString &schemeFile : schemeFiles) {
+        data.append(readScheme(schemeFile));
+    }
+    replaceData(std::move(data));
+    setLoaded();
+}
+
+void ColorsModel::loadAsync()
+{
+    // The cheap part (directory listing) now, the expensive part (a palette per file) in ~8 ms slices.
+    m_pendingFiles = findSchemeFiles();
+    m_pendingIndex = 0;
+    m_building.clear();
+    if (!m_loading) {
+        setLoading(true);
+        QTimer::singleShot(0, this, &ColorsModel::loadNextBatch);
+    }
+}
+
+void ColorsModel::loadNextBatch()
+{
+    if (!m_loading) {
+        return; // a synchronous load() finished first
+    }
+
+    QElapsedTimer timer;
+    timer.start();
+    while (m_pendingIndex < m_pendingFiles.size() && timer.elapsed() < 8) {
+        m_building.append(readScheme(m_pendingFiles.at(m_pendingIndex++)));
+    }
+
+    if (m_pendingIndex < m_pendingFiles.size()) {
+        QTimer::singleShot(0, this, &ColorsModel::loadNextBatch);
+        return;
+    }
+
+    m_pendingFiles.clear();
+    m_pendingIndex = 0;
+    // The old list (if any) stays until the new one is complete, then it is swapped in one reset
+    replaceData(std::move(m_building));
+    m_building.clear();
+    setLoading(false);
+    setLoaded();
+    Q_EMIT loadFinished();
+}
+
+bool ColorsModel::isLoading() const
+{
+    return m_loading;
+}
+
+bool ColorsModel::isLoaded() const
+{
+    return m_loaded;
+}
+
+void ColorsModel::setLoading(bool loading)
+{
+    if (m_loading != loading) {
+        m_loading = loading;
+        Q_EMIT loadingChanged();
+    }
+}
+
+void ColorsModel::setLoaded()
+{
+    if (!m_loaded) {
+        m_loaded = true;
+        Q_EMIT loadedChanged();
+    }
+}
+
 QStringList ColorsModel::pendingDeletions() const
 {
     QStringList pendingDeletions;
