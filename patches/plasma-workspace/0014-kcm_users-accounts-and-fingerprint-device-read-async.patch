+void User::setPathAsync(const QDBusObjectPath &path)
+{
+    if (!m_dbusIface.isNull()) {
+        delete m_dbusIface;
+    }
+    m_dbusIface = new OrgFreedesktopAccountsUserInterface(QStringLiteral("org.freedesktop.Accounts"), path.path(), QDBusConnection::systemBus(), this);
+    m_dbusIface->setInteractiveAuthorizationAllowed(true);
+
+    // ksr: setPath() read about a dozen properties one blocking call at a time (systemAccount, then each of uid, userName,
+    // iconFile, realName, email, accountType twice, in loadData()), per user, before the page existed. One asynchronous GetAll instead.
+    auto *properties = new OrgFreedesktopDBusPropertiesInterface(QStringLiteral("org.freedesktop.Accounts"), path.path(), QDBusConnection::systemBus(), this);
+    auto *watcher = new QDBusPendingCallWatcher(properties->GetAll(QStringLiteral("org.freedesktop.Accounts.User")), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, path, properties](QDBusPendingCallWatcher *self) {
+        self->deleteLater();
+        properties->deleteLater();
+        QDBusPendingReply<QVariantMap> reply = *self;
+        if (!reply.isError()) {
+            const QVariantMap map = reply.value();
+            if (map.value(QStringLiteral("SystemAccount")).toBool()) {
+                mSystemAccount = true;
+            } else {
+                mPath = path;
+                connect(m_dbusIface, &OrgFreedesktopAccountsUserInterface::Changed, this, [this]() {
+                    loadData();
+                });
+                Properties p;
+                p.uid = map.value(QStringLiteral("Uid")).toULongLong();
+                p.name = map.value(QStringLiteral("UserName")).toString();
+                p.iconFile = map.value(QStringLiteral("IconFile")).toString();
+                p.realName = map.value(QStringLiteral("RealName")).toString();
+                p.email = map.value(QStringLiteral("Email")).toString();
+                p.accountType = map.value(QStringLiteral("AccountType")).toInt();
+                applyProperties(p);
+            }
+        } else {
+            qCWarning(KCMUSERS) << reply.error().message();
+        }
+        Q_EMIT ready();
+    });
+}
+
+bool User::isSystemAccount() const
+{
+    return mSystemAccount;
+}
+
 void User::loadData()
+{
+    Properties p;
+    p.uid = m_dbusIface->uid();
+    p.name = m_dbusIface->userName();
+    p.iconFile = m_dbusIface->iconFile();
+    p.realName = m_dbusIface->realName();
+    p.email = m_dbusIface->email();
+    p.accountType = m_dbusIface->accountType();
+    applyProperties(p);
+}
