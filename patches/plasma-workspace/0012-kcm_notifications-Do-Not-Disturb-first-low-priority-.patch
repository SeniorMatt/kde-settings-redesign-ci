 4 files changed, 91 insertions(+), 39 deletions(-)

diff --git a/kcms/notifications/kcm.cpp b/kcms/notifications/kcm.cpp
index 41c63ae..9554862 100644
--- a/kcms/notifications/kcm.cpp
+++ b/kcms/notifications/kcm.cpp
@@ -13,6 +13,7 @@
 #include <QFile>
 #include <QFileInfo>
 #include <QStandardPaths>
+#include <QTimer>
 
 #include <KConfigGroup>
 #include <KGlobalAccel>
@@ -172,6 +173,24 @@ void KCMNotifications::load()
 {
     KQuickManagedConfigModule::load();
 
+    // ksr: everything below the main page's own settings is deferred by one event-loop turn: the notifyrc scan and the
+    // KApplicationTrader query (SourcesModel::load), one KConfig-backed BehaviorSettings per application/service, every
+    // notifyrc event (loadEvents) and the blocking KGlobalAccel shortcut lookup. The main page is shown first; a newer
+    // load() makes an older pending one a no-op.
+    if (m_sourcesLoaded) {
+        m_sourcesLoaded = false;
+        Q_EMIT sourcesLoadedChanged();
+    }
+    const int generation = ++m_loadGeneration;
+    QTimer::singleShot(0, this, [this, generation] {
+        if (generation == m_loadGeneration) {
+            loadSources();
+        }
+    });
+}
+
+void KCMNotifications::loadSources()
+{
     bool firstLoad = m_firstLoad;
     if (m_firstLoad) {
         m_firstLoad = false;
@@ -213,6 +232,9 @@ void KCMNotifications::load()
 
     m_toggleDoNotDisturbShortcutDirty = false;
 
+    m_sourcesLoaded = true;
+    Q_EMIT sourcesLoadedChanged();
+
     if (firstLoad) {
         Q_EMIT navigateToComponent(m_initialDesktopEntry, m_initialNotifyRcName, m_initialEventId);
     }
