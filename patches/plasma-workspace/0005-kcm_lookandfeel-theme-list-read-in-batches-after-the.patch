 {
     return m_data->settings();
@@ -430,20 +417,58 @@ LookAndFeelSettings *KCMLookandFeel::settings() const
 
 void KCMLookandFeel::loadModel()
 {
+    // Before: the constructor loaded EVERY Plasma/LookAndFeel package twice (listPackages, then loadPackage for each),
+    // and read its defaults and layouts (packageContents) before the page could be created. Now the list of packages is
+    // read after the first frame and the model is filled in short batches, so the UI stays responsive and the cards
+    // appear as they are read.
     m_model->clear();
 
-    QList<KPackage::Package> pkgs = availablePackages({u"defaults"_s, u"layouts"_s});
+    m_pendingPackages = KPackage::PackageLoader::self()->listPackages(QStringLiteral("Plasma/LookAndFeel"));
+    m_pendingIndex = 0;
 
-    // Sort case-insensitively
+    // Sort case-insensitively (same order as before: by the package name)
     QCollator collator;
     collator.setCaseSensitivity(Qt::CaseInsensitive);
-    std::ranges::sort(pkgs, [&collator](const KPackage::Package &a, const KPackage::Package &b) {
-        return collator.compare(a.metadata().name(), b.metadata().name()) < 0;
+    std::ranges::sort(m_pendingPackages, [&collator](const KPluginMetaData &a, const KPluginMetaData &b) {
+        return collator.compare(a.name(), b.name()) < 0;
     });
 
-    for (const KPackage::Package &pkg : pkgs) {
-        addKPackageToModel(pkg);
+    if (!m_modelLoading) {
+        m_modelLoading = true;
+        Q_EMIT modelLoadingChanged();
+    }
+    loadNextBatch();
+}
+
+void KCMLookandFeel::loadNextBatch()
+{
+    QElapsedTimer timer;
+    timer.start();
+
+    // About 8 ms per batch, then yield to the event loop so frames and input are handled
+    while (m_pendingIndex < m_pendingPackages.size() && timer.elapsed() < 8) {
+        const KPluginMetaData &metadata = m_pendingPackages.at(m_pendingIndex++);
+        KPackage::Package pkg = KPackage::PackageLoader::self()->loadPackage(QStringLiteral("Plasma/LookAndFeel"), metadata.pluginId());
+        // List only packages which provide at least one of the components
+        if (!pkg.filePath("defaults").isEmpty() || !pkg.filePath("layouts").isEmpty()) {
+            addKPackageToModel(pkg);
+        }
+    }
+
+    if (m_pendingIndex < m_pendingPackages.size()) {
+        QTimer::singleShot(0, this, &KCMLookandFeel::loadNextBatch);
+        return;
     }
+
+    m_pendingPackages.clear();
+    m_pendingIndex = 0;
+    m_modelLoading = false;
+    Q_EMIT modelLoadingChanged();
+}
+
+bool KCMLookandFeel::isModelLoading() const
+{
+    return m_modelLoading;
 }
 
 void KCMLookandFeel::addKPackageToModel(const KPackage::Package &pkg)
