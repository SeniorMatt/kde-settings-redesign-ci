@@ -65,6 +67,8 @@ CursorThemeConfig::CursorThemeConfig(QObject *parent, const KPluginMetaData &dat
         setCanInstall(false);
     }
 
+    QTimer::singleShot(0, this, &CursorThemeConfig::loadThemes);
+
     connect(m_themeModel, &QAbstractItemModel::dataChanged, this, &CursorThemeConfig::settingsChanged);
     connect(m_themeModel, &QAbstractItemModel::dataChanged, this, [this](const QModelIndex &start, const QModelIndex &end, const QList<int> &roles) {
         const QModelIndex currentThemeIndex = m_themeModel->findIndex(cursorThemeSettings()->cursorTheme());
@@ -111,6 +115,31 @@ bool CursorThemeConfig::canInstall() const
     return m_canInstall;
 }
 
+bool CursorThemeConfig::themesLoaded() const
+{
+    return m_themesLoaded;
+}
+
+void CursorThemeConfig::loadThemes()
+{
+    if (m_themesLoaded) {
+        return;
+    }
+    // No re-sorting per inserted row; one sort when the scan is done
+    m_themeProxyModel->setDynamicSortFilter(false);
+    m_themeModel->load();
+    m_themeProxyModel->setDynamicSortFilter(true);
+    m_themesLoaded = true;
+
+    // The size list needs the selected theme; the same call load() makes. It must not mark the page as changed.
+    const bool hadChanges = needsSave();
+    updateSizeComboBox();
+    if (!hadChanges) {
+        setNeedsSave(false);
+    }
+    Q_EMIT themesLoadedChanged();
+}
+
 void CursorThemeConfig::setCanResize(bool can)
 {
     if (m_canResize == can) {
