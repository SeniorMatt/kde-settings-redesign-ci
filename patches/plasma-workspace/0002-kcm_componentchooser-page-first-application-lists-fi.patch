--- a/kcms/componentchooser/kcm_componentchooser.cpp
+++ b/kcms/componentchooser/kcm_componentchooser.cpp
@@ -10,6 +10,7 @@
 #include <QApplication>
 #include <QDBusConnection>
 #include <QDBusMessage>
+#include <QTimer>
 
 #include <KBuildSycocaProgressDialog>
 #include <KLocalizedString>
@@ -150,19 +151,58 @@ void KcmComponentChooser::defaults()
 
 void KcmComponentChooser::load()
 {
-    m_browsers->load();
-    m_calendar->load();
-    m_fileManagers->load();
-    m_terminalEmulators->load();
-    m_emailClients->load();
-    m_geoUriHandlers->load();
-    m_telUriHandlers->load();
-    m_textEditors->load();
-    m_imageViewers->load();
-    m_musicPlayers->load();
-    m_videoPlayers->load();
-    m_pdfViewers->load();
-    m_archiveManagers->load();
+    // Each ComponentChooser::load() queries every installed application (KApplicationTrader::query) and checks its mime types, and
+    // the page used to do this 13 times in a row before showing anything. Now the page shows first and the lists are filled
+    // one per event loop turn, in the order they appear on the page, so the window can repaint in between.
+    const bool running = !m_pendingLoads.isEmpty();
+    m_pendingLoads = {m_browsers,
+                      m_emailClients,
+                      m_calendar,
+                      m_telUriHandlers,
+                      m_imageViewers,
+                      m_musicPlayers,
+                      m_videoPlayers,
+                      m_textEditors,
+                      m_pdfViewers,
+                      m_fileManagers,
+                      m_terminalEmulators,
+                      m_archiveManagers,
+                      m_geoUriHandlers};
+    setLoading(true);
+    if (!running) {
+        QTimer::singleShot(0, this, &KcmComponentChooser::loadNext);
+    }
+}
+
+void KcmComponentChooser::loadNext()
+{
+    if (m_pendingLoads.isEmpty()) {
+        setLoading(false);
+        return;
+    }
+
+    ComponentChooser *chooser = m_pendingLoads.takeFirst();
+    chooser->load();
+    chooser->setLoaded(true);
+
+    if (m_pendingLoads.isEmpty()) {
+        setLoading(false);
+    } else {
+        QTimer::singleShot(0, this, &KcmComponentChooser::loadNext);
+    }
+}
+
+bool KcmComponentChooser::loading() const
+{
+    return m_loading;
+}
+
+void KcmComponentChooser::setLoading(bool loading)
+{
+    if (m_loading != loading) {
+        m_loading = loading;
+        Q_EMIT loadingChanged();
+    }
 }
 
 void KcmComponentChooser::save()
