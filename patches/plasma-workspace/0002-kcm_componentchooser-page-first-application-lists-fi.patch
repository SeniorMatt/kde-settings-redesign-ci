+bool ComponentChooser::loaded() const
+{
+    return m_loaded;
+}
+
+void ComponentChooser::setLoaded(bool loaded)
+{
+    if (m_loaded == loaded) {
+        return;
+    }
+    m_loaded = loaded;
+    Q_EMIT loadedChanged();
+    // the file type warnings are only computed once loaded, see unsupportedMimeTypes()
+    Q_EMIT modelChanged();
