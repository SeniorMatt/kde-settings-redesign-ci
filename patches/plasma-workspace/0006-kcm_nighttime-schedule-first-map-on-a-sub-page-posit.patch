index 0000000..198be26
--- /dev/null
+++ b/kcms/nighttime/ui/MapPage.qml
@@ -0,0 +1,45 @@
+/*
+    SPDX-FileCopyrightText: 2025 Vlad Zahorodnii <vlad.zahorodnii@kde.org>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+
+// Sub-page of the Day-Night Cycle page: pick the location on a world map. Built only when "Choose on Map…" is pressed.
+KCM.SimpleKCM {
+    id: page
+
+    // The position service of the main page (may be null while it is not running).
+    property var positionSource: null
+
+    title: i18nc("@title", "Choose Location")
+
+    WorldMap {
+        id: map
+        width: parent.width
+        latitude: {
+            if (kcm.settings.automaticLocation) {
+                return page.positionSource ? page.positionSource.position.coordinate.latitude : 0;
+            } else {
+                return kcm.settings.manualLatitude;
+            }
+        }
+        longitude: {
+            if (kcm.settings.automaticLocation) {
+                return page.positionSource ? page.positionSource.position.coordinate.longitude : 0;
+            } else {
+                return kcm.settings.manualLongitude;
+            }
+        }
+        onAccepted: (latitude, longitude) => {
+            kcm.settings.manualLatitude = latitude;
+            kcm.settings.manualLongitude = longitude;
+            kcm.settings.automaticLocation = false;
+        }
+    }
+}
