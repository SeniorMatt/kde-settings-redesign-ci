diff --git a/kcm/kcm.cpp b/kcm/kcm.cpp
index 6a14dbc..f77c7e6 100644
--- a/kcm/kcm.cpp
+++ b/kcm/kcm.cpp
@@ -18,6 +18,7 @@ SPDX-License-Identifier: GPL-2.0-or-later
 #include <KPluginFactory>
 
 #include <QList>
+#include <QTimer>
 
 K_PLUGIN_FACTORY_WITH_JSON(ScreenLockerKcmFactory, "kcm_screenlocker.json", registerPlugin<ScreenLockerKcm>(); registerPlugin<KScreenLockerData>();)
 
@@ -49,10 +50,20 @@ ScreenLockerKcm::ScreenLockerKcm(QObject *parent, const KPluginMetaData &data)
 void ScreenLockerKcm::load()
 {
     KQuickManagedConfigModule::load();
-    m_appearanceSettings->load();
 
-    updateState();
-    Q_EMIT loadCalled();
+    // The appearance part (KPackage lookup of the shell, config.xml of the lock screen and of the wallpaper plugin,
+    // KConfigLoader and QML-facing property maps) is only needed by the Appearance sub-page. It used to run here,
+    // before the first frame; run it one event-loop turn later. The AppearanceSettings getters and save() check for
+    // null, so nothing breaks while it is pending.
+    const quint64 generation = ++m_loadGeneration;
+    QTimer::singleShot(0, this, [this, generation] {
+        if (generation != m_loadGeneration) {
+            return;
+        }
+        m_appearanceSettings->load();
+        updateState();
+        Q_EMIT loadCalled();
+    });
 }
 
 void ScreenLockerKcm::save()
