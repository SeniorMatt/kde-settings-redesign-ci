diff --git a/settings/kscreensaversettings.cpp b/settings/kscreensaversettings.cpp
index 343fef9..227c772 100644
--- a/settings/kscreensaversettings.cpp
+++ b/settings/kscreensaversettings.cpp
@@ -78,16 +78,6 @@ KScreenSaverSettings::KScreenSaverSettings(QObject *parent)
 {
     setParent(parent);
 
-    const auto wallpaperPackages = KPackage::PackageLoader::self()->listPackages(QStringLiteral("Plasma/Wallpaper"));
-    for (auto &package : wallpaperPackages) {
-        m_availableWallpaperPlugins.append({package.name(), package.pluginId()});
-    }
-    QCollator collator;
-    collator.setCaseSensitivity(Qt::CaseInsensitive);
-    std::sort(m_availableWallpaperPlugins.begin(), m_availableWallpaperPlugins.end(), [](const WallpaperInfo &w1, const WallpaperInfo &w2) {
-        return w1.name < w2.name;
-    });
-
     auto shortcutItem = new KPropertySkeletonItem(m_store, "shortcut", defaultShortcuts().first());
     addItem(shortcutItem, QStringLiteral("shortcut"));
     shortcutItem->setNotifyFunction([this] {
@@ -101,6 +91,18 @@ KScreenSaverSettings::~KScreenSaverSettings()
 
 QList<WallpaperInfo> KScreenSaverSettings::availableWallpaperPlugins() const
 {
+    // Scanned on first use (only the Appearance sub-page asks), not in the constructor: the KPackage scan of every
+    // Plasma/Wallpaper package used to run before the first frame, although the main page never shows the list.
+    if (!m_wallpaperPluginsScanned) {
+        m_wallpaperPluginsScanned = true;
+        const auto wallpaperPackages = KPackage::PackageLoader::self()->listPackages(QStringLiteral("Plasma/Wallpaper"));
+        for (auto &package : wallpaperPackages) {
+            m_availableWallpaperPlugins.append({package.name(), package.pluginId()});
+        }
+        std::sort(m_availableWallpaperPlugins.begin(), m_availableWallpaperPlugins.end(), [](const WallpaperInfo &w1, const WallpaperInfo &w2) {
+            return w1.name < w2.name;
+        });
+    }
     return m_availableWallpaperPlugins;
 }
 
