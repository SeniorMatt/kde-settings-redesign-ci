+// ---- measurement-only benchmark (not part of the redesign) ----
+// For each page: sync = time the click blocks the UI, frame = first frame of the page's QQuickWidget (widget pages:
+// first paint), ready = start of the first quiet stretch (3 ticks of a 1 ms precise timer, each < 8 ms apart) after
+// the frame, i.e. when the app answers input again. Rows: round, kcm, kind, sync_ms, frame_ms, ready_ms.
+void SidebarMode::ksrBench()
+{
+    const QStringList ids = qEnvironmentVariable("KSR_BENCH").split(u',', Qt::SkipEmptyParts);
+    const int rounds = qMax(1, qEnvironmentVariableIntValue("KSR_BENCH_ROUNDS"));
+    const QString outPath = qEnvironmentVariable("KSR_BENCH_OUT", QStringLiteral("/tmp/ksr-bench.tsv"));
+    auto out = std::make_shared<QFile>(outPath);
+    if (!out->open(QIODevice::WriteOnly | QIODevice::Text)) {
+        qWarning() << "ksr-bench: cannot write" << outPath;
+        return;
+    }
+    out->write("round\tkcm\tkind\tsync_ms\tframe_ms\tready_ms\n");
+    auto queue = std::make_shared<QList<QPair<int, QString>>>();
+    for (int r = 1; r <= rounds; ++r) {
+        for (const QString &id : ids) {
+            queue->append({r, id});
+        }
+    }
+    auto next = std::make_shared<std::function<void()>>();
+    *next = [this, out, queue, next]() {
+        if (queue->isEmpty()) {
+            out->close();
+            QTimer::singleShot(0, qApp, &QCoreApplication::quit);
+            return;
+        }
+        const auto entry = queue->takeFirst();
+        const int round = entry.first;
+        const QString id = entry.second;
+        MenuItem *item = d->rootItem->descendantForModule(id);
+        if (!item) {
+            out->write(QStringLiteral("%1\t%2\tmissing\t\t\t\n").arg(round).arg(id).toUtf8());
+            QTimer::singleShot(0, this, [next] { (*next)(); });
+            return;
+        }
+        const auto before = d->moduleView->findChildren<QQuickWidget *>();
+        auto timer = std::make_shared<QElapsedTimer>();
+        timer->start();
+        loadModule(d->model->indexForItem(item));
+        const qint64 tSync = timer->elapsed();
+        QQuickWidget *qw = nullptr;
+        for (QQuickWidget *w : d->moduleView->findChildren<QQuickWidget *>()) {
+            if (!before.contains(w) || w->isVisible()) {
+                qw = w; // newest page widget, or the visible one when it was cached
+            }
+        }
+        auto tFrame = std::make_shared<qint64>(-1);
+        if (qw) {
+            auto conn = std::make_shared<QMetaObject::Connection>();
+            *conn = connect(qw, &QQuickWidget::frameSwapped, this, [timer, tFrame, conn] {
+                *tFrame = timer->elapsed();
+                QObject::disconnect(*conn);
+            });
+            qw->update();
+        }
+        auto last = std::make_shared<qint64>(tSync);
+        auto quietStart = std::make_shared<qint64>(-1);
+        auto quiet = std::make_shared<int>(0);
+        auto tick = std::make_shared<std::function<void()>>();
+        const QString kind = qw ? QStringLiteral("qml") : QStringLiteral("widgets");
+        *tick = [this, out, timer, tFrame, last, quiet, quietStart, tick, next, round, id, tSync, kind, qw]() {
+            const qint64 now = timer->elapsed();
+            if (!qw && *tFrame < 0) {
+                *tFrame = now; // widget pages paint in the first event loop pass after loading
+            }
+            if (now - *last < 8 && *tFrame >= 0) {
+                if (*quiet == 0) {
+                    *quietStart = *last;
+                }
+                ++*quiet;
+            } else {
+                *quiet = 0;
+            }
+            *last = now;
+            if (*quiet >= 3 || now > 15000) {
+                out->write(QStringLiteral("%1\t%2\t%3\t%4\t%5\t%6\n")
+                               .arg(round)
+                               .arg(id, kind)
+                               .arg(tSync)
+                               .arg(*tFrame)
+                               .arg(*quiet >= 3 ? *quietStart : -1)
+                               .toUtf8());
+                out->flush();
+                QTimer::singleShot(400, this, [next] { (*next)(); });
+                return;
+            }
+            QTimer::singleShot(1, Qt::PreciseTimer, this, [tick] { (*tick)(); });
+        };
+        QTimer::singleShot(0, Qt::PreciseTimer, this, [tick] { (*tick)(); });
+    };
+    QTimer::singleShot(qEnvironmentVariableIntValue("KSR_BENCH_DELAY") > 0 ? qEnvironmentVariableIntValue("KSR_BENCH_DELAY") : 3000,
+                       this, [next] { (*next)(); });
+}
