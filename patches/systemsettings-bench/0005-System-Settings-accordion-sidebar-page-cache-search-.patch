+/*
+ * SPDX-FileCopyrightText: 2026 KDE Settings Redesign contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "SidebarModel.h"
+
+#include "MenuItem.h"
+#include "MenuModel.h"
+#include "SidebarMode.h"
+
+#include <KCModuleData>
+#include <KCategorizedSortFilterProxyModel>
+
+#include <QIcon>
+
+SidebarModel::SidebarModel(QAbstractItemModel *source, SidebarMode *mode)
+    : QAbstractListModel(mode)
+    , m_source(source)
+    , m_mode(mode)
+{
+    connect(source, &QAbstractItemModel::modelReset, this, &SidebarModel::rebuild);
+    connect(source, &QAbstractItemModel::layoutChanged, this, &SidebarModel::rebuild);
+    connect(source, &QAbstractItemModel::rowsInserted, this, &SidebarModel::rebuild);
+    connect(source, &QAbstractItemModel::rowsRemoved, this, &SidebarModel::rebuild);
+    connect(source, &QAbstractItemModel::rowsMoved, this, &SidebarModel::rebuild);
+    connect(source, &QAbstractItemModel::dataChanged, this, &SidebarModel::sourceDataChanged);
+    rebuild();
+}
+
+SidebarModel::~SidebarModel() = default;
+
+int SidebarModel::rowCount(const QModelIndex &parent) const
+{
+    return parent.isValid() ? 0 : m_rows.size();
+}
+
+QHash<int, QByteArray> SidebarModel::roleNames() const
+{
+    return {
+        {Qt::DisplayRole, "display"},
+        {KindRole, "kind"},
+        {DepthRole, "depth"},
+        {ExpandableRole, "expandable"},
+        {ExpandedRole, "expanded"},
+        {CurrentRole, "isCurrent"},
+        {IconNameRole, "iconName"},
+        {DescriptionRole, "description"},
+        {DefaultIndicatorRole, "showDefaultIndicator"},
+        {AuxiliaryActionRole, "auxiliaryAction"},
+    };
+}
+
+bool SidebarModel::isExpanded(const Row &row) const
+{
+    return row.kind == CategoryRow && row.expandable && row.item == m_expanded;
+}
+
+bool SidebarModel::isCurrent(const Row &row) const
+{
+    if (!m_currentItem) {
+        return false;
+    }
+    if (row.kind == PageRow) {
+        return row.item == m_currentItem;
+    }
+    // A category stands for its current page when the pages are not shown
+    return row.kind == CategoryRow && !isExpanded(row) && row.item == m_currentItem->parent();
+}
+
+QVariant SidebarModel::data(const QModelIndex &index, int role) const
+{
+    if (!checkIndex(index, CheckIndexOption::IndexIsValid | CheckIndexOption::ParentIsInvalid)) {
+        return {};
+    }
+    const Row &row = m_rows.at(index.row());
+    switch (role) {
+    case Qt::DisplayRole:
+        return row.kind == GroupRow ? row.title : row.item->name();
+    case KindRole:
+        return row.kind;
+    case DepthRole:
+        return row.depth;
+    case ExpandableRole:
+        return row.expandable;
+    case ExpandedRole:
+        return isExpanded(row);
+    case CurrentRole:
+        return isCurrent(row);
+    case IconNameRole:
+        return row.item ? row.item->iconName() : QString();
+    case DescriptionRole:
+        return row.item ? row.item->comment() : QString();
+    case DefaultIndicatorRole:
+        return row.item && row.item->showDefaultIndicator();
+    case AuxiliaryActionRole:
+        if (row.item && row.item->moduleData()) {
+            return QVariant::fromValue(row.item->moduleData()->auxiliaryAction());
+        }
+        return {};
+    default:
+        return {};
+    }
+}
+
+int SidebarModel::currentRow() const
+{
+    return m_currentRow;
+}
+
+MenuItem *SidebarModel::currentItem() const
+{
+    return m_currentItem;
+}
+
+QList<SidebarModel::Row> SidebarModel::pageRows(const Row &category) const
+{
+    QList<Row> rows;
+    const int count = m_source->rowCount(category.sourceIndex);
+    for (int i = 0; i < count; ++i) {
+        const QModelIndex index = m_source->index(i, 0, category.sourceIndex);
+        Row row;
+        row.kind = PageRow;
+        row.item = index.data(MenuModel::MenuItemRole).value<MenuItem *>();
+        row.sourceIndex = index;
+        row.depth = 1;
+        rows.append(row);
+    }
+    return rows;
+}
+
+void SidebarModel::rebuild()
+{
+    beginResetModel();
+    m_rows.clear();
+    QString lastGroup;
+    const int count = m_source->rowCount();
+    for (int i = 0; i < count; ++i) {
+        const QModelIndex index = m_source->index(i, 0);
+        auto item = index.data(MenuModel::MenuItemRole).value<MenuItem *>();
+        // The home page has no group, so no header
+        const QString group = index.data(KCategorizedSortFilterProxyModel::CategoryDisplayRole).toString();
+        if (!group.isEmpty() && group != lastGroup) {
+            Row header;
+            header.kind = GroupRow;
+            header.title = group;
+            m_rows.append(header);
+        }
+        lastGroup = group;
+
+        Row row;
+        row.item = item;
+        row.sourceIndex = index;
+        if (item->menu()) {
+            row.kind = CategoryRow;
+            row.expandable = m_source->rowCount(index) > 1;
+            m_rows.append(row);
+            if (isExpanded(row)) {
+                m_rows.append(pageRows(row));
+            }
+        } else {
+            m_rows.append(row);
+        }
+    }
+    endResetModel();
+    // The view forgets its current row on a reset, so announce it again
+    m_currentRow = -1;
+    updateCurrent();
+}
+
+void SidebarModel::sourceDataChanged(const QModelIndex &topLeft, const QModelIndex &bottomRight)
+{
+    if (topLeft.parent() != bottomRight.parent()) {
+        return;
+    }
+    for (int sourceRow = topLeft.row(); sourceRow <= bottomRight.row(); ++sourceRow) {
+        const auto item = m_source->index(sourceRow, 0, topLeft.parent()).data(MenuModel::MenuItemRole).value<MenuItem *>();
+        const int row = rowOfItem(item);
+        if (row >= 0) {
+            Q_EMIT dataChanged(index(row), index(row), {DefaultIndicatorRole, AuxiliaryActionRole, Qt::DisplayRole, IconNameRole});
+        }
+    }
+}
+
+int SidebarModel::rowOfItem(const MenuItem *item) const
+{
+    if (!item) {
+        return -1;
+    }
+    for (int i = 0; i < m_rows.size(); ++i) {
+        if (m_rows.at(i).item == item) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+void SidebarModel::updateCurrent()
+{
+    int row = -1;
+    for (int i = 0; i < m_rows.size(); ++i) {
+        if (isCurrent(m_rows.at(i))) {
+            row = i;
+            break;
+        }
+    }
+    if (!m_rows.isEmpty()) {
+        Q_EMIT dataChanged(index(0), index(m_rows.size() - 1), {CurrentRole, ExpandedRole});
+    }
+    if (row != m_currentRow) {
+        m_currentRow = row;
+        Q_EMIT currentRowChanged();
+    }
+}
+
+void SidebarModel::setExpanded(MenuItem *category)
+{
+    if (m_expanded == category) {
+        return;
+    }
+
+    if (const int row = rowOfItem(m_expanded); row >= 0) {
+        int last = row;
+        while (last + 1 < m_rows.size() && m_rows.at(last + 1).kind == PageRow && m_rows.at(last + 1).depth > 0) {
+            ++last;
+        }
+        if (last > row) {
+            beginRemoveRows({}, row + 1, last);
+            m_rows.remove(row + 1, last - row);
+            endRemoveRows();
+        }
+    }
+
+    m_expanded = category;
+
+    if (const int row = rowOfItem(category); row >= 0 && m_rows.at(row).expandable) {
+        const QList<Row> pages = pageRows(m_rows.at(row));
+        beginInsertRows({}, row + 1, row + pages.size());
+        for (int i = 0; i < pages.size(); ++i) {
+            m_rows.insert(row + 1 + i, pages.at(i));
+        }
+        endInsertRows();
+    }
+    updateCurrent();
+}
+
+void SidebarModel::setCurrentItem(MenuItem *item)
+{
+    m_currentItem = item;
+    // Pages of other layouts (e.g. Home) are not in a category: close the open one
+    MenuItem *category = item && item->parent() && item->parent()->isLayoutCategory() ? item->parent() : nullptr;
+    if (category == m_expanded) {
+        updateCurrent();
+    } else {
+        setExpanded(category);
+    }
+}
+
+void SidebarModel::openFirstPage(const Row &category)
+{
+    const QModelIndex first = m_source->index(0, 0, category.sourceIndex);
+    if (first.isValid()) {
+        m_mode->loadModule(first);
+    }
+}
+
+void SidebarModel::activate(int row)
+{
+    if (row < 0 || row >= m_rows.size()) {
+        return;
+    }
+    const Row entry = m_rows.at(row);
+    switch (entry.kind) {
+    case GroupRow:
+        break;
+    case PageRow:
+        m_mode->loadModule(entry.sourceIndex);
+        break;
+    case CategoryRow:
+        if (!entry.expandable) {
+            openFirstPage(entry);
+        } else if (isExpanded(entry)) {
+            setExpanded(nullptr);
+        } else {
+            expand(row);
+        }
+        break;
+    }
+}
+
+void SidebarModel::expand(int row)
+{
+    if (row < 0 || row >= m_rows.size()) {
+        return;
+    }
+    const Row entry = m_rows.at(row);
+    if (entry.kind != CategoryRow || isExpanded(entry)) {
+        return;
+    }
+    if (!entry.expandable || !m_currentItem || m_currentItem->parent() != entry.item) {
+        // Opening the page expands the category. If the user cancels, because of unsaved changes, nothing changes.
+        openFirstPage(entry);
+    } else {
+        setExpanded(entry.item);
+    }
+}
+
+int SidebarModel::collapse(int row)
+{
+    if (row < 0 || row >= m_rows.size()) {
+        return -1;
+    }
+    const Row entry = m_rows.at(row);
+    MenuItem *category = entry.kind == PageRow && entry.depth > 0 ? entry.item->parent() : entry.item;
+    if (entry.kind == GroupRow || category != m_expanded) {
+        return -1;
+    }
+    setExpanded(nullptr);
+    return rowOfItem(category);
+}
+
+int SidebarModel::nextSelectable(int row, int step) const
+{
+    for (int i = row + step; i >= 0 && i < m_rows.size(); i += step) {
+        if (m_rows.at(i).kind != GroupRow) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+#include "moc_SidebarModel.cpp"
