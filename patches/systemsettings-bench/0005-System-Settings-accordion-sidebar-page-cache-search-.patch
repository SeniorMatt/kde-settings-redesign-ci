+/*
+ * SPDX-FileCopyrightText: 2026 KDE Settings Redesign contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <QAbstractListModel>
+#include <QPersistentModelIndex>
+#include <qqmlregistration.h>
+
+class MenuItem;
+class SidebarMode;
+
+/**
+ * @brief The rows of the System Settings sidebar, as one flat list
+ *
+ * The sidebar is an accordion: section headers (groups), categories, and below the open category its pages.
+ * Only one category is open at a time. This model flattens the visible rows of the category model, so the
+ * view needs no nested delegates and opening a category just inserts a few rows.
+ */
+class SidebarModel : public QAbstractListModel
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_UNCREATABLE("Use the systemsettings.sidebarModel property")
+
+    /**
+     * Row of the entry that is highlighted: the current page, or its category when the page is not shown
+     * (a category with a single page, or a collapsed category). -1 if none.
+     */
+    Q_PROPERTY(int currentRow READ currentRow NOTIFY currentRowChanged)
+
+public:
+    enum Kind {
+        GroupRow, ///< A section header, not clickable
+        CategoryRow, ///< A category, expandable when it has more than one page
+        PageRow, ///< A page, either under the open category or on its own (Home)
+    };
+    Q_ENUM(Kind)
+
+    enum Roles {
+        KindRole = Qt::UserRole + 1,
+        DepthRole,
+        ExpandableRole,
+        ExpandedRole,
+        CurrentRole,
+        IconNameRole,
+        DescriptionRole,
+        DefaultIndicatorRole,
+        AuxiliaryActionRole,
+    };
+
+    /**
+     * @param source The sorted and filtered model of categories (with their pages as children)
+     */
+    SidebarModel(QAbstractItemModel *source, SidebarMode *mode);
+    ~SidebarModel() override;
+
+    int rowCount(const QModelIndex &parent = QModelIndex()) const override;
+    QVariant data(const QModelIndex &index, int role) const override;
+    QHash<int, QByteArray> roleNames() const override;
+
+    int currentRow() const;
+    MenuItem *currentItem() const;
+
+    /**
+     * The page that is shown now. Opens its category, so it is also right when the page was opened by search,
+     * the command line or a link.
+     */
+    void setCurrentItem(MenuItem *item);
+
+    /**
+     * Opens the page, or the category: opens its first page and shows its pages. A category with a single page
+     * opens that page. An open category is collapsed instead.
+     */
+    Q_INVOKABLE void activate(int row);
+
+    /**
+     * Opens a category and its first page, unless the current page is in it already (then it only shows the
+     * pages). Does nothing for other rows.
+     */
+    Q_INVOKABLE void expand(int row);
+
+    /**
+     * Collapses the category of the row.
+     * @return the row to focus now: the category when called on one of its pages. -1 if nothing changed.
+     */
+    Q_INVOKABLE int collapse(int row);
+
+    /**
+     * @return the next row from @p row in direction @p step (1 or -1) that can be selected, so not a section
+     * header. -1 if there is none.
+     */
+    Q_INVOKABLE int nextSelectable(int row, int step) const;
+
+private:
+    struct Row {
+        Kind kind = PageRow;
+        MenuItem *item = nullptr;
+        QString title; // of a group
+        QPersistentModelIndex sourceIndex;
+        int depth = 0;
+        bool expandable = false;
+    };
+
+    void rebuild();
+    void sourceDataChanged(const QModelIndex &topLeft, const QModelIndex &bottomRight);
+    int rowOfItem(const MenuItem *item) const;
+    QList<Row> pageRows(const Row &category) const;
+    void setExpanded(MenuItem *category);
+    void updateCurrent();
+    bool isExpanded(const Row &row) const;
+    bool isCurrent(const Row &row) const;
+    void openFirstPage(const Row &category);
+
+Q_SIGNALS:
+    void currentRowChanged();
+
+private:
+    QAbstractItemModel *const m_source;
+    SidebarMode *const m_mode;
+    QList<Row> m_rows;
+    MenuItem *m_expanded = nullptr;
+    MenuItem *m_currentItem = nullptr;
+    int m_currentRow = -1;
+};
