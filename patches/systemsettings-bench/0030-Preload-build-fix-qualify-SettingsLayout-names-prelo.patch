Subject: [PATCH 30/34] Preload: build fix (qualify SettingsLayout names);
 preload lists generated from ia/layout.json; layout and search index
 regenerated for the reworked pages' new labels

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X5N5x9eWzmrq6QYrYLwQnk
---
 app/PagePreloader.cpp  |  10 +-
 app/settingsindex_p.h  | 759 +++++++++++++++++++++--------------------
 app/settingslayout_p.h |  50 ++-
 3 files changed, 410 insertions(+), 409 deletions(-)

diff --git a/app/PagePreloader.cpp b/app/PagePreloader.cpp
index 1b57a2e..79b4fbd 100644
--- a/app/PagePreloader.cpp
+++ b/app/PagePreloader.cpp
@@ -62,13 +62,13 @@ bool PagePreloader::isExcluded(MenuItem *item, bool idle)
         return true;
     }
     const QByteArray id = item->metaData().pluginId().toUtf8();
-    for (const char *never : neverPreload) {
+    for (const char *never : SettingsLayout::neverPreload) {
         if (id == never) {
             return true;
         }
     }
     if (idle) {
-        for (const char *heavy : neverPreloadWhenIdle) {
+        for (const char *heavy : SettingsLayout::neverPreloadWhenIdle) {
             if (id == heavy) {
                 return true;
             }
@@ -144,7 +144,7 @@ void PagePreloader::startIdle()
 
 void PagePreloader::runIdle()
 {
-    if (m_idleDone >= idleMaxPages || m_idleCursor >= int(std::size(commonTasks))) {
+    if (m_idleDone >= idleMaxPages || m_idleCursor >= int(std::size(SettingsLayout::commonTasks))) {
         return;
     }
     // Wait for a calm moment: the user is using the app, or it is in the background
@@ -153,8 +153,8 @@ void PagePreloader::runIdle()
         return;
     }
     // Next common-task target that exists and may be built
-    while (m_idleCursor < int(std::size(commonTasks))) {
-        MenuItem *item = m_root->descendantForModule(QString::fromLatin1(commonTasks[m_idleCursor++].kcm));
+    while (m_idleCursor < int(std::size(SettingsLayout::commonTasks))) {
+        MenuItem *item = m_root->descendantForModule(QString::fromLatin1(SettingsLayout::commonTasks[m_idleCursor++].kcm));
         if (!item || isExcluded(item, true) || m_view->hasPage(item)) {
             continue;
         }
