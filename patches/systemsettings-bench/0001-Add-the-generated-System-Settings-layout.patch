+struct Page {
+    const char *kcm; // plugin id; pages missing on this system are skipped
+    KLazyLocalizedString name; // empty: use the page's own name
+    KLazyLocalizedString description; // empty: use the page's own description
+    KLazyLocalizedString keywords; // extra search words, comma-separated (synonyms, old names)
+    const char *orApp; // desktop file id of an app to show when the KCM is missing, or nullptr
+    const char *formFactors; // comma-separated, empty = all
+};
+
+struct Category {
+    const char *id;
+    const char *group;
+    KLazyLocalizedString name;
+    const char *icon;
+    KLazyLocalizedString description;
+    const Page *pages;
+    int pageCount;
+    const char *related; // comma-separated plugin ids shown as "Related settings"
+};
+
+struct Group {
