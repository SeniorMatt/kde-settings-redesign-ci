From e9fe6937ee5f324e3f59b1f1e7ee4f49c057bfcf Mon Sep 17 00:00:00 2001
From: Senior Matthew <SeniorMatt@users.noreply.github.com>
Date: Sun, 22 Nov 2026 02:23:52 +0500
Subject: [PATCH] kcm_plymouth: Gallery page; theme scan after the first frame,
 empty state, apply progress text
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Page type: Gallery (docs/page-design.md), already one grid with "Get New…" as a page action, so the structure stays.
KAuth save/uninstall flow (org.kde.kcontrol.kcmplymouth, 15 min timeout), plymouth config path and kns file unchanged.
No visible label changed (no relabel table needed).

Changed:
- Empty state: Kirigami.PlaceholderMessage "No boot splash screens found" (HIG: no empty list), shown only after
  the scan finished (new KCMPlymouth::loaded property).
- Busy indicator only if the scan takes more than 150 ms.
- While applying (kcm.busy), a line above the progress bar says it can take a minute while the startup image is
  rebuilt; before, the user only saw an unexplained bar. The grid is disabled as before.
- Thumbnails load with asynchronous: true.

Speed: load() called reloadModel() synchronously, which lists PLYMOUTH_THEMES_DIR and parses one .plymouth file
per theme with KConfig (src/kcm.cpp reloadModel, load). It is now queued with QTimer::singleShot(0) so the page
gets its first frame first; the selected plugin (one small config read) is still read in load(). After numbers:
pending, manager will measure. Apply time (initramfs regeneration in the helper) is save time, unchanged.

HIG: HIG-001, HIG-013, HIG-017, HIG-058. Not built yet. Unconfirmed: Kirigami.PlaceholderMessage.explanation is
used from the repo's kirigami source (src/master/kirigami), not compiled here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X5N5x9eWzmrq6QYrYLwQnk
---
 src/kcm.cpp     | 22 +++++++++++++++++++++-
 src/kcm.h       |  7 +++++++
 src/ui/main.qml | 44 +++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 69 insertions(+), 4 deletions(-)

diff --git a/src/kcm.cpp b/src/kcm.cpp
index 45d589b..5ed3300 100644
--- a/src/kcm.cpp
+++ b/src/kcm.cpp
@@ -12,6 +12,8 @@
 
 #include <chrono>
 
+#include <QTimer>
+
 #include <KConfigGroup>
 #include <KLocalizedString>
 #include <KPluginFactory>
@@ -56,6 +58,7 @@ void KCMPlymouth::reloadModel()
 
     QDir dir(QStringLiteral(PLYMOUTH_THEMES_DIR));
     if (!dir.exists()) {
+        setLoaded(true);
         return;
     }
 
@@ -97,9 +100,24 @@ void KCMPlymouth::reloadModel()
         m_model->appendRow(row);
     }
 
+    setLoaded(true);
     Q_EMIT selectedPluginIndexChanged();
 }
 
+bool KCMPlymouth::loaded() const
+{
+    return m_loaded;
+}
+
+void KCMPlymouth::setLoaded(bool loaded)
+{
+    if (m_loaded == loaded) {
+        return;
+    }
+    m_loaded = loaded;
+    Q_EMIT loadedChanged();
+}
+
 void KCMPlymouth::onEntryEvent(const KNSCore::Entry &entry)
 {
     static QStringList alreadyCopiedThumbnails;
@@ -163,7 +181,9 @@ int KCMPlymouth::selectedPluginIndex() const
 
 void KCMPlymouth::load()
 {
-    reloadModel();
+    // Scanning the theme directory and parsing every .plymouth file is disk work: do it after the page has had its first
+    // frame (loaded() tells the page when the grid is complete).
+    QTimer::singleShot(0, this, &KCMPlymouth::reloadModel);
 
     KConfigGroup cg(KSharedConfig::openConfig(QStringLiteral(PLYMOUTH_CONFIG_PATH)), QStringLiteral("Daemon"));
 
diff --git a/src/kcm.h b/src/kcm.h
index 99f87f5..9531d79 100644
--- a/src/kcm.h
+++ b/src/kcm.h
@@ -24,6 +24,7 @@ class KCMPlymouth : public KQuickConfigModule
     Q_PROPERTY(QString selectedPlugin READ selectedPlugin WRITE setSelectedPlugin NOTIFY selectedPluginChanged)
     Q_PROPERTY(int selectedPluginIndex READ selectedPluginIndex NOTIFY selectedPluginIndexChanged)
     Q_PROPERTY(bool busy READ busy WRITE setBusy NOTIFY busyChanged)
+    Q_PROPERTY(bool loaded READ loaded NOTIFY loadedChanged)
 
 public:
     enum Roles {
@@ -45,6 +46,8 @@ public:
     bool busy() const;
     void setBusy(const bool &busy);
 
+    bool loaded() const;
+
     Q_INVOKABLE void reloadModel();
     Q_INVOKABLE void onEntryEvent(const KNSCore::Entry &entry);
     Q_INVOKABLE void uninstall(const QString &plugin);
@@ -59,6 +62,7 @@ Q_SIGNALS:
     void selectedPluginIndexChanged();
 
     void busyChanged();
+    void loadedChanged();
 
     void showSuccessMessage(const QString &message);
     void showErrorMessage(const QString &message);
@@ -66,7 +70,10 @@ Q_SIGNALS:
 private:
     QStandardItemModel *const m_model;
     QString m_selectedPlugin;
+    void setLoaded(bool loaded);
+
     bool m_busy = false;
+    bool m_loaded = false;
 };
 
 #endif
diff --git a/src/ui/main.qml b/src/ui/main.qml
index e70d8f5..dcb67d3 100644
--- a/src/ui/main.qml
+++ b/src/ui/main.qml
@@ -14,7 +14,10 @@ import org.kde.kcmutils as KCM
 import org.kde.newstuff 1.91 as NewStuff
 
 KCM.GridViewKCM {
+    id: root
+
     actions: NewStuff.Action {
+        // ksr: kcm_plymouth/GetNew
         id: newStuffButton
         text: i18nc("@action:button as in, get new Plymouth boot splash screens", "Get New…")
         enabled: !kcm.busy
@@ -30,6 +33,7 @@ KCM.GridViewKCM {
         showCloseButton: true
     }
 
+    // The theme directory is read right after the first frame (kcm.loaded); busy only when that takes longer than 150 ms.
     view.model: kcm.themesModel
     view.currentIndex: kcm.selectedPluginIndex
     view.enabled: !kcm.busy
@@ -44,12 +48,14 @@ KCM.GridViewKCM {
         thumbnail: Image {
             anchors.fill: parent
             source: model.screenshot
+            asynchronous: true
             sourceSize: Qt.size(delegate.GridView.view.cellWidth * Screen.devicePixelRatio,
                                 delegate.GridView.view.cellHeight * Screen.devicePixelRatio)
         }
 
         actions: [
             Kirigami.Action {
+                // ksr: kcm_plymouth/RemoveTheme
                 icon.name: "edit-delete"
                 tooltip: if (enabled) {
                     return i18nc("@info:tooltip", "Remove boot splash screen");
@@ -71,10 +77,42 @@ KCM.GridViewKCM {
         }
     }
 
-    footer: QtControls.ProgressBar {
-        id: progressBar
+    Timer {
+        id: busyDelay
+        interval: 150
+        running: !kcm.loaded
+    }
+    QtControls.BusyIndicator {
+        anchors.centerIn: parent
+        z: 1
+        running: visible
+        visible: !kcm.loaded && !busyDelay.running
+    }
+    Kirigami.PlaceholderMessage {
+        anchors.centerIn: parent
+        width: parent.width - Kirigami.Units.gridUnit * 4
+        visible: kcm.loaded && root.view.count === 0
+        icon.name: "preferences-system-startup"
+        text: i18nc("@info", "No boot splash screens found")
+        explanation: i18nc("@info", "Use “Get New…” to download one.")
+    }
+
+    // Applying regenerates the boot image for every installed kernel and can take a minute or more.
+    footer: ColumnLayout {
+        spacing: 0
         visible: kcm.busy
-        indeterminate: true
+
+        QtControls.Label {
+            Layout.fillWidth: true
+            Layout.margins: Kirigami.Units.smallSpacing
+            text: i18nc("@info", "Applying the boot splash screen. This can take a minute while the startup image is rebuilt.")
+            wrapMode: Text.Wrap
+        }
+        QtControls.ProgressBar {
+            id: progressBar
+            Layout.fillWidth: true
+            indeterminate: true
+        }
     }
 
     Connections {
