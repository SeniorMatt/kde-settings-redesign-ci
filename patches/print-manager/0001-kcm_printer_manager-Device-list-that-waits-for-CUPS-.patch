diff --git a/src/kcm/printermanager.cpp b/src/kcm/printermanager.cpp
index 8df6126..27ed21f 100644
--- a/src/kcm/printermanager.cpp
+++ b/src/kcm/printermanager.cpp
@@ -16,6 +16,7 @@
 #include <QCommandLineParser>
 #include <QDBusConnection>
 #include <QDBusConnectionInterface>
+#include <QDBusMessage>
 #include <QDBusMetaType>
 #include <QDBusPendingCallWatcher>
 #include <QDBusPendingReply>
@@ -84,6 +85,20 @@ PrinterManager::PrinterManager(QObject *parent, const KPluginMetaData &metaData,
     qmlRegisterType<SCPInstaller>("org.kde.plasma.printmanager", 1, 0, "SCPInstaller");
 #endif
 
+    // Is the printer setup helper installed? ListActivatableNames returns every activatable name on the bus,
+    // so it is asked without blocking: the banner appears when the answer is "missing".
+    QDBusMessage activatable = QDBusMessage::createMethodCall(u"org.freedesktop.DBus"_s, u"/org/freedesktop/DBus"_s, u"org.freedesktop.DBus"_s, u"ListActivatableNames"_s);
+    auto scpWatcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(activatable), this);
+    connect(scpWatcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<QStringList> reply = *w;
+        w->deleteLater();
+        const bool missing = reply.isValid() && !reply.value().contains("org.fedoraproject.Config.Printing"_L1);
+        if (m_scpMissing != missing) {
+            m_scpMissing = missing;
+            Q_EMIT scpMissingChanged();
+        }
+    });
+
     // If activation requested, set command line args and notify
     connect(this, &PrinterManager::activationRequested, this, &PrinterManager::processCmdLine);
     // Handle command line args
@@ -198,6 +213,11 @@ void PrinterManager::clearRecommendedDrivers()
     m_recommendedDrivers.clear();
 }
 
+bool PrinterManager::scpMissing() const
+{
+    return m_scpMissing;
+}
+
 bool PrinterManager::isSCPAvailable()
 {
     // The service is activatable, so check the list
