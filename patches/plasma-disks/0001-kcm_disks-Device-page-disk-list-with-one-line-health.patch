+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2020-2021 Harald Sitter <sitter@kde.org>
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+
+import "health.js" as Health
+
+// Sub-page of one disk (Device page, docs/page-design.md 1): state first, then what the user can change.
+KCM.SimpleKCM {
+    id: root
+
+    // The Device QObject from the model's "object" role: failed, instabilities, ignore, advancedReport, product, path.
+    required property var device
+
+    Kirigami.FormLayout {
+        // Same row grammar as the Thunderbolt device page.
+        QQC2.Label {
+            Kirigami.FormData.label: i18nc("@label", "Disk:")
+            text: "%1 (%2)".arg(root.device.product).arg(root.device.path)
+        }
+
+        RowLayout {
+            Kirigami.FormData.label: i18nc("@label", "Health:")
+            spacing: Kirigami.Units.smallSpacing
+
+            Kirigami.Icon {
+                source: Health.icon(root.device.failed, root.device.instabilities)
+                implicitWidth: Kirigami.Units.iconSizes.smallMedium
+                implicitHeight: Kirigami.Units.iconSizes.smallMedium
+            }
+            QQC2.Label {
+                text: Health.summary(root.device.failed, root.device.instabilities)
+            }
+        }
+
+        // Long text on its own row, with a maximum width so the form does not switch to narrow mode.
+        QQC2.Label {
+            Layout.fillWidth: true
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 24
+            wrapMode: Text.Wrap
+            text: Health.explanation(root.device.failed, root.device.instabilities)
+        }
+
+        Repeater {
+            model: root.device.instabilities
+
+            QQC2.Label {
+                required property string modelData
+                required property int index
+
+                Kirigami.FormData.label: index === 0 ? i18nc("@label", "Early signs:") : ""
+                Layout.fillWidth: true
+                Layout.maximumWidth: Kirigami.Units.gridUnit * 24
+                wrapMode: Text.Wrap
+                text: modelData
+            }
+        }
+
+        Kirigami.Separator {
+            Kirigami.FormData.isSection: true
+            Kirigami.FormData.label: i18nc("@title:group", "Monitoring")
+        }
+
+        QQC2.CheckBox {
+            // ksr: kcm_disks/DeviceMonitor
+            text: i18nc("@option:check", "Warn about problems with this disk")
+            Accessible.name: text
+            checked: !root.device.ignore
+            onToggled: root.device.ignore = !checked
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 24
+            wrapMode: Text.Wrap
+            font: Kirigami.Theme.smallFont
+            text: i18nc("@info", "When off, SMART problems of this disk are ignored and no notification is shown.")
+        }
+
+        Kirigami.Separator {
+            Kirigami.FormData.isSection: true
+            Kirigami.FormData.label: i18nc("@title:group", "Report")
+            visible: root.device.advancedReport !== ""
+        }
+
+        QQC2.Button {
+            // ksr: kcm_disks/ShowDetails
+            visible: root.device.advancedReport !== ""
+            text: i18nc("@action/button show detailed smart report", "Show SMART Report…")
+            icon.name: "showinfo-symbolic"
+            // NB: push hardcodes ui/ as prefix.
+            onClicked: kcm.push("ReportPage.qml", {title: root.device.product, text: root.device.advancedReport})
+        }
+    }
+}
