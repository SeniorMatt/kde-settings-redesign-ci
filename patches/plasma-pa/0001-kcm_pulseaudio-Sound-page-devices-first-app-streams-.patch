--- /dev/null
+++ b/src/kcm/ui/OutputBehavior.qml
@@ -0,0 +1,49 @@
+/*
+    SPDX-FileCopyrightText: 2016 David Edmundson <davidedmundson@kde.org>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+import org.kde.kcmutils as KCM
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.private.volume
+
+// Sub-page of Sound (kcm.push), PulseAudio only. These two options were the "Configure…" menu in the toolbar. The
+// ModuleManager (three GSettings items and a module scan) is created only when this page is opened.
+KCM.SimpleKCM {
+    id: root
+
+    title: i18nd("kcm_pulseaudio", "Output Behavior")
+
+    ModuleManager {
+        id: moduleManager
+    }
+
+    Kirigami.FormLayout {
+        QQC2.CheckBox {
+            enabled: moduleManager.configModuleLoaded
+            text: i18nd("kcm_pulseaudio", "Add virtual output device for simultaneous output on all local sound cards") // ksr: kcm_pulseaudio/combineSinks
+            checked: moduleManager.combineSinks
+            onToggled: moduleManager.combineSinks = checked
+        }
+
+        QQC2.CheckBox {
+            enabled: moduleManager.configModuleLoaded
+            text: i18nd("kcm_pulseaudio", "Automatically switch all running streams when a new output becomes available") // ksr: kcm_pulseaudio/switchOnConnect
+            checked: moduleManager.switchOnConnect
+            onToggled: moduleManager.switchOnConnect = checked
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            Layout.maximumWidth: Kirigami.Units.gridUnit * 20
+            visible: !moduleManager.configModuleLoaded
+            text: i18nd("kcm_pulseaudio", "Requires %1 PulseAudio module", moduleManager.configModuleName)
+            font: Kirigami.Theme.smallFont
+            wrapMode: Text.Wrap
+        }
+    }
+}
