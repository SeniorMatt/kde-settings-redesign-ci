diff --git a/kcm/PowerKCM.cpp b/kcm/PowerKCM.cpp
index f9450ee..16eb13f 100644
--- a/kcm/PowerKCM.cpp
+++ b/kcm/PowerKCM.cpp
@@ -36,6 +36,8 @@
 #include <QDBusConnectionInterface>
 #include <QDBusMessage>
 #include <QDBusPendingCall>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
 #include <QDBusServiceWatcher>
 #include <QQuickItem>
 #include <QQuickRenderControl>
@@ -199,9 +201,10 @@ PowerKCM::PowerKCM(QObject *parent, const KPluginMetaData &metaData)
 
     for (const KPluginMetaData &offer : offers) {
         QString actionId = offer.value(QStringLiteral("X-KDE-PowerDevil-Action-ID"));
-        bool supported = true;
-
-        // Does it have a runtime requirement?
+        // ksr: the runtime-requirement query used to block the GUI thread (asyncCall + waitForFinished) once per
+        // action while the KCM was being constructed. Now the answer arrives asynchronously: the action starts
+        // out as "not supported" (its rows stay hidden) and supportedActionsChanged() fires when the daemon replies.
+        // A failed call keeps the old behaviour: assume the action is supported.
         if (offer.value(QStringLiteral("X-KDE-PowerDevil-Action-HasRuntimeRequirement"), false)) {
             qCDebug(POWERDEVIL) << offer.name() << " has a runtime requirement";
 
@@ -210,18 +213,28 @@ PowerKCM::PowerKCM(QObject *parent, const KPluginMetaData &metaData)
                                                                u"org.kde.Solid.PowerManagement"_s,
                                                                u"isActionSupported"_s);
             call.setArguments(QVariantList() << actionId);
-            QDBusPendingReply<bool> reply = QDBusConnection::sessionBus().asyncCall(call);
-            reply.waitForFinished();
-
-            if (reply.isValid()) {
-                if (!reply.value()) {
-                    supported = false;
-                    qCDebug(POWERDEVIL) << "The action " << actionId << " appears not to be supported by the core.";
+            auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(call), this);
+            connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, actionId](QDBusPendingCallWatcher *w) {
+                QDBusPendingReply<bool> reply = *w;
+                w->deleteLater();
+                bool supported = true;
+                if (reply.isValid()) {
+                    supported = reply.value();
+                    if (!supported) {
+                        qCDebug(POWERDEVIL) << "The action " << actionId << " appears not to be supported by the core.";
+                    }
+                } else {
+                    qCDebug(POWERDEVIL) << "There was a problem in contacting DBus!! Assuming the action is ok.";
                 }
-            } else {
-                qCDebug(POWERDEVIL) << "There was a problem in contacting DBus!! Assuming the action is ok.";
-            }
+                if (m_supportedActions.value(actionId).toBool() != supported) {
+                    m_supportedActions.insert(actionId, supported);
+                    Q_EMIT supportedActionsChanged();
+                }
+            });
+            m_supportedActions.insert(actionId, false);
+            continue;
         }
+        bool supported = true;
 
         m_supportedActions.insert(actionId, supported);
     }
