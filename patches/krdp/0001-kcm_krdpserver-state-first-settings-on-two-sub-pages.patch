diff --git a/src/kcm/ui/Certificates.qml b/src/kcm/ui/Certificates.qml
new file mode 100644
index 0000000..08e8284
--- /dev/null
+++ b/src/kcm/ui/Certificates.qml
@@ -0,0 +1,168 @@
+// SPDX-FileCopyrightText: 2024 Akseli Lahtinen <akselmo@akselmo.dev>
+//
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+
+// Sub-page of the Remote Desktop page (kcm.push): the TLS certificate the server uses.
+// These were the "Security Certificates" form in the footer of the main page.
+KCM.SimpleKCM {
+    id: root
+
+    property var settings: kcm.settings()
+
+    readonly property bool showManualCertUI: !autoGenCertSwitch.checked
+
+    title: i18nc("@title", "Certificates")
+
+    // SimpleKCM takes one child item
+    ColumnLayout {
+        Kirigami.InlineMessage {
+            id: certificateError
+            // The same message as on the main page: generation can also be started from here
+            Layout.fillWidth: true
+            type: Kirigami.MessageType.Error
+            visible: false
+            text: i18nc("@info:status", "Generating certificates automatically has failed!")
+        }
+        Connections {
+            target: kcm
+            function onGenerateCertificateSucceeded(): void {
+                certificateError.visible = false;
+            }
+            function onGenerateCertificateFailed(): void {
+                certificateError.visible = true;
+            }
+        }
+
+        Kirigami.FormLayout {
+            Layout.fillWidth: true
+            QQC2.CheckBox {
+                // ksr: kcm_krdpserver/autogenerateCertificates (was "Generate certificates: Automatically")
+                id: autoGenCertSwitch
+
+                Kirigami.FormData.label: i18n("Certificate:")
+                text: i18nc("@option:check", "Generate automatically")
+                checked: root.settings.autogenerateCertificates
+                onCheckedChanged: {
+                    root.settings.autogenerateCertificates = checked;
+                    if (checked) {
+                        kcm.generateCertificate();
+
+                        certPathField.text = kcm.defaultCertificatePath;
+                        certKeyPathField.text = kcm.defaultCertificateKeyPath;
+                    }
+                }
+
+                KCM.SettingStateBinding {
+                    configObject: root.settings
+                    settingName: "autogenerateCertificates"
+                }
+            }
+
+            RowLayout {
+                // ksr: kcm_krdpserver/settings-certificate
+                // ksr: kcm_krdpserver/Choose-certificate-file
+                Kirigami.FormData.label: i18n("Certificate path:")
+                Kirigami.FormData.buddyFor: certPathField
+                visible: root.showManualCertUI
+                spacing: Kirigami.Units.smallSpacing
+
+                Kirigami.ActionTextField {
+                    id: certPathField
+                    placeholderText: i18nc("@info:placeholder", "Enter certificate path…")
+
+                    rightActions: Kirigami.Action {
+                        icon.name: "edit-clear-symbolic"
+                        visible: certPathField.text !== ""
+                        onTriggered: {
+                            certPathField.text = ""
+                        }
+                    }
+
+                    text: root.settings.certificate
+                    onAccepted: root.settings.certificate = text
+
+                    KCM.SettingHighlighter {
+                        highlight: certPathField.text !== kcm.defaultCertificatePath
+                    }
+                }
+
+                QQC2.Button {
+                    icon.name: "folder-open-symbolic"
+                    text: i18nc("@action:button", "Choose certificate file…")
+                    display: QQC2.AbstractButton.IconOnly
+
+                    onClicked: {
+                        certLoader.selectKey = false;
+                        certLoader.active = true;
+                    }
+
+                    QQC2.ToolTip.visible: hovered || activeFocus
+                    QQC2.ToolTip.text: text
+                    QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+
+                    Accessible.description: i18n("Opens a file picker for the certificate file")
+                    Accessible.onPressAction: onClicked()
+                }
+            }
+
+            RowLayout {
+                // ksr: kcm_krdpserver/settings-certificateKey
+                // ksr: kcm_krdpserver/Choose-certificate-key-file
+                Kirigami.FormData.label: i18n("Certificate key path:")
+                Kirigami.FormData.buddyFor: certKeyPathField
+                visible: root.showManualCertUI
+                spacing: Kirigami.Units.smallSpacing
+
+                Kirigami.ActionTextField {
+                    id: certKeyPathField
+                    placeholderText: i18nc("@info:placeholder", "Enter certificate key path…")
+
+                    rightActions: Kirigami.Action {
+                        icon.name: "edit-clear-symbolic"
+                        visible: certKeyPathField.text !== ""
+                        onTriggered: {
+                            certKeyPathField.text = ""
+                        }
+                    }
+
+                    text: root.settings.certificateKey
+                    onAccepted: root.settings.certificateKey = text
+
+                    KCM.SettingHighlighter {
+                        highlight: certKeyPathField.text !== kcm.defaultCertificateKeyPath
+                    }
+                }
+
+                QQC2.Button {
+                    icon.name: "folder-open-symbolic"
+                    text: i18nc("@action:button", "Choose certificate key file…")
+                    display: QQC2.AbstractButton.IconOnly
+
+                    onClicked: {
+                        certLoader.selectKey = true;
+                        certLoader.active = true;
+                    }
+
+                    QQC2.ToolTip.visible: hovered || activeFocus
+                    QQC2.ToolTip.text: text
+                    QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+
+                    Accessible.description: i18n("Opens a file picker for the certificate key file")
+                    Accessible.onPressAction: onClicked()
+                }
+            }
+        }
+
+        CertLoader {
+            id: certLoader
+            visible: false
+        }
+    }
+}
