diff --git a/src/kcm/kcmkrdpserver.cpp b/src/kcm/kcmkrdpserver.cpp
index 1995727..e9e319b 100644
--- a/src/kcm/kcmkrdpserver.cpp
+++ b/src/kcm/kcmkrdpserver.cpp
@@ -329,36 +329,50 @@ void KRDPServerConfig::generateCertificate()
     QString certificatePath(defaultCertificatePath());
     QString certificateKeyPath(defaultCertificateKeyPath());
     qDebug(KRDPKCM) << "Generating certificate files to: " << certificatePath << " and " << certificateKeyPath;
-    QProcess sslProcess;
-    sslProcess.start(u"openssl"_s,
-                     {
-                         u"req"_s,
-                         u"-nodes"_s,
-                         u"-new"_s,
-                         u"-x509"_s,
-                         u"-keyout"_s,
-                         certificateKeyPath,
-                         u"-out"_s,
-                         certificatePath,
-                         u"-days"_s,
-                         u"3650"_s,
-                         u"-batch"_s,
-                     });
-    sslProcess.waitForFinished();
-
-    m_serverSettings->setCertificate(certificatePath);
-    m_serverSettings->setCertificateKey(certificateKeyPath);
-
-    // Check that the path is valid
-    if (QFileInfo::exists(certificatePath) && QFileInfo::exists(certificateKeyPath)) {
-        qDebug(KRDPKCM) << "Certificate generated; ready to accept connections.";
-        Q_EMIT generateCertificateSucceeded();
-    } else {
-        qCritical(KRDPKCM) << "Could not generate a certificate. A valid TLS certificate and key should be provided.";
-        Q_EMIT generateCertificateFailed();
+    // ksr: this used to be a QProcess + waitForFinished() on the GUI thread, run from the constructor on the first
+    // start (openssl RSA key generation). Now the process runs on its own and the result is reported when it exits.
+    if (m_certificateProcess) {
+        return; // already generating
     }
+    m_certificateProcess = new QProcess(this);
+    connect(m_certificateProcess, &QProcess::finished, this, [this, certificatePath, certificateKeyPath](int, QProcess::ExitStatus) {
+        m_certificateProcess->deleteLater();
+        m_certificateProcess = nullptr;
+
+        m_serverSettings->setCertificate(certificatePath);
+        m_serverSettings->setCertificateKey(certificateKeyPath);
+
+        // Check that the path is valid
+        if (QFileInfo::exists(certificatePath) && QFileInfo::exists(certificateKeyPath)) {
+            qDebug(KRDPKCM) << "Certificate generated; ready to accept connections.";
+            Q_EMIT generateCertificateSucceeded();
+        } else {
+            qCritical(KRDPKCM) << "Could not generate a certificate. A valid TLS certificate and key should be provided.";
+            Q_EMIT generateCertificateFailed();
+        }
 
-    m_serverSettings->save();
+        m_serverSettings->save();
+    });
+    connect(m_certificateProcess, &QProcess::errorOccurred, this, [this](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart && m_certificateProcess) {
+            // finished() is not emitted when the process never started
+            Q_EMIT m_certificateProcess->finished(-1, QProcess::CrashExit);
+        }
+    });
+    m_certificateProcess->start(u"openssl"_s,
+                                {
+                                    u"req"_s,
+                                    u"-nodes"_s,
+                                    u"-new"_s,
+                                    u"-x509"_s,
+                                    u"-keyout"_s,
+                                    certificateKeyPath,
+                                    u"-out"_s,
+                                    certificatePath,
+                                    u"-days"_s,
+                                    u"3650"_s,
+                                    u"-batch"_s,
+                                });
 }
 
 void KRDPServerConfig::updateServerStatus()
