 #include <KAuth/Action>
 #include <KAuth/ExecuteJob>
@@ -36,7 +39,23 @@ KCMWallet::KCMWallet(QObject *parent, const KPluginMetaData &metaData)
     // calculation. Since we don't use it here delete it from the skeleton
     m_data->settings()->removeItem(QStringLiteral("FirstUse"));
 
-    m_walletList = KWallet::Wallet::walletList();
+    // KWallet::Wallet::walletList() is a blocking D-Bus call (it can even start kwalletd), so it must not run before
+    // the first frame. Read it on a worker thread; the combo boxes bind to walletListChanged().
+    refreshWalletList();
+}
+
+void KCMWallet::refreshWalletList()
+{
+    auto result = std::make_shared<QStringList>();
+    QThread *thread = QThread::create([result]() {
+        *result = KWallet::Wallet::walletList();
+    });
+    connect(thread, &QThread::finished, this, [this, result]() {
+        m_walletList = *result;
+        Q_EMIT walletListChanged();
+    });
+    connect(thread, &QThread::finished, thread, &QObject::deleteLater);
+    thread->start();
 }
 
 KWalletSettings *KCMWallet::settings() const
@@ -128,8 +147,7 @@ void KCMWallet::createWallet(const QString &name)
 
         connect(promp, &OrgFreedesktopSecretPromptInterface::Completed, this, [this](bool dismissed, const QDBusVariant & /*result*/) {
             if (!dismissed) {
-                m_walletList = KWallet::Wallet::walletList();
-                Q_EMIT walletListChanged();
+                refreshWalletList();
             }
         });
     });
