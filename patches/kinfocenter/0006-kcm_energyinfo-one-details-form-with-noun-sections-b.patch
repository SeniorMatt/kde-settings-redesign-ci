 {
     qmlRegisterUncreatableType<Solid::Battery>("org.kde.kinfocenter.energy.private", 1, 0, "Battery", QStringLiteral("Use Solid::Battery"));
 
-    m_batteries = Solid::Device::listFromType(Solid::DeviceInterface::Battery);
-    std::sort(m_batteries.begin(), m_batteries.end(), [](const Solid::Device &lhs, const Solid::Device &rhs) {
-        auto lhsBattery = lhs.as<Solid::Battery>();
-        auto rhsBattery = rhs.as<Solid::Battery>();
-        if (lhsBattery->isPowerSupply() != rhsBattery->isPowerSupply()) {
-            return lhsBattery->isPowerSupply();
-        }
-
-        return lhs.product().compare(rhs.product(), Qt::CaseInsensitive) < 0;
-    });
+    // The scan (Solid::Device::listFromType and the sort, which reads every battery) runs from the event loop, after
+    // the page has been created (the Solid notifier is connected there too).
+    metaObject()->invokeMethod(this, &BatteryModel::populate, Qt::QueuedConnection);
+}
 
+void BatteryModel::populate()
+{
+    // Also here: the first DeviceNotifier::instance() sets up Solid's backends
     connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceAdded, this, [this](const QString &udi) {
         auto it = std::find_if(m_batteries.constBegin(), m_batteries.constEnd(), [&udi](const Solid::Device &dev) {
             return dev.udi() == udi;
@@ -61,6 +58,38 @@ BatteryModel::BatteryModel(QObject *parent)
 
         Q_EMIT countChanged();
     });
+
+    QList<Solid::Device> found = Solid::Device::listFromType(Solid::DeviceInterface::Battery);
+    std::sort(found.begin(), found.end(), [](const Solid::Device &lhs, const Solid::Device &rhs) {
+        auto lhsBattery = lhs.as<Solid::Battery>();
+        auto rhsBattery = rhs.as<Solid::Battery>();
+        if (lhsBattery->isPowerSupply() != rhsBattery->isPowerSupply()) {
+            return lhsBattery->isPowerSupply();
+        }
+
+        return lhs.product().compare(rhs.product(), Qt::CaseInsensitive) < 0;
+    });
+
+    // Rows are inserted (as for a device that is plugged in), not reset, so the list keeps its current index
+    found.removeIf([this](const Solid::Device &device) {
+        return std::any_of(m_batteries.cbegin(), m_batteries.cend(), [&device](const Solid::Device &known) {
+            return known.udi() == device.udi();
+        });
+    });
+    if (!found.isEmpty()) {
+        beginInsertRows(QModelIndex(), 0, found.count() - 1);
+        m_batteries = found + m_batteries;
+        endInsertRows();
+        Q_EMIT countChanged();
+    }
+
+    m_loaded = true;
+    Q_EMIT loadedChanged();
+}
+
+bool BatteryModel::loaded() const
+{
+    return m_loaded;
 }
 
 QVariant BatteryModel::data(const QModelIndex &index, int role) const
