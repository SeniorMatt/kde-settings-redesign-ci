index 9a37085..cb7d238 100644
--- a/kcms/about-distro/src/GPUEntryFactory.h
+++ b/kcms/about-distro/src/GPUEntryFactory.h
@@ -10,5 +10,16 @@ class Entry;
 class GPUEntryFactory
 {
 public:
-    static std::vector<Entry *> factorize();
+    enum class Fallback {
+        No,
+        Yes,
+    };
+
+    // Reads the GPUs with the Vulkan and EGL helper processes (blocks up to 2 s each, safe to call from a worker thread
+    // as long as the entries are moved to the GUI thread afterwards). With Fallback::Yes and no result it also asks
+    // OpenGL for the renderer of this process, which must run on the GUI thread; with Fallback::No it returns {} then.
+    static std::vector<Entry *> factorize(Fallback fallback = Fallback::Yes);
+
+    // The "renderer of this process" entry (needs a QOpenGLContext: GUI thread only)
+    static std::vector<Entry *> fallbackEntries();
 };
