-        // hardware
-        addEntriesToGrid(m_hardwareEntries, {new CPUEntry, new MemoryEntry});
-        addEntriesToGrid(m_hardwareEntries, GPUEntryFactory::factorize());
+    void loadCpuAndMemory()
+    {
+        addEntries(m_hardwareEntries, {new CPUEntry, new MemoryEntry});
+        // GPU rows go right after these two, wherever they arrive
+        m_gpuRow = m_hardwareEntries->rowCount({});
+        m_gpuEntryIndex = m_entries.size();
+    }
+
+    void startGpuProbe()
+    {
+        m_gpuThread = QThread::create([this] {
+            // No OpenGL fallback here: a QOpenGLContext/QOffscreenSurface belongs on the GUI thread
+            m_gpuResult = GPUEntryFactory::factorize(GPUEntryFactory::Fallback::No);
+            for (Entry *entry : std::as_const(m_gpuResult)) {
+                entry->moveToThread(qApp->thread());
+            }
+        });
+        m_gpuThread->setParent(this);
+        connect(m_gpuThread, &QThread::finished, this, [this] {
+            std::vector<Entry *> entries = std::move(m_gpuResult);
+            m_gpuResult.clear();
+            m_gpuThread->deleteLater();
+            m_gpuThread = nullptr;
+            if (entries.empty()) {
+                // same last resort as before: the renderer of this process
+                entries = GPUEntryFactory::fallbackEntries();
+            }
+            addGpuEntries(entries);
+            setHardwareLoading(false);
+        });
+        m_gpuThread->start();
+    }
+
+    void addGpuEntries(const std::vector<Entry *> &entries)
+    {
+        int row = m_gpuRow < 0 ? m_hardwareEntries->rowCount({}) : m_gpuRow;
+        int index = m_gpuEntryIndex < 0 ? int(m_entries.size()) : m_gpuEntryIndex;
