+    void loadExtraSoftware()
+    {
+        // Check if distro want's us to show extra values (the scripts are run here, not in loadOSData())
+        KSharedConfig::Ptr config = KSharedConfig::openConfig(QStringLiteral("kcm-about-distrorc"), KConfig::NoGlobals);
+        KConfigGroup cg = KConfigGroup(config, "General");
+        const QStringList entries = cg.readXdgListEntry(QStringLiteral("ExtraSoftwareData"), QStringList());
+        std::vector<Entry *> extra;
+        for (const auto &script : entries) {
+            extra.push_back(new ThirdPartyEntry(script));
         }
