diff --git a/kcms/samba/ksambasharemodel.cpp b/kcms/samba/ksambasharemodel.cpp
index ab59483..4618d5e 100644
--- a/kcms/samba/ksambasharemodel.cpp
+++ b/kcms/samba/ksambasharemodel.cpp
@@ -17,8 +17,15 @@
 KSambaShareModel::KSambaShareModel(QObject *parent)
     : QAbstractListModel(parent)
 {
-    connect(KSambaShare::instance(), &KSambaShare::changed, this, &KSambaShareModel::reloadData);
-    metaObject()->invokeMethod(this, &KSambaShareModel::reloadData);
+    // From the event loop, after the page exists: KSambaShare::instance() reads the Samba configuration and the
+    // user-share list, and reloadData() asks Avahi over D-Bus. Neither belongs in the constructor (page creation).
+    metaObject()->invokeMethod(
+        this,
+        [this] {
+            connect(KSambaShare::instance(), &KSambaShare::changed, this, &KSambaShareModel::reloadData);
+            reloadData();
+        },
+        Qt::QueuedConnection);
 }
 
 KSambaShareModel::~KSambaShareModel() = default;
diff --git a/kcms/samba/smbmountmodel.cpp b/kcms/samba/smbmountmodel.cpp
index d368754..fc4e235 100644
--- a/kcms/samba/smbmountmodel.cpp
+++ b/kcms/samba/smbmountmodel.cpp
@@ -18,7 +18,8 @@ SmbMountModel::SmbMountModel(QObject *parent)
 {
     connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceAdded, this, &SmbMountModel::addDevice);
     connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceRemoved, this, &SmbMountModel::removeDevice);
-    metaObject()->invokeMethod(this, &SmbMountModel::reloadData);
+    // From the event loop: Solid::Device::listFromType() is not needed for the first frame
+    metaObject()->invokeMethod(this, &SmbMountModel::reloadData, Qt::QueuedConnection);
 }
 
 SmbMountModel::~SmbMountModel() = default;
