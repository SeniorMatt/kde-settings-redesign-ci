+
+void FirewallClient::detectBackend(const QStringList &backendList)
+{
+    dropBackend();
+    if (!m_detecting) {
+        m_detecting = true;
+        Q_EMIT detectingChanged();
+    }
+    m_detectFactories = loadFactories(backendList);
+    m_detectIndex = 0;
+    m_detectPass = 0;
+    probeNextBackend();
+}
+
+void FirewallClient::probeNextBackend()
+{
+    // Same order as setBackend(): first a backend whose service is loaded (systemctl status exits with 0),
+    // then the first one whose executable is installed. Only the systemctl calls are asynchronous.
+    while (true) {
+        if (m_detectIndex >= m_detectFactories.size()) {
+            if (m_detectPass == 0) {
+                m_detectPass = 1;
+                m_detectIndex = 0;
+                continue;
+            }
+            finishDetection(nullptr);
+            return;
+        }
+
+        KPluginFactory *factory = m_detectFactories.at(m_detectIndex++);
+        auto candidate = factory->create<IFirewallClientBackend>(this, QVariantList());
+        if (!candidate) {
+            continue;
+        }
+
+        if (m_detectPass == 1) {
+            if (candidate->hasExecutable()) {
+                finishDetection(candidate);
+                return;
+            }
+            candidate->deleteLater();
+            continue;
+        }
+
+        auto process = new QProcess(this);
+        connect(process, &QProcess::finished, this, [this, process, candidate](int exitCode, QProcess::ExitStatus status) {
+            process->deleteLater();
+            if (status == QProcess::NormalExit && exitCode == EXIT_SUCCESS) {
+                finishDetection(candidate);
+            } else {
+                candidate->deleteLater();
+                probeNextBackend();
+            }
+        });
+        connect(process, &QProcess::errorOccurred, this, [this, process, candidate](QProcess::ProcessError error) {
+            if (error == QProcess::FailedToStart) {
+                process->deleteLater();
+                candidate->deleteLater();
+                probeNextBackend();
+            }
+        });
+        process->start(QStringLiteral("systemctl"), {QStringLiteral("status"), candidate->name()});
+        return;
+    }
+}
+
+void FirewallClient::finishDetection(IFirewallClientBackend *backend)
+{
+    m_detectFactories.clear();
+    if (backend) {
+        adoptBackend(backend);
+    } else {
+        qCDebug(FirewallClientDebug) << "Could not find any of the specified backends";
+    }
+    m_detecting = false;
+    Q_EMIT detectingChanged();
+    Q_EMIT backendChanged(this->backend());
+    Q_EMIT capabilitiesChanged(capabilities());
+}
+
+bool FirewallClient::detecting() const
+{
+    return m_detecting;
+}
+
+QString FirewallClient::versionText() const
+{
+    return m_versionText;
+}
+
+void FirewallClient::requestVersion()
+{
+    if (m_versionRequested || !m_currentBackend) {
+        return;
+    }
+    m_versionRequested = true;
+
+    // version() starts "ufw --version" / "firewall-cmd --version" and waits for it: do that off the GUI thread.
+    IFirewallClientBackend *backend = m_currentBackend;
+    QPointer<FirewallClient> self(this);
+    m_versionThread = QThread::create([backend, self] {
+        const QString version = backend->version().trimmed();
+        if (self) {
+            QMetaObject::invokeMethod(
+                self.data(),
+                [self, version] {
+                    if (self) {
+                        self->m_versionText = version;
+                        Q_EMIT self->versionTextChanged();
+                    }
+                },
+                Qt::QueuedConnection);
+        }
+    });
+    m_versionThread->setParent(this);
+    m_versionThread->start();
 }
 
