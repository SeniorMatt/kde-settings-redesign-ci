 {
@@ -52,25 +55,73 @@ AppPermissionsKCM::AppPermissionsKCM(QObject *parent, const KPluginMetaData &dat
     m_permissionStore->loadTable("wallpaper"_L1);
     m_permissionStore->loadTable("input-capture"_L1);
 
-    auto reference = indexFromArgs(args);
-    if (reference) {
-        connect(
-            this,
-            &KQuickConfigModule::mainUiReady,
-            this,
-            [this, reference] {
-                const auto iconName = QVariant::fromValue(appsModel()->findIconNameById(reference->flatpakName()));
-                push("FlatpakPermissions.qml"_L1, {{u"ref"_s, QVariant::fromValue(reference)}, {u"decoration"_s, iconName}});
-            },
-            Qt::SingleShotConnection);
-    }
-    connect(this, &KQuickConfigModule::activationRequested, this, [this](const QVariantList &args) {
-        auto reference = indexFromArgs(args);
-        if (reference) {
-            const auto iconName = QVariant::fromValue(appsModel()->findIconNameById(reference->flatpakName()));
-            push("FlatpakPermissions.qml"_L1, {{u"ref"_s, QVariant::fromValue(reference)}, {u"decoration"_s, iconName}});
+    // Before: the constructor read every installed Flatpak ref of the system and user installations through libflatpak
+    // (flatpak_installation_list_installed_refs_by_kind, reading appdata of each app) before the page could appear.
+    // Now a thread does it; the references (and the app a caller asked for in args) show up when it finishes.
+    m_pendingArgs = args;
+    m_referencesThread = QThread::create([this] {
+        m_loadedReferences = FlatpakReference::allFlatpakReferences();
+        for (const auto &reference : m_loadedReferences) {
+            reference->moveToThread(qApp->thread());
+        }
+    });
+    m_referencesThread->setParent(this);
+    connect(m_referencesThread, &QThread::finished, this, [this] {
+        m_references = std::move(m_loadedReferences);
+        m_loadedReferences.clear();
+        m_referencesThread->deleteLater();
+        m_referencesThread = nullptr;
+        m_referencesLoaded = true;
+        Q_EMIT referencesLoadedChanged();
+        openPendingReference();
+    });
+    m_referencesThread->start();
+
+    // Before: gamemodeAvailable() asked the session bus (blocking) when the first app page was opened.
+    auto *gamemodeCall = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().interface()->asyncCall(u"ListActivatableNames"_s), this);
+    connect(gamemodeCall, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusPendingReply<QStringList> reply = *watcher;
+        if (reply.isValid() && reply.value().contains(u"com.feralinteractive.GameMode"_s)) {
+            m_gamemodeAvailable = true;
+            Q_EMIT gamemodeAvailableChanged();
         }
     });
+
+    connect(this, &KQuickConfigModule::mainUiReady, this, [this] {
+        m_mainUiReady = true;
+        openPendingReference();
+    });
+    connect(this, &KQuickConfigModule::activationRequested, this, [this](const QVariantList &args) {
+        m_pendingArgs = args;
+        openPendingReference();
+    });
+}
+
+AppPermissionsKCM::~AppPermissionsKCM()
+{
+    if (m_referencesThread) {
+        m_referencesThread->wait();
+    }
+}
+
+void AppPermissionsKCM::openPendingReference()
+{
+    if (!m_mainUiReady || !m_referencesLoaded || m_pendingArgs.isEmpty()) {
+        return;
+    }
+    const auto reference = indexFromArgs(m_pendingArgs);
+    m_pendingArgs.clear();
+    if (reference) {
+        m_appsModel.ensureLoaded();
+        const auto iconName = QVariant::fromValue(appsModel()->findIconNameById(reference->flatpakName()));
+        push("FlatpakPermissions.qml"_L1, {{u"ref"_s, QVariant::fromValue(reference)}, {u"decoration"_s, iconName}});
+    }
+}
+
+bool AppPermissionsKCM::referencesLoaded() const
+{
+    return m_referencesLoaded;
 }
 
 FlatpakReference *AppPermissionsKCM::indexFromArgs(const QVariantList &args) const
@@ -129,8 +180,7 @@ FlatpakReference *AppPermissionsKCM::flatpakRefForApp(const QString &appId)
 
 bool AppPermissionsKCM::gamemodeAvailable() const
 {
-    static bool available = QDBusConnection::sessionBus().interface()->activatableServiceNames().value().contains(u"com.feralinteractive.GameMode"_s);
-    return available;
+    return m_gamemodeAvailable;
 }
 
