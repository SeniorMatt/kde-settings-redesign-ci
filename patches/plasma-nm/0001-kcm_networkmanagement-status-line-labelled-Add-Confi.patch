+    // Everything below asks NetworkManager over D-Bus (blocking calls) and builds the connection editor for the first
+    // selection. It runs once the list has been drawn, not before the first frame.
+    auto startOnce = [this, args] {
+        if (m_deferredStarted) {
+            return;
+        }
+        m_deferredStarted = true;
+        QTimer::singleShot(0, this, [this, args] {
+            startDeferredWork(args);
+        });
+    };
+    if (auto quickWindow = m_ui->connectionView->quickWindow()) {
+        connect(quickWindow, &QQuickWindow::afterRendering, this, startOnce, Qt::SingleShotConnection);
+    }
+    // In case no frame is ever drawn (the page is created hidden)
+    QTimer::singleShot(2000, this, startOnce);
+}
+
+void KCMNetworkmanagement::startDeferredWork(const QVariantList &args)
+{
+    updateApMode();
+
     // Select the connection from the arguments, falling back to a default one
     NetworkManager::Connection::Ptr selectedConnection = connectionFromArgs(args);
     if (!isSelectable(selectedConnection)) {
@@ -226,6 +226,42 @@ KCMNetworkmanagement::KCMNetworkmanagement(QObject *parent, const KPluginMetaDat
     m_timer->start();
 }
 
+void KCMNetworkmanagement::updateApMode()
+{
+    // Check if we can use AP mode to identify security type
+    bool useApMode = false;
+    bool foundInactive = false;
+
+    NetworkManager::WirelessDevice::Ptr wifiDev;
+
+    for (const NetworkManager::Device::Ptr &device : NetworkManager::networkInterfaces()) {
+        if (device->type() == NetworkManager::Device::Wifi) {
+            wifiDev = device.objectCast<NetworkManager::WirelessDevice>();
+            if (wifiDev) {
+                if (!wifiDev->isActive()) {
+                    foundInactive = true;
+                } else {
+                    // Prefer previous device if it was inactive
+                    if (foundInactive) {
+                        break;
+                    }
+                }
+
+                if (wifiDev->wirelessCapabilities().testFlag(NetworkManager::WirelessDevice::ApCap)) {
+                    useApMode = true;
+                }
+
+                // We prefer inactive wireless card with AP capabilities
+                if (foundInactive && useApMode) {
+                    break;
+                }
+            }
+        }
+    }
+
+    m_ui->connectionView->rootContext()->setContextProperty("useApMode", useApMode);
+}
